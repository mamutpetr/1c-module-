// ============================================================================
// ФОРТУНА 4.2. РОЗШИРЕННЯ — усі функції тільки читання.
// Ніякої зміни записів Спецификации, продажних/закупівельних документів.
// Дані беруться з того самого складу і цін, що й v4.1.1.
// ВАЖЛИВО: 1000 кг на рецептуру; ціни з останньої закупівлі, НЕ з регістру
// фактичної собівартості. Без повної ціни не показуємо достовірних висновків.
// ============================================================================
#Область UX42_Аналитика

&НаСервере
Процедура UX42_СоздатьРеквизиты()
    Атрибуты = Новый Массив;
    ТипТекст = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000));
    ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 4));
    ТипЦелое = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0));
    ТипМатериал = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
    ТипСпец = Новый ОписаниеТипов("СправочникСсылка.Спецификации");
    ТипХарактер = Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры");
    ТипДата = Новый ОписаниеТипов("Дата");

    Для Каждого Имя Из СтрРазделить("UX42_Кэш,UX42_Влияние,UX42_СравнениеТаб,UX42_КачествоТаб,UX42_РекомендацииТаб", ",") Цикл
        Атрибуты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("ТаблицаЗначений")));
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("UX42_СводВлияния,UX42_СводСравнения,UX42_СводКачества,UX42_СводСоветов", ",") Цикл
        Атрибуты.Добавить(Новый РеквизитФормы(Имя, ТипТекст));
    КонецЦикла;
    Атрибуты.Добавить(Новый РеквизитФормы("UX42_Материал", ТипМатериал));
    Атрибуты.Добавить(Новый РеквизитФормы("UX42_РецептА", ТипСпец));
    Атрибуты.Добавить(Новый РеквизитФормы("UX42_РецептБ", ТипСпец));
    Атрибуты.Добавить(Новый РеквизитФормы("UX42_Процент", ТипЧисло));
    Атрибуты.Добавить(Новый РеквизитФормы("UX42_ДнейАктуальности", ТипЦелое));
    ИзменитьРеквизиты(Атрибуты);

    Кол = Новый Массив;
    UX42_Кол(Кол, "UX42_Кэш", "Спецификация", ТипСпец);
    UX42_Кол(Кол, "UX42_Кэш", "Материал", ТипМатериал);
    UX42_Кол(Кол, "UX42_Кэш", "Характеристика", ТипХарактер);
    UX42_Кол(Кол, "UX42_Кэш", "Количество", ТипЧисло);
    UX42_Кол(Кол, "UX42_Кэш", "Цена", ТипЧисло);
    UX42_Кол(Кол, "UX42_Кэш", "ДатаЦены", ТипДата);
    UX42_Кол(Кол, "UX42_Кэш", "ЦенаДоступна", Новый ОписаниеТипов("Булево"));
    Для Каждого ИмяТаблицы Из СтрРазделить("UX42_Влияние", ",") Цикл
        UX42_Кол(Кол, ИмяТаблицы, "Продукция", ТипТекст);
        UX42_Кол(Кол, ИмяТаблицы, "Спецификация", ТипСпец);
        UX42_Кол(Кол, ИмяТаблицы, "Количество", ТипЧисло);
        UX42_Кол(Кол, ИмяТаблицы, "Цена", ТипЧисло);
        UX42_Кол(Кол, ИмяТаблицы, "ДельтаКг", ТипЧисло);
        UX42_Кол(Кол, ИмяТаблицы, "Статус", ТипТекст);
    КонецЦикла;
    UX42_Кол(Кол, "UX42_СравнениеТаб", "Материал", ТипМатериал);
    UX42_Кол(Кол, "UX42_СравнениеТаб", "Характеристика", ТипХарактер);
    UX42_Кол(Кол, "UX42_СравнениеТаб", "КоличествоА", ТипЧисло);
    UX42_Кол(Кол, "UX42_СравнениеТаб", "КоличествоБ", ТипЧисло);
    UX42_Кол(Кол, "UX42_СравнениеТаб", "Цена", ТипЧисло);
    UX42_Кол(Кол, "UX42_СравнениеТаб", "РазницаНаКг", ТипЧисло);
    UX42_Кол(Кол, "UX42_СравнениеТаб", "Статус", ТипТекст);
    UX42_Кол(Кол, "UX42_КачествоТаб", "Продукция", ТипТекст);
    UX42_Кол(Кол, "UX42_КачествоТаб", "Спецификация", ТипСпец);
    UX42_Кол(Кол, "UX42_КачествоТаб", "ЦенНет", ТипЦелое);
    UX42_Кол(Кол, "UX42_КачествоТаб", "ЦенСтарых", ТипЦелое);
    UX42_Кол(Кол, "UX42_КачествоТаб", "Статус", ТипТекст);
    UX42_Кол(Кол, "UX42_КачествоТаб", "Рекомендация", ТипТекст);
    UX42_Кол(Кол, "UX42_РекомендацииТаб", "Приоритет", ТипЦелое);
    UX42_Кол(Кол, "UX42_РекомендацииТаб", "Продукция", ТипТекст);
    UX42_Кол(Кол, "UX42_РекомендацииТаб", "Спецификация", ТипСпец);
    UX42_Кол(Кол, "UX42_РекомендацииТаб", "Сигнал", ТипТекст);
    UX42_Кол(Кол, "UX42_РекомендацииТаб", "Действие", ТипТекст);
    ИзменитьРеквизиты(Кол);

    ЗначениеВРеквизитФормы(UX42_НоваяТаблица("Кэш"), "UX42_Кэш");
    ЗначениеВРеквизитФормы(UX42_НоваяТаблица("Влияние"), "UX42_Влияние");
    ЗначениеВРеквизитФормы(UX42_НоваяТаблица("Сравнение"), "UX42_СравнениеТаб");
    ЗначениеВРеквизитФормы(UX42_НоваяТаблица("Качество"), "UX42_КачествоТаб");
    ЗначениеВРеквизитФормы(UX42_НоваяТаблица("Советы"), "UX42_РекомендацииТаб");
    ЭтаФорма["UX42_Процент"] = 10;
    ЭтаФорма["UX42_ДнейАктуальности"] = 90;
    ЭтаФорма["UX42_СводВлияния"] = "Після оновлення даних виберіть матеріал і натисніть «Розрахувати».";
    ЭтаФорма["UX42_СводСравнения"] = "Виберіть дві специфікації та натисніть «Порівняти».";
    ЭтаФорма["UX42_СводКачества"] = "Натисніть «Оновити дані».";
    ЭтаФорма["UX42_СводСоветов"] = "Рекомендації формуються після завантаження калькуляцій.";
КонецПроцедуры

&НаСервере
Процедура UX42_Кол(Кол, ИмяТаблицы, ИмяКолонки, ТипКолонки)
    UX35_ДобавитьКолонку(Кол, ИмяТаблицы, ИмяКолонки, ТипКолонки);
КонецПроцедуры

&НаСервере
Функция UX42_НоваяТаблица(Вид)
    Таб = Новый ТаблицаЗначений;
    Т = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000));
    Ч = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 4));
    Ц = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0));
    С = Новый ОписаниеТипов("СправочникСсылка.Спецификации");
    М = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
    Х = Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры");
    Если Вид = "Кэш" Тогда
        Таб.Колонки.Добавить("Спецификация", С);
        Таб.Колонки.Добавить("Материал", М);
        Таб.Колонки.Добавить("Характеристика", Х);
        Таб.Колонки.Добавить("Количество", Ч);
        Таб.Колонки.Добавить("Цена", Ч);
        Таб.Колонки.Добавить("ДатаЦены", Новый ОписаниеТипов("Дата"));
        Таб.Колонки.Добавить("ЦенаДоступна", Новый ОписаниеТипов("Булево"));
    ИначеЕсли Вид = "Влияние" Тогда
        Таб.Колонки.Добавить("Продукция", Т);
        Таб.Колонки.Добавить("Спецификация", С);
        Таб.Колонки.Добавить("Количество", Ч);
        Таб.Колонки.Добавить("Цена", Ч);
        Таб.Колонки.Добавить("ДельтаКг", Ч);
        Таб.Колонки.Добавить("Статус", Т);
    ИначеЕсли Вид = "Сравнение" Тогда
        Таб.Колонки.Добавить("Материал", М);
        Таб.Колонки.Добавить("Характеристика", Х);
        Таб.Колонки.Добавить("КоличествоА", Ч);
        Таб.Колонки.Добавить("КоличествоБ", Ч);
        Таб.Колонки.Добавить("Цена", Ч);
        Таб.Колонки.Добавить("РазницаНаКг", Ч);
        Таб.Колонки.Добавить("Статус", Т);
    ИначеЕсли Вид = "Качество" Тогда
        Таб.Колонки.Добавить("Продукция", Т);
        Таб.Колонки.Добавить("Спецификация", С);
        Таб.Колонки.Добавить("ЦенНет", Ц);
        Таб.Колонки.Добавить("ЦенСтарых", Ц);
        Таб.Колонки.Добавить("Статус", Т);
        Таб.Колонки.Добавить("Рекомендация", Т);
    ИначеЕсли Вид = "Советы" Тогда
        Таб.Колонки.Добавить("Приоритет", Ц);
        Таб.Колонки.Добавить("Продукция", Т);
        Таб.Колонки.Добавить("Спецификация", С);
        Таб.Колонки.Добавить("Сигнал", Т);
        Таб.Колонки.Добавить("Действие", Т);
    КонецЕсли;
    Возврат Таб;
КонецФункции

