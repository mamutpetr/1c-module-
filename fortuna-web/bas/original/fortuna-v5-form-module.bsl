// ============================================================================
// ДОВІДНИК КАЛЬКУЛЯЦІЙ — BAF / 1С 8.3
// ВЕРСІЯ 4.2.1: UI THEME — охайне оформлення, KPI, кольорові статуси та навігація; поверх v4.2.
// Усі прямі звернення до них виконуються через ЭтаФорма["Имя"].
// БІЗНЕС-ЛОГІКА калькуляцій та дані не змінювалися.
// Для переробки використовується вже існуюча колонка Статус;
// нових колонок у ТаблицаКалькуляции створювати НЕ потрібно.
// Собівартість у верхній таблиці вже враховує 50 000 грн/т.
// Рядок переробки у нижній таблиці НЕ додає їх повторно до підсумку.
//
// Всі 4 реквізити форми, колонки, таблиці і кнопки створюються кодом.
// Конфігураційні регістри історії та форма ФормаИстории НЕ створюються.
//
// ГОЛОВНА ЗМІНА v2.1:
// НЕ хардкодимо Справочник.Спецификации.Состав.Материал.
// Обробка сама:
//   1) знаходить довідник Спецификации;
//   2) перебирає його табличні частини;
//   3) знаходить поле матеріалу;
//   4) знаходить поле кількості;
//   5) за можливості знаходить характеристику та одиницю.
//
// ПРИ ВІДКРИТТІ програмно створюються:
//   ТаблицаРецептур       (ДеревоЗначений)
//     колонки: Название, Товар, Спецификация, Материалов,
//              ЦенНайдено, Себестоимость, ЦенаПродажи,
//              Рентабельность, Статус
//     Автоматично додаються числові колонки:
//       ЦенаПродажиБыло, ИзменениеЦены, СебестоимостьБыло,
//       ИзменениеСебестоимости, РентабельностьБыло,
//       ИзменениеРентабельности
//   Повторний ручний "Загрузить" створює запис ТІЛЬКИ за реальних змін
//   у спільному РегистрСведений.ИсторияКалькуляций.
//   Зміна Використовуються/Не використовуються не пише знімок.
//   Перший "Загрузить" створює початкову базу порівняння.
//   ДЕТАЛЬНІ ЦІНИ МАТЕРІАЛІВ: попередня версія зберігання поки локальна;
//   для загальної історії кожного матеріалу потрібен окремий регістр.
//   Рентабельність змінюється в процентних пунктах (в.п.), не у %.
//   ТаблицаКалькуляции
//     Автоматично додаються числові колонки: ЦенаБезНДСБыло, ИзменениеЦеныМатериала
//   ТекущаяСпецификация
//   Итоги
//
// ВЕРСІЯ 3.3: Собівартість та ЦінаПродажи у ВЕРХНІЙ ТАБЛИЦІ — грн/кг БЕЗ ПДВ.
// Сировина/тара/упаковка з рецепта на 1000 кг + 50 000 грн/т переробки.
// Суму ділимо на 1000 кг. Продаж ящика ділимо на вагу нетто ящика.
// Нижня таблиця матеріалів як і раніше показує матеріали на 1000 кг.
// Якщо немає ваги коробки, не показуємо недостовірні %.
// Рентабельность = (Продаж_грн_кг - Собівартість_грн_кг)
//                 / Собівартість_грн_кг * 100.
// Якщо немає цін матеріалів або продажу, % не розраховується.
//
// ДОДАТКОВІ КОМАНДИ ФОРМИ:
//   ПереместитьВНовые  -> ПереместитьВНовыеКоманда
//      НОВИЙ ЗАГОЛОВОК КНОПКИ: "Не використовуються" (перевести в неактивні)
//   ПереместитьВСтарые -> ПереместитьВСтарыеКоманда
//      НОВИЙ ЗАГОЛОВОК КНОПКИ: "Використовуються" (повернути в активні)
//   Команди у формі НЕ перейменовувати, змінити лише ЗАГОЛОВКИ.
//   v3.0 потребує ОДИН новий реквізит ДОВІДНИКА Спецификации:
//      КатегорияКалькуляции — Строка(50).
//   НЕ додавати його в реквізити зовнішньої обробки/форми.
//   ЗАПИС СПІЛЬНИЙ: бухгалтер вибирає рецепт та натискає кнопку категорії.
//   Одна специфікація має одну категорію. Статус НОВА / СТАРА
//   лишається окремим і керує активністю рецепта.
//   При переміщенні в конкретну категорію рецепт також активується,
//   а при переміщенні в неактивні його категорія НЕ стирається.
// ============================================================================


// ============================================================================
// ФОРТУНА 4.1 — ПОРОЖНЯ ЗОВНІШНЯ ОБРОБКА З ОДНІЄЮ КЕРОВАНОЮ ФОРМОЮ.
// FIX: локальна змінна ГруппаПараметровПоиска замість системної властивості Параметры.
// ПриСозданииНаСервере: 4 реквізити, всі колонки, таблиці, вкладки і команди.
// НЕ створює довідники/регістри конфігурації та не змінює структуру бази.
// ============================================================================

#Область UX35_ПолнаяФорма

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Попытка
        UX35_СоздатьРеквизиты();
        UX40_СоздатьРеквизиты();
        UX42_СоздатьРеквизиты();
        NX50_СоздатьРеквизиты();
        UX40_СоздатьИнтерфейс();
    Исключение
        // Не приховуємо помилку: порожня форма без таблиць непридатна.
        Сообщить("ФОРТУНА 5.0: ПОМИЛКА СТВОРЕННЯ ФОРМИ: " + ОписаниеОшибки());
        Отказ = Истина;
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура UX35_СоздатьРеквизиты()
    // Спершу додаємо реквізити-контейнери, лише потім їх колонки.
    Добавляемые = Новый Массив;
    Добавляемые.Добавить(Новый РеквизитФормы(
        "ТаблицаРецептур", Новый ОписаниеТипов("ДеревоЗначений")));
    Добавляемые.Добавить(Новый РеквизитФормы(
        "ТаблицаКалькуляции", Новый ОписаниеТипов("ТаблицаЗначений")));
    Добавляемые.Добавить(Новый РеквизитФормы(
        "ТекущаяСпецификация", Новый ОписаниеТипов("СправочникСсылка.Спецификации")));
    Добавляемые.Добавить(Новый РеквизитФормы(
        "Итоги", Новый ОписаниеТипов("Строка")));
    ИзменитьРеквизиты(Добавляемые);

    // ТИПИ КОЛОНОК ПОВИННІ ЗБІГАТИСЯ З РЕАЛЬНИМИ ДАНИМИ.
    Строка500 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500));
    Строка255 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255));
    Строка80 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(80));
    ЧислоЦены = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 4));
    ЧислоПроцента = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
    ЧислоСчетчик = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0));
    ТипТовар = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
    ТипСпецификация = Новый ОписаниеТипов("СправочникСсылка.Спецификации");
    ТипХарактеристика = Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры");
    ТипДата = Новый ОписаниеТипов("Дата");

    Колонки = Новый Массив;
    // Дерево продукції.
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "Название", Строка500);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "Товар", ТипТовар);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "Спецификация", ТипСпецификация);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "Материалов", ЧислоСчетчик);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "ЦенНайдено", ЧислоСчетчик);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "Себестоимость", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "ЦенаПродажи", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "Рентабельность", ЧислоПроцента);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "Статус", Строка255);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "ЦенаПродажиБыло", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "ИзменениеЦены", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "СебестоимостьБыло", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "ИзменениеСебестоимости", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "РентабельностьБыло", ЧислоПроцента);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаРецептур", "ИзменениеРентабельности", ЧислоПроцента);

    // Нижня таблиця матеріалів.
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "Материал", ТипТовар);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "Характеристика", ТипХарактеристика);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "Единица", Строка80);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "Количество", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "ЦенаСПДВ", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "ЦенаБезНДС", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "ЦенаБезНДСБыло", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "ИзменениеЦеныМатериала", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "Сумма", ЧислоЦены);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "ДатаЦены", ТипДата);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "Документ", Строка255);
    UX35_ДобавитьКолонку(Колонки, "ТаблицаКалькуляции", "Статус", Строка255);
    ИзменитьРеквизиты(Колонки);

    // Явно ініціалізуємо дані форми. Назви та типи колонок аналогічні.
    ДеревоОбъект = Новый ДеревоЗначений;
    ДеревоОбъект.Колонки.Добавить("Название", Строка500);
    ДеревоОбъект.Колонки.Добавить("Товар", ТипТовар);
    ДеревоОбъект.Колонки.Добавить("Спецификация", ТипСпецификация);
    ДеревоОбъект.Колонки.Добавить("Материалов", ЧислоСчетчик);
    ДеревоОбъект.Колонки.Добавить("ЦенНайдено", ЧислоСчетчик);
    ДеревоОбъект.Колонки.Добавить("Себестоимость", ЧислоЦены);
    ДеревоОбъект.Колонки.Добавить("ЦенаПродажи", ЧислоЦены);
    ДеревоОбъект.Колонки.Добавить("Рентабельность", ЧислоПроцента);
    ДеревоОбъект.Колонки.Добавить("Статус", Строка255);
    ДеревоОбъект.Колонки.Добавить("ЦенаПродажиБыло", ЧислоЦены);
    ДеревоОбъект.Колонки.Добавить("ИзменениеЦены", ЧислоЦены);
    ДеревоОбъект.Колонки.Добавить("СебестоимостьБыло", ЧислоЦены);
    ДеревоОбъект.Колонки.Добавить("ИзменениеСебестоимости", ЧислоЦены);
    ДеревоОбъект.Колонки.Добавить("РентабельностьБыло", ЧислоПроцента);
    ДеревоОбъект.Колонки.Добавить("ИзменениеРентабельности", ЧислоПроцента);
    ЗначениеВРеквизитФормы(ДеревоОбъект, "ТаблицаРецептур");

    ТаблицаОбъект = Новый ТаблицаЗначений;
    ТаблицаОбъект.Колонки.Добавить("Материал", ТипТовар);
    ТаблицаОбъект.Колонки.Добавить("Характеристика", ТипХарактеристика);
    ТаблицаОбъект.Колонки.Добавить("Единица", Строка80);
    ТаблицаОбъект.Колонки.Добавить("Количество", ЧислоЦены);
    ТаблицаОбъект.Колонки.Добавить("ЦенаСПДВ", ЧислоЦены);
    ТаблицаОбъект.Колонки.Добавить("ЦенаБезНДС", ЧислоЦены);
    ТаблицаОбъект.Колонки.Добавить("ЦенаБезНДСБыло", ЧислоЦены);
    ТаблицаОбъект.Колонки.Добавить("ИзменениеЦеныМатериала", ЧислоЦены);
    ТаблицаОбъект.Колонки.Добавить("Сумма", ЧислоЦены);
    ТаблицаОбъект.Колонки.Добавить("ДатаЦены", ТипДата);
    ТаблицаОбъект.Колонки.Добавить("Документ", Строка255);
    ТаблицаОбъект.Колонки.Добавить("Статус", Строка255);
    ЗначениеВРеквизитФормы(ТаблицаОбъект, "ТаблицаКалькуляции");

    ЭтаФорма["Итоги"] = "Оберіть рецептуру у верхній таблиці.";
КонецПроцедуры

&НаСервере
Процедура UX35_ДобавитьКолонку(МассивРеквизитов, Родитель, Имя, ТипКолонки)
    МассивРеквизитов.Добавить(
        Новый РеквизитФормы(Имя, ТипКолонки, Родитель, Имя));
КонецПроцедуры

&НаСервере
Функция UX35_Группа(Имя, Родитель, Горизонтальная = Ложь, Заголовок = "")
    Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
    Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    Группа.Группировка = ?(Горизонтальная,
        ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно,
        ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
    Группа.ОтображатьЗаголовок = НЕ ПустаяСтрока(Заголовок);
    Если НЕ ПустаяСтрока(Заголовок) Тогда
        Группа.Заголовок = Заголовок;
    КонецЕсли;
    Возврат Группа;
КонецФункции

// ===== v4.0: БАЗОВИЙ МАКЕТ ВСЬОГО РОБОЧОГО МІСЦЯ =====
&НаСервере
Процедура UX40_СоздатьИнтерфейс()
    // FORTUNA 4.1. Вся навігація та компонування на стандартній керованій формі.
    // ЖОДНИХ HTML, зовнішніх компонентів, нового типу форми або макетів.
    Попытка
        ЭтаФорма.Заголовок = "ФОРТУНА | Управління собівартістю та прибутковістю";
    Исключение
        UX41_ПропускОформления = ОписаниеОшибки();
    КонецПопытки;

    Корень = UX35_Группа("UX41_Корень", ЭтаФорма, Истина);
    // КРИТИЧНЕ: не допускаємо перенесення основної зони ПІД меню.
    // Саме ГоризонтальнаяЕслиВозможно давала порожню смугу справа зверху.
    UX411_ФиксированныйРяд(Корень);
    UX41_СтильГруппы(Корень, "Фон");

    // БІЧНА НАВІГАЦІЯ (реальні команди, не декоративні кнопки).
    Меню = UX35_Группа("UX41_Меню", Корень);
    UX41_СтильГруппы(Меню, "Меню");
    UX41_ШиринаГруппы(Меню, 23);
    UX41_Надпись(Меню, "UX41_Бренд", "◆  ФОРТУНА", "Бренд");
    UX41_Надпись(Меню, "UX41_Подбренд", "COST & PROFIT  ·  CONTROL CENTER", "МенюПодпись");
    UX35_Кнопка(Меню, "UX41_Домой", "⌂ Головна", "UX41_ГлавнаяКоманда");
    UX35_Кнопка(Меню, "UX41_Рецептуры", "▤ Рецептури", "UX41_ДеревоКоманда");
    UX35_Кнопка(Меню, "UX41_Себестоимость", "≡ Собівартість", "UX41_СебестоимостьКоманда");
    UX35_Кнопка(Меню, "UX41_Рентабельность", "▥ Аналітика", "UX41_АналитикаКоманда");
    UX35_Кнопка(Меню, "UX41_Цены", "◈ Ціни", "UX41_ЦеныКоманда");
    UX35_Кнопка(Меню, "UX41_Контроль", "! Контроль", "UX41_КонтрольКоманда");
    UX35_Кнопка(Меню, "UX41_Поиск", "⌕ Пошук", "UX41_ПоискКоманда");
    UX35_Кнопка(Меню, "UX41_Категории", "▸ Категорії", "UX41_КатегорииКоманда");
    UX35_Кнопка(Меню, "UX41_История", "◷ Історія", "UX41_ИсторияКоманда");
    UX35_Кнопка(Меню, "UX42_Сырье", "◈ Вплив сировини", "UX42_МатериалыКоманда");
    UX35_Кнопка(Меню, "UX42_Сравнение", "⇄ Порівняння", "UX42_СравнениеКоманда");
    UX35_Кнопка(Меню, "UX42_Качество", "✓ Якість даних", "UX42_КачествоКоманда");
