&НаСервере
Процедура NX50_ВидКолонка(Таблица, Путь, Имя, Заголовок, Ширина, Редактируемая)
    UX35_ПолеКолонки(Таблица, Путь, Имя, Заголовок, Истина);
    UX411_ШиринаКолонки(Путь, Имя, Ширина);
    Если Редактируемая Тогда
        // Базова UX40_Таблица робить таблицю read-only; для сценаріїв знімаємо блокування.
        Таблица.ТолькоПросмотр = Ложь;
        Элемент = Элементы.Найти("UX35_" + Путь + "_" + Имя);
        Если Элемент <> Неопределено Тогда
            Элемент.ТолькоПросмотр = Ложь;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура NX50_ЦветоваяИндикация()
    Красный = Новый Цвет(174, 43, 56);
    МягкийКрасный = Новый Цвет(255, 237, 239);
    Зеленый = Новый Цвет(12, 121, 89);
    МягкийЗеленый = Новый Цвет(230, 249, 239);
    UX421_Правило("NX50_Потребность", "Дефицит", ВидСравненияКомпоновкиДанных.Больше, 0,
        "Дефицит", Красный, МягкийКрасный);
    UX421_Правило("NX50_Прайс", "Разница", ВидСравненияКомпоновкиДанных.Больше, 0,
        "Разница", Красный, МягкийКрасный);
    UX421_Правило("NX50_Прайс", "Разница", ВидСравненияКомпоновкиДанных.Меньше, 0,
        "Разница", Зеленый, МягкийЗеленый);
КонецПроцедуры

&НаСервере
Процедура NX50_ПослеЗагрузки()
    // Завантаження з BAS вже виконане v4.2. Перераховуємо сценарії, якщо вони є.
    Если РеквизитФормыВЗначение("NX50_План").Количество() > 0 Тогда
        NX50_ПересчитатьПланНаСервере();
    КонецЕсли;
    Если ЗначениеЗаполнено(ЭтаФорма["NX50_СпецификацияКонструктора"])
        И РеквизитФормыВЗначение("NX50_Конструктор").Количество() > 0 Тогда
        // Ціни в конструкторі перераховуються тільки за прямою командою.
        ЭтаФорма["NX50_ИтогРецепта"] = "Ціни BAS оновлені; натисніть «Перерахувати» для актуалізації сценарію.";
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция NX50_НайтиСтроку(Таб, Материал, Характеристика)
    Отбор = Новый Структура("Материал,Характеристика", Материал, Характеристика);
    Совпадения = Таб.НайтиСтроки(Отбор);
    Если Совпадения.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Совпадения[0];
КонецФункции

&НаСервере
Функция NX50_ПолучитьЦенуИзКеша(Материал, Характеристика, Кеш)
    Для Каждого Стр Из Кеш Цикл
        Если Стр.Материал = Материал И Стр.Характеристика = Характеристика
            И Стр.ЦенаДоступна И Стр.Цена > 0 Тогда
            Возврат Стр.Цена;
        КонецЕсли;
    КонецЦикла;
    Возврат 0;
КонецФункции

&НаСервере
Процедура NX50_ДобавитьВПланНаСервере()
    Спецификация = ЭтаФорма["NX50_СпецификацияПлана"];
    Кг = ЭтаФорма["NX50_КгПлана"];
    Если НЕ ЗначениеЗаполнено(Спецификация) ИЛИ Кг <= 0 Тогда
        Сообщить("Виберіть специфікацію та вкажіть партію понад 0 кг.");
        Возврат;
    КонецЕсли;
    Кеш = РеквизитФормыВЗначение("UX42_Кэш");
    Если Кеш.Найти(Спецификация,"Спецификация") = Неопределено Тогда
        Сообщить("Немає складу обраної специфікації у завантажених даних. Натисніть «Оновити».");
        Возврат;
    КонецЕсли;
    План = РеквизитФормыВЗначение("NX50_План");
    Новая = План.Добавить();
    Новая.Спецификация = Спецификация;
    Новая.Кг = Кг;
    ЗначениеВРеквизитФормы(План,"NX50_План");
    NX50_ПересчитатьПланНаСервере();
КонецПроцедуры

&НаСервере
Процедура NX50_ПересчитатьПланНаСервере()
    План = РеквизитФормыВЗначение("NX50_План");
    Кеш = РеквизитФормыВЗначение("UX42_Кэш");
    Склад = РеквизитФормыВЗначение("NX50_Склад");
    Потребность = NX50_НоваяТаблица("NX50_Потребность");
    ОбщийВес = 0;
    ВсегоСтрок = 0;
    Неизвестных = 0;
    Для Каждого СтрокаПлана Из План Цикл
        Если СтрокаПлана.Кг <= 0 ИЛИ НЕ ЗначениеЗаполнено(СтрокаПлана.Спецификация) Тогда
            Продолжить;
        КонецЕсли;
        ОбщийВес = ОбщийВес + СтрокаПлана.Кг;
        Для Каждого Стр Из Кеш Цикл
            Если Стр.Спецификация <> СтрокаПлана.Спецификация Тогда Продолжить; КонецЕсли;
            СтрокаИтога = NX50_НайтиСтроку(Потребность,Стр.Материал,Стр.Характеристика);
            Если СтрокаИтога = Неопределено Тогда
                СтрокаИтога = Потребность.Добавить();
                СтрокаИтога.Материал = Стр.Материал;
                СтрокаИтога.Характеристика = Стр.Характеристика;
                СтрокаИтога.Цена = ?(Стр.ЦенаДоступна,Стр.Цена,0);
                СтрокаИтога.Статус = ?(Стр.ЦенаДоступна,"OK","НЕМАЄ ЦІНИ");
            КонецЕсли;
            СтрокаИтога.Потребность = СтрокаИтога.Потребность + Стр.Количество * СтрокаПлана.Кг / 1000;
            Если НЕ Стр.ЦенаДоступна Тогда
                СтрокаИтога.Статус = "НЕМАЄ ЦІНИ";
            КонецЕсли;
            ВсегоСтрок = ВсегоСтрок + 1;
        КонецЦикла;
    КонецЦикла;
    Стоимость = 0;
    Дефицитных = 0;
    НеуказанСклад = 0;
    Для Каждого СтрИтога Из Потребность Цикл
        СтрСклада = NX50_НайтиСтроку(Склад,СтрИтога.Материал,СтрИтога.Характеристика);
        Если СтрСклада <> Неопределено Тогда
            СтрИтога.Остаток = СтрСклада.Остаток;
            СтрИтога.Дефицит = ?(СтрИтога.Потребность > СтрИтога.Остаток, СтрИтога.Потребность - СтрИтога.Остаток, 0);
            Если СтрИтога.Дефицит > 0 Тогда Дефицитных = Дефицитных + 1; КонецЕсли;
        Иначе
            // 0 тут НЕ означає нуль на складі — просто немає даних.
            НеуказанСклад = НеуказанСклад + 1;
            СтрИтога.Статус = СтрИтога.Статус + "; ЗАЛИШОК НЕ ЗАДАНО";
        КонецЕсли;
        Если СтрНайти(СтрИтога.Статус,"НЕМАЄ ЦІНИ") > 0 Тогда
            Неизвестных = Неизвестных + 1;
        Иначе
            СтрИтога.Сумма = Окр(СтрИтога.Потребность * СтрИтога.Цена, 2);
            Стоимость = Стоимость + СтрИтога.Сумма;
        КонецЕсли;
    КонецЦикла;
    ЗначениеВРеквизитФормы(Потребность,"NX50_Потребность");
    Переработка = Окр(ОбщийВес * 50,2);
    ЭтаФорма["NX50_ИтогПлана"] = "План: " + Строка(Окр(ОбщийВес,2)) + " кг; матеріалів: "
        + Строка(Потребность.Количество()) + "; без ціни: " + Строка(Неизвестных)
        + "; вартість відомих матеріалів: " + Строка(Окр(Стоимость,2)) + " грн; переробка: "
        + Строка(Переработка) + " грн."
        + ?(Неизвестных > 0," Загальна вартість НЕ визначена (неповні ціни).",
            " Разом: " + Строка(Окр(Стоимость + Переработка,2)) + " грн.");
    ЭтаФорма["NX50_ИтогСклада"] = "Сценарний дефіцит матеріалів: " + Строка(Дефицитных)
        + "; залишок не задано для: " + Строка(НеуказанСклад)
        + ". НЕ є фактичним звітом про залишки BAS.";
КонецПроцедуры

&НаСервере
Процедура NX50_ЗадатьОстатокНаСервере(Материал, Характеристика)
    Если НЕ ЗначениеЗаполнено(Материал) Тогда
        Сообщить("Спочатку виділіть матеріал у таблиці потреби.");
        Возврат;
    КонецЕсли;
    Остаток = ЭтаФорма["NX50_ОстатокВвод"];
    Если Остаток < 0 Тогда Сообщить("Залишок не може бути від'ємним."); Возврат; КонецЕсли;
    Склад = РеквизитФормыВЗначение("NX50_Склад");
    Стр = NX50_НайтиСтроку(Склад,Материал,Характеристика);
    Если Стр = Неопределено Тогда
        Стр = Склад.Добавить();
        Стр.Материал = Материал;
        Стр.Характеристика = Характеристика;
    КонецЕсли;
    Стр.Остаток = Остаток;
    ЗначениеВРеквизитФормы(Склад,"NX50_Склад");
    NX50_ПересчитатьПланНаСервере();
КонецПроцедуры

&НаСервере
Процедура NX50_ЗагрузитьКонструкторНаСервере()
    Спец = ЭтаФорма["NX50_СпецификацияКонструктора"];
    Таб = NX50_НоваяТаблица("NX50_Конструктор");
    Кеш = РеквизитФормыВЗначение("UX42_Кэш");
    Если НЕ ЗначениеЗаполнено(Спец) Тогда
        ЭтаФорма["NX50_ИтогРецепта"] = "Виберіть базову специфікацію.";
        Возврат;
    КонецЕсли;
    Для Каждого Стр Из Кеш Цикл
        Если Стр.Спецификация <> Спец Тогда Продолжить; КонецЕсли;
        Н = Таб.Добавить();
        Н.Материал = Стр.Материал;
        Н.Характеристика = Стр.Характеристика;
        Н.Количество = Стр.Количество;
    КонецЦикла;
    ЗначениеВРеквизитФормы(Таб,"NX50_Конструктор");
    NX50_ПересчитатьКонструкторНаСервере();
КонецПроцедуры

&НаСервере
Процедура NX50_ДобавитьМатериалНаСервере()
    Материал = ЭтаФорма["NX50_НовыйМатериал"];
    Количество = ЭтаФорма["NX50_НоваяКоличество"];
    Если НЕ ЗначениеЗаполнено(Материал) ИЛИ Количество <= 0 Тогда
        Сообщить("Виберіть матеріал і додатну кількість.");
        Возврат;
    КонецЕсли;
    Таб = РеквизитФормыВЗначение("NX50_Конструктор");
    Н = Таб.Добавить();
    Н.Материал = Материал;
    Н.Характеристика = ЭтаФорма["NX50_НоваяХарактеристика"];
    Н.Количество = Количество;
    ЗначениеВРеквизитФормы(Таб,"NX50_Конструктор");
    NX50_ПересчитатьКонструкторНаСервере();
КонецПроцедуры

&НаСервере
Процедура NX50_ПересчитатьКонструкторНаСервере()
    Таб = РеквизитФормыВЗначение("NX50_Конструктор");
    Кеш = РеквизитФормыВЗначение("UX42_Кэш");
    Каталог = РеквизитФормыВЗначение("UX40_Каталог");
    База = Каталог.Найти(ЭтаФорма["NX50_СпецификацияКонструктора"],"Спецификация");
    Итог = 0;
    Неизвестных = 0;
    Некорректных = 0;
    Для Каждого Р Из Таб Цикл
        Цена = NX50_ПолучитьЦенуИзКеша(Р.Материал,Р.Характеристика,Кеш);
        Р.Цена = Цена;
        Если Р.Количество <= 0 Тогда
            Р.Сумма = 0;
            Р.Статус = "КІЛЬКІСТЬ <= 0";
            Некорректных = Некорректных + 1;
        ИначеЕсли Цена <= 0 Тогда
            Р.Сумма = 0;
            Р.Статус = "НЕМАЄ ЦІНИ В КЕШІ";
            Неизвестных = Неизвестных + 1;
        Иначе
            Р.Сумма = Окр(Р.Количество * Цена,2);
            Итог = Итог + Р.Сумма;
            Р.Статус = "OK";
        КонецЕсли;
    КонецЦикла;
    ЗначениеВРеквизитФормы(Таб,"NX50_Конструктор");
    Если Таб.Количество() = 0 Тогда
        ЭтаФорма["NX50_ИтогРецепта"] = "Немає матеріалів для розрахунку.";
    ИначеЕсли Неизвестных > 0 ИЛИ Некорректных > 0 Тогда
        ЭтаФорма["NX50_ИтогРецепта"] = "НЕПОВНО: без цін " + Строка(Неизвестных)
            + "; помилок кількості " + Строка(Некорректных) + ". Рекомендації заблоковані.";
    Иначе
        НоваяСебест = Окр((Итог + 50000) / 1000,4);
        Если База = Неопределено Тогда
            ЭтаФорма["NX50_ИтогРецепта"] = "Сценарна собівартість: " + Строка(НоваяСебест) + " грн/кг.";
        ИначеЕсли НЕ UX40_ЕстьПолныеЦены(База) Тогда
            ЭтаФорма["NX50_ИтогРецепта"] = "Сценарна собівартість: " + Строка(НоваяСебест)
                + " грн/кг; базовий рецепт неповний, порівняння недоступне.";
        Иначе
            ЭтаФорма["NX50_ИтогРецепта"] = "Сценарна с/в " + Строка(НоваяСебест) + " грн/кг; базова "
                + Строка(База.Себестоимость) + "; різниця "
                + Строка(Окр(НоваяСебест-База.Себестоимость,2)) + " грн/кг. Переробка 50 грн/кг.";
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура NX50_СформироватьПрайсНаСервере()
    Маржа = ЭтаФорма["NX50_МаржаПрайса"];
    Шаг = ЭтаФорма["NX50_ШагЦены"];
    Если Маржа < 0 ИЛИ Маржа >= 100 ИЛИ Шаг <= 0 Тогда
        ЭтаФорма["NX50_ИтогПрайса"] = "Маржа: 0...99,99%; крок округлення > 0 грн.";
        Возврат;
    КонецЕсли;
    Каталог = РеквизитФормыВЗначение("UX40_Каталог");
    Прайс = NX50_НоваяТаблица("NX50_Прайс");
    Пропущено = 0;
    Для Каждого Стр Из Каталог Цикл
        Если НЕ Стр.Активна Тогда Продолжить; КонецЕсли;
        Если НЕ UX40_ЕстьПолныеЦены(Стр) Тогда
            Пропущено = Пропущено + 1;
            Продолжить;
        КонецЕсли;
        Исходная = Стр.Себестоимость / (1 - Маржа / 100);
        КоличествоШагов = Цел(Исходная / Шаг);
        Если КоличествоШагов * Шаг < Исходная Тогда
            КоличествоШагов = КоличествоШагов + 1;
        КонецЕсли;
        Н = Прайс.Добавить();
        Н.Спецификация = Стр.Спецификация;
        Н.Продукция = Стр.Название;
        Н.Канал = Стр.Категория;
        Н.Себестоимость = Стр.Себестоимость;
        Н.ЦенаТекущая = Стр.ЦенаПродажи;
        Н.ЦенаРеком = Окр(КоличествоШагов * Шаг, 4);
        Н.Разница = Окр(Н.ЦенаРеком - Н.ЦенаТекущая, 4);
        Н.Статус = ?(Н.ЦенаТекущая > 0,"ПРОЕКТ / НЕ ЗАПИСАНО","НЕМАЄ ПРОДАЖУ");
    КонецЦикла;
    ЗначениеВРеквизитФормы(Прайс,"NX50_Прайс");
    ЭтаФорма["NX50_ИтогПрайса"] = "Проектні ціни: " + Строка(Прайс.Количество())
        + "; без повної собівартості пропущено: " + Строка(Пропущено)
        + "; цільова маржа " + Строка(Маржа) + "% (без ПДВ). Не враховані індивідуальні знижки клієнтів.";
КонецПроцедуры

&НаСервере
Процедура NX50_РассчитатьЭнергиюНаСервере()
    Удельное = ЭтаФорма["NX50_ЭнергияКВтЧТ"];
    А = ЭтаФорма["NX50_ТарифА"];
    Б = ЭтаФорма["NX50_ТарифБ"];
    Кг = ЭтаФорма["NX50_ЭнергияОбъемКг"];
    Если Удельное < 0 ИЛИ А < 0 ИЛИ Б < 0 ИЛИ Кг <= 0 Тогда
        ЭтаФорма["NX50_ИтогЭнергии"] = "Потрібні невід'ємні тарифи та споживання, а обсяг > 0.";
        Возврат;
    КонецЕсли;
    КВтЧ = Окр(Удельное * Кг / 1000,3);
    СтоимостьА = Окр(КВтЧ * А,2);
    СтоимостьБ = Окр(КВтЧ * Б,2);
    ЭтаФорма["NX50_ИтогЭнергии"] = "Партія " + Строка(Кг) + " кг; " + Строка(КВтЧ)
        + " кВт·год. Тариф А: " + Строка(СтоимостьА) + " грн; тариф Б: "
        + Строка(СтоимостьБ) + " грн; різниця Б−А: "
        + Строка(Окр(СтоимостьБ-СтоимостьА,2)) + " грн ("
        + Строка(Окр((Б-А)*Удельное/1000,4)) + " грн/кг). Це НЕ заміна фактичної калькуляції.";
КонецПроцедуры

&НаСервере
Процедура NX50_ОтветитьНаСервере()
    ЗапросПользователя = НРег(СокрЛП(ЭтаФорма["NX50_Вопрос"]));
    Каталог = РеквизитФормыВЗначение("UX40_Каталог");
    Если ПустаяСтрока(ЗапросПользователя) Тогда
        ЭтаФорма["NX50_Ответ"] = "Напишіть: рецепти, проблеми, немає цін, найдорожчий, план, енергія, допомога.";
        Возврат;
    КонецЕсли;
    Если СтрНайти(ЗапросПользователя,"допом") > 0 ИЛИ СтрНайти(ЗапросПользователя,"що вміє") > 0 Тогда
        ЭтаФорма["NX50_Ответ"] = "Команди: рецепти; проблеми; немає цін; найдорожчий; план; енергія. Локальні правила, без API та генеративного AI.";
    ИначеЕсли СтрНайти(ЗапросПользователя,"рецепт") > 0 Тогда
        ЭтаФорма["NX50_Ответ"] = "У завантаженому каталозі рецептів: " + Строка(Каталог.Количество()) + ".";
    ИначеЕсли СтрНайти(ЗапросПользователя,"проблем") > 0 Тогда
        Проблемы = РеквизитФормыВЗначение("UX40_Проблемы");
        ЭтаФорма["NX50_Ответ"] = "Позицій у центрі контролю: " + Строка(Проблемы.Количество())
            + ". Перейдіть у розділ «Контроль».";
    ИначеЕсли СтрНайти(ЗапросПользователя,"немає цін") > 0 ИЛИ СтрНайти(ЗапросПользователя,"без цін") > 0 Тогда
        Счет = 0;
        Для Каждого Стр Из Каталог Цикл
            Если Стр.Материалов > Стр.ЦенНайдено Тогда Счет = Счет + 1; КонецЕсли;
        КонецЦикла;
        ЭтаФорма["NX50_Ответ"] = "Рецептур із відсутніми цінами матеріалів: " + Строка(Счет) + ".";
    ИначеЕсли СтрНайти(ЗапросПользователя,"найдорож") > 0 Тогда
        Лидер = Неопределено;
        Для Каждого Стр Из Каталог Цикл
            Если UX40_ЕстьПолныеЦены(Стр) Тогда
                Если Лидер = Неопределено Тогда Лидер = Стр;
                ИначеЕсли Стр.Себестоимость > Лидер.Себестоимость Тогда Лидер = Стр;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Если Лидер = Неопределено Тогда
            ЭтаФорма["NX50_Ответ"] = "Немає повністю розрахованих рецептів.";
        Иначе
            ЭтаФорма["NX50_Ответ"] = "Найбільша калькуляційна собівартість: " + Лидер.Название
                + " — " + Строка(Лидер.Себестоимость) + " грн/кг.";
        КонецЕсли;
    ИначеЕсли СтрНайти(ЗапросПользователя,"план") > 0 Тогда
        ЭтаФорма["NX50_Ответ"] = ЭтаФорма["NX50_ИтогПлана"];
    ИначеЕсли СтрНайти(ЗапросПользователя,"енерг") > 0 Тогда
        ЭтаФорма["NX50_Ответ"] = ЭтаФорма["NX50_ИтогЭнергии"];
    Иначе
        ЭтаФорма["NX50_Ответ"] = "Не розпізнав запит. Це локальний командний помічник без нейромережі. Напишіть «допомога».";
    КонецЕсли;
КонецПроцедуры

