&НаСервере
Процедура UX40_СоздатьРеквизиты()
    Добавляемые = Новый Массив;
    ТекстКороткий = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250));
    ТекстДлинный = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000));
    ЧислоЦена = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 4));
    ЧислоПроц = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2));
    ЧислоКоличество = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 0));
    ТипСпец = Новый ОписаниеТипов("СправочникСсылка.Спецификации");

    Для Каждого Название Из СтрРазделить("UX40_Каталог,UX40_Результаты,UX40_Проблемы,UX40_ТопСигналов,UX40_Каналы", ",") Цикл
        Добавляемые.Добавить(Новый РеквизитФормы(Название,
            Новый ОписаниеТипов("ТаблицаЗначений")));
    КонецЦикла;
    Для Каждого Название Из СтрРазделить("UX40_КПИВсего,UX40_КПИАктивных,UX40_КПИПроблем,UX40_КПИБезЦен,UX40_КПИСредняяМаржа,UX40_СтрокаПоиска,UX40_РежимФильтра,UX40_ПодписьРезультатов,UX40_ИтогСценария", ",") Цикл
        Добавляемые.Добавить(Новый РеквизитФормы(Название, ТекстДлинный));
    КонецЦикла;
    Для Каждого Название Из СтрРазделить("UX40_ПорогМаржи,UX40_ЦелеваяМаржа", ",") Цикл
        Добавляемые.Добавить(Новый РеквизитФормы(Название, ЧислоПроц));
    КонецЦикла;
    Для Каждого Название Из СтрРазделить("UX40_ДопЗатраты,UX40_ОбъемКг,UX40_БазоваяСебестоимость,UX40_БазоваяПродажа,UX40_РекомендованнаяЦена", ",") Цикл
        Добавляемые.Добавить(Новый РеквизитФормы(Название, ЧислоЦена));
    КонецЦикла;
    Добавляемые.Добавить(Новый РеквизитФормы("UX40_ВыбраннаяСпецификация", ТипСпец));
    ИзменитьРеквизиты(Добавляемые);

    Колонки = Новый Массив;
    Для Каждого ИмяТаблицы Из СтрРазделить("UX40_Каталог,UX40_Результаты,UX40_Проблемы,UX40_ТопСигналов", ",") Цикл
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Название", ТекстДлинный);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Спецификация", ТипСпец);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Категория", ТекстКороткий);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Проблема", ТекстКороткий);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Приоритет", ЧислоКоличество);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "ИсходныйСтатус", ТекстКороткий);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Материалов", ЧислоКоличество);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "ЦенНайдено", ЧислоКоличество);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Себестоимость", ЧислоЦена);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "ЦенаПродажи", ЧислоЦена);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Маржа", ЧислоПроц);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Наценка", ЧислоПроц);
        UX35_ДобавитьКолонку(Колонки, ИмяТаблицы, "Активна", Новый ОписаниеТипов("Булево"));
    КонецЦикла;
    UX35_ДобавитьКолонку(Колонки, "UX40_Каналы", "Канал", ТекстКороткий);
    UX35_ДобавитьКолонку(Колонки, "UX40_Каналы", "Количество", ЧислоКоличество);
    UX35_ДобавитьКолонку(Колонки, "UX40_Каналы", "Проблем", ЧислоКоличество);
    UX35_ДобавитьКолонку(Колонки, "UX40_Каналы", "СредняяМаржа", ЧислоПроц);
    ИзменитьРеквизиты(Колонки);

    ЗначениеВРеквизитФормы(UX40_НоваяТаблицаКаталога(), "UX40_Каталог");
    ЗначениеВРеквизитФормы(UX40_НоваяТаблицаКаталога(), "UX40_Результаты");
    ЗначениеВРеквизитФормы(UX40_НоваяТаблицаКаталога(), "UX40_Проблемы");
    ЗначениеВРеквизитФормы(UX40_НоваяТаблицаКаталога(), "UX40_ТопСигналов");
    ЗначениеВРеквизитФормы(UX40_НоваяТаблицаКаналов(), "UX40_Каналы");
    ЭтаФорма["UX40_ПорогМаржи"] = 20;
    ЭтаФорма["UX40_ЦелеваяМаржа"] = 25;
    ЭтаФорма["UX40_ОбъемКг"] = 1000;
    ЭтаФорма["UX40_ДопЗатраты"] = 0;
    ЭтаФорма["UX40_РежимФильтра"] = "ВСЕ";
    ЭтаФорма["UX40_ПодписьРезультатов"] = "Спочатку натисніть «Оновити дані»";
    ЭтаФорма["UX40_КПИВсего"] = "—";
    ЭтаФорма["UX40_КПИАктивных"] = "—";
    ЭтаФорма["UX40_КПИПроблем"] = "—";
    ЭтаФорма["UX40_КПИБезЦен"] = "—";
    ЭтаФорма["UX40_КПИСредняяМаржа"] = "—";
    ЭтаФорма["UX40_ИтогСценария"] = "Спочатку виберіть рецептуру.";
КонецПроцедуры

&НаСервере
Функция UX40_НоваяТаблицаКаталога()
    Таб = Новый ТаблицаЗначений;
    Текст250 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250));
    Текст1000 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000));
    ЧислоЦена = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 4));
    ЧислоПроц = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2));
    ЧислоЦел = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 0));
    Таб.Колонки.Добавить("Название", Текст1000);
    Таб.Колонки.Добавить("Спецификация", Новый ОписаниеТипов("СправочникСсылка.Спецификации"));
    Таб.Колонки.Добавить("Категория", Текст250);
    Таб.Колонки.Добавить("Проблема", Текст250);
    Таб.Колонки.Добавить("Приоритет", ЧислоЦел);
    Таб.Колонки.Добавить("ИсходныйСтатус", Текст250);
    Таб.Колонки.Добавить("Материалов", ЧислоЦел);
    Таб.Колонки.Добавить("ЦенНайдено", ЧислоЦел);
    Таб.Колонки.Добавить("Себестоимость", ЧислоЦена);
    Таб.Колонки.Добавить("ЦенаПродажи", ЧислоЦена);
    Таб.Колонки.Добавить("Маржа", ЧислоПроц);
    Таб.Колонки.Добавить("Наценка", ЧислоПроц);
    Таб.Колонки.Добавить("Активна", Новый ОписаниеТипов("Булево"));
    Возврат Таб;
КонецФункции

&НаСервере
Функция UX40_НоваяТаблицаКаналов()
    Таб = Новый ТаблицаЗначений;
    Таб.Колонки.Добавить("Канал", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
    Таб.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 0)));
    Таб.Колонки.Добавить("Проблем", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 0)));
    Таб.Колонки.Добавить("СредняяМаржа", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2)));
    Возврат Таб;
КонецФункции

&НаСервере
Процедура UX40_ПостроитьВитринуНаСервере()
    Дерево = РеквизитФормыВЗначение("ТаблицаРецептур");
    Каталог = UX40_НоваяТаблицаКаталога();
    UX40_ОбойтиДерево(Дерево.Строки, "", Каталог);
    ЗначениеВРеквизитФормы(Каталог, "UX40_Каталог");
    UX40_ПересчитатьКонтрольНаСервере();
    Если Каталог.Количество() > 0 Тогда
        // Зберігаємо вибір після оновлення, якщо рецепт ще існує.
        Текущий = Каталог.Найти(ЭтаФорма["UX40_ВыбраннаяСпецификация"], "Спецификация");
        Если Текущий = Неопределено Тогда
            Текущий = Каталог[0];
        КонецЕсли;
        UX40_ВыбратьРецептНаСервере(Текущий.Спецификация);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура UX40_ОбойтиДерево(СтрокиДерева, Путь, Каталог)
    Для Каждого Узел Из СтрокиДерева Цикл
        Если Узел.Статус = "ГРУПА" Тогда
            НовыйПуть = ?(ПустаяСтрока(Путь), Узел.Название, Путь + " / " + Узел.Название);
            UX40_ОбойтиДерево(Узел.Строки, НовыйПуть, Каталог);
        ИначеЕсли ЗначениеЗаполнено(Узел.Спецификация) Тогда
            Стр = Каталог.Добавить();
            Стр.Название = Узел.Название;
            Стр.Спецификация = Узел.Спецификация;
            Стр.Категория = Путь;
            Стр.Материалов = Узел.Материалов;
            Стр.ЦенНайдено = Узел.ЦенНайдено;
            Стр.Себестоимость = Узел.Себестоимость;
            Стр.ЦенаПродажи = Узел.ЦенаПродажи;
            Стр.Наценка = Узел.Рентабельность;
            Стр.Активна = СтрНайти(ВРег(Путь), "НЕ ВИКОРИСТОВУЮТЬСЯ") = 0;
            Стр.ИсходныйСтатус = Узел.Статус;
            Если UX40_ЕстьПолныеЦены(Стр) И Стр.ЦенаПродажи > 0 Тогда
                Стр.Маржа = Окр((Стр.ЦенаПродажи - Стр.Себестоимость)
                    / Стр.ЦенаПродажи * 100, 2);
            КонецЕсли;
            // Статус із вихідного дерева доповнює категоризацію помилок.
            Стр.Проблема = UX40_ТипПроблемы(Стр, Узел.Статус);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция UX40_ЕстьПолныеЦены(Стр)
    Возврат Стр.Материалов > 0
        И Стр.Материалов = Стр.ЦенНайдено
        И Стр.Себестоимость > 0;
КонецФункции

&НаСервере
Функция UX40_ТипПроблемы(Стр, ИсходныйСтатус)
    Если Стр.Материалов = 0 Тогда
        Возврат "НЕМАЄ СКЛАДУ";
    ИначеЕсли Стр.Материалов <> Стр.ЦенНайдено Тогда
        Возврат "НЕМАЄ ЦІН: " + Строка(Стр.Материалов - Стр.ЦенНайдено);
    ИначеЕсли СтрНайти(ВРег(ИсходныйСтатус), "ВАГУ") > 0 Тогда
        Возврат "НЕ ВИЗНАЧЕНО ВАГУ";
    ИначеЕсли СтрНайти(ВРег(ИсходныйСтатус), "ВАЛЮТ") > 0
        ИЛИ СтрНайти(ВРег(ИсходныйСтатус), "ПДВ") > 0 Тогда
        Возврат "ПЕРЕВІРИТИ ЦІНУ ПРОДАЖУ";
    ИначеЕсли Стр.ЦенаПродажи <= 0 Тогда
        Возврат "НЕМАЄ ЦІНИ ПРОДАЖУ";
    ИначеЕсли Стр.ЦенаПродажи < Стр.Себестоимость Тогда
        Возврат "ЗБИТКОВА ПОЗИЦІЯ";
    ИначеЕсли Стр.Маржа < ЭтаФорма["UX40_ПорогМаржи"] Тогда
        Возврат "НИЗЬКА МАРЖА";
    КонецЕсли;
    Возврат "OK";
КонецФункции

&НаСервере
Функция UX40_ПриоритетПроблемы(Описание)
    Если Описание = "ЗБИТКОВА ПОЗИЦІЯ" Тогда
        Возврат 1;
    ИначеЕсли СтрНайти(Описание, "НЕМАЄ ЦІН") > 0
        ИЛИ Описание = "НЕМАЄ СКЛАДУ" Тогда
        Возврат 2;
    ИначеЕсли Описание = "НЕ ВИЗНАЧЕНО ВАГУ"
        ИЛИ Описание = "ПЕРЕВІРИТИ ЦІНУ ПРОДАЖУ"
        ИЛИ Описание = "НЕМАЄ ЦІНИ ПРОДАЖУ" Тогда
        Возврат 3;
    ИначеЕсли Описание = "НИЗЬКА МАРЖА" Тогда
        Возврат 4;
    КонецЕсли;
    Возврат 9;
КонецФункции

&НаСервере
Процедура UX40_ПересчитатьКонтрольНаСервере()
    Каталог = РеквизитФормыВЗначение("UX40_Каталог");
    Проблемы = UX40_НоваяТаблицаКаталога();
    Топ = UX40_НоваяТаблицаКаталога();
    Каналы = UX40_НоваяТаблицаКаналов();
    ИндексКаналов = Новый Соответствие;
    СредМаржаСумма = 0;
    СредМаржаКоличество = 0;
    КолАктивных = 0;
    КолНеполных = 0;
    Для Каждого Стр Из Каталог Цикл
        // Поріг маржі користувач може змінювати без повторного завантаження рецептів.
        Стр.Проблема = UX40_ТипПроблемы(Стр, Стр.ИсходныйСтатус);
        Стр.Приоритет = UX40_ПриоритетПроблемы(Стр.Проблема);
        Если Стр.Активна Тогда
            КолАктивных = КолАктивных + 1;
        КонецЕсли;
        Если НЕ UX40_ЕстьПолныеЦены(Стр) Тогда
            КолНеполных = КолНеполных + 1;
        КонецЕсли;
        Если Стр.Активна И UX40_ЕстьПолныеЦены(Стр) И Стр.ЦенаПродажи > 0 Тогда
            СредМаржаКоличество = СредМаржаКоличество + 1;
            СредМаржаСумма = СредМаржаСумма + Стр.Маржа;
        КонецЕсли;
        Если Стр.Активна И Стр.Проблема <> "OK" Тогда
            UX40_КопироватьСтроку(Стр, Проблемы);
        КонецЕсли;
        Ключ = Стр.Категория;
        Свод = ИндексКаналов.Получить(Ключ);
        Если Свод = Неопределено Тогда
            Свод = Новый Структура("Всего,Проблем,МаржаСумма,МаржаКоличество", 0, 0, 0, 0);
            ИндексКаналов.Вставить(Ключ, Свод);
        КонецЕсли;
        Свод.Всего = Свод.Всего + 1;
        Если Стр.Активна И Стр.Проблема <> "OK" Тогда
            Свод.Проблем = Свод.Проблем + 1;
        КонецЕсли;
        Если UX40_ЕстьПолныеЦены(Стр) И Стр.ЦенаПродажи > 0 Тогда
            Свод.МаржаСумма = Свод.МаржаСумма + Стр.Маржа;
            Свод.МаржаКоличество = Свод.МаржаКоличество + 1;
        КонецЕсли;
    КонецЦикла;
    Проблемы.Сортировать("Приоритет, Маржа");
    Для Каждого Проблема Из Проблемы Цикл
        Если Топ.Количество() >= 12 Тогда
            Прервать;
        КонецЕсли;
        UX40_КопироватьСтроку(Проблема, Топ);
    КонецЦикла;
    Для Каждого Элемент Из ИндексКаналов Цикл
        СтрКанала = Каналы.Добавить();
        СтрКанала.Канал = Элемент.Ключ;
        СтрКанала.Количество = Элемент.Значение.Всего;
        СтрКанала.Проблем = Элемент.Значение.Проблем;
        Если Элемент.Значение.МаржаКоличество > 0 Тогда
            СтрКанала.СредняяМаржа = Окр(Элемент.Значение.МаржаСумма / Элемент.Значение.МаржаКоличество, 2);
        КонецЕсли;
    КонецЦикла;
    ЗначениеВРеквизитФормы(Каталог, "UX40_Каталог");
    ЗначениеВРеквизитФормы(Проблемы, "UX40_Проблемы");
    ЗначениеВРеквизитФормы(Топ, "UX40_ТопСигналов");
    ЗначениеВРеквизитФормы(Каналы, "UX40_Каналы");
    ЭтаФорма["UX40_КПИВсего"] = Строка(Каталог.Количество());
    ЭтаФорма["UX40_КПИАктивных"] = Строка(КолАктивных);
    ЭтаФорма["UX40_КПИПроблем"] = Строка(Проблемы.Количество());
    ЭтаФорма["UX40_КПИБезЦен"] = Строка(КолНеполных);
    ЭтаФорма["UX40_КПИСредняяМаржа"] = ?(СредМаржаКоличество > 0,
        Строка(Окр(СредМаржаСумма / ?(СредМаржаКоличество = 0, 1, СредМаржаКоличество), 2)) + " %", "немає даних");
    UX421_ОкраситьИтогМаржи(СредМаржаСумма, СредМаржаКоличество);
    UX40_ПрименитьПоискНаСервере();
КонецПроцедуры

&НаСервере
Процедура UX40_КопироватьСтроку(Источник, Приемник)
    Цель = Приемник.Добавить();
    ЗаполнитьЗначенияСвойств(Цель, Источник);
КонецПроцедуры

&НаСервере
Процедура UX40_ПрименитьПоискНаСервере()
    Каталог = РеквизитФормыВЗначение("UX40_Каталог");
    Результаты = UX40_НоваяТаблицаКаталога();
    Фраза = НРег(СокрЛП(ЭтаФорма["UX40_СтрокаПоиска"]));
    Режим = ЭтаФорма["UX40_РежимФильтра"];
    Для Каждого Стр Из Каталог Цикл
        Если НЕ ПустаяСтрока(Фраза)
            И СтрНайти(НРег(Стр.Название + " " + Стр.Категория + " " + Стр.Проблема), Фраза) = 0 Тогда
            Продолжить;
        КонецЕсли;
        Если Режим = "АКТИВНЫЕ" И НЕ Стр.Активна Тогда
            Продолжить;
        ИначеЕсли Режим = "БЕЗ_КАТ" И СтрНайти(НРег(Стр.Категория), "без категорії") = 0 Тогда
            Продолжить;
        ИначеЕсли Режим = "ПРОБЛЕМЫ" И Стр.Проблема = "OK" Тогда
            Продолжить;
        ИначеЕсли Режим = "НИЗКАЯ_МАРЖА" И Стр.Проблема <> "НИЗЬКА МАРЖА" Тогда
            Продолжить;
        КонецЕсли;
        UX40_КопироватьСтроку(Стр, Результаты);
    КонецЦикла;
    ЗначениеВРеквизитФормы(Результаты, "UX40_Результаты");
    ЭтаФорма["UX40_ПодписьРезультатов"] = "Знайдено: " + Строка(Результаты.Количество())
        + " із " + Строка(Каталог.Количество()) + " | Фільтр: " + Режим;
КонецПроцедуры

&НаСервере
Процедура UX40_ВыбратьРецептНаСервере(Спецификация)
    Если НЕ ЗначениеЗаполнено(Спецификация) Тогда
        Возврат;
    КонецЕсли;
    ЭтаФорма["UX40_ВыбраннаяСпецификация"] = Спецификация;
    Каталог = РеквизитФормыВЗначение("UX40_Каталог");
    СтрокаКаталога = Каталог.Найти(Спецификация, "Спецификация");
    Если СтрокаКаталога = Неопределено Тогда
        ЭтаФорма["UX40_ИтогСценария"] = "Немає інформації про вибрану специфікацію.";
        Возврат;
    КонецЕсли;
    ЭтаФорма["UX40_БазоваяСебестоимость"] = СтрокаКаталога.Себестоимость;
    ЭтаФорма["UX40_БазоваяПродажа"] = СтрокаКаталога.ЦенаПродажи;
    Если НЕ UX40_ЕстьПолныеЦены(СтрокаКаталога) Тогда
        ЭтаФорма["UX40_РекомендованнаяЦена"] = 0;
        ЭтаФорма["UX40_ИтогСценария"] = "Рекомендацію заблоковано: не всі матеріали мають ціну.";
    Иначе
        UX40_РассчитатьСценарийНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура UX40_РассчитатьСценарийНаСервере()
    Если НЕ ЗначениеЗаполнено(ЭтаФорма["UX40_ВыбраннаяСпецификация"]) Тогда
        ЭтаФорма["UX40_ИтогСценария"] = "Виберіть рецептуру у дереві, пошуку або контролі.";
        Возврат;
    КонецЕсли;
    Если ЭтаФорма["UX40_ЦелеваяМаржа"] < 0 ИЛИ ЭтаФорма["UX40_ЦелеваяМаржа"] >= 100 Тогда
        ЭтаФорма["UX40_РекомендованнаяЦена"] = 0;
        ЭтаФорма["UX40_ИтогСценария"] = "Цільова маржа повинна бути від 0 до 99,99%.";
        Возврат;
    КонецЕсли;
    Если ЭтаФорма["UX40_ДопЗатраты"] < 0 ИЛИ ЭтаФорма["UX40_ОбъемКг"] <= 0 Тогда
        ЭтаФорма["UX40_РекомендованнаяЦена"] = 0;
        ЭтаФорма["UX40_ИтогСценария"] = "Додаткові витрати ≥ 0, обсяг повинен бути > 0 кг.";
        Возврат;
    КонецЕсли;
    Каталог = РеквизитФормыВЗначение("UX40_Каталог");
    Товар = Каталог.Найти(ЭтаФорма["UX40_ВыбраннаяСпецификация"], "Спецификация");
    Если Товар = Неопределено Тогда
        ЭтаФорма["UX40_РекомендованнаяЦена"] = 0;
        ЭтаФорма["UX40_ИтогСценария"] = "Специфікацію не знайдено у поточній вітрині.";
        Возврат;
    КонецЕсли;
    Если НЕ UX40_ЕстьПолныеЦены(Товар) Тогда
        ЭтаФорма["UX40_РекомендованнаяЦена"] = 0;
        ЭтаФорма["UX40_ИтогСценария"] = "Немає повної перевіреної собівартості. Сценарій недоступний.";
        Возврат;
    КонецЕсли;
    СебестоимостьСценария = ЭтаФорма["UX40_БазоваяСебестоимость"] + ЭтаФорма["UX40_ДопЗатраты"];
    Рекомендация = Окр(СебестоимостьСценария / (1 - ЭтаФорма["UX40_ЦелеваяМаржа"] / 100), 4);
    ЭтаФорма["UX40_РекомендованнаяЦена"] = Рекомендация;
    Доход = Окр(Рекомендация * ЭтаФорма["UX40_ОбъемКг"], 2);
    СебестоимостьПартии = Окр(СебестоимостьСценария * ЭтаФорма["UX40_ОбъемКг"], 2);
    ВаловаяПрибыль = Окр(Доход - СебестоимостьПартии, 2);
    ЭтаФорма["UX40_ИтогСценария"] =
        "Собівартість зі змінами: " + Строка(Окр(СебестоимостьСценария, 2))
        + " грн/кг; виручка: " + Строка(Доход)
        + " грн; витрати: " + Строка(СебестоимостьПартии)
        + " грн; валовий прибуток: " + Строка(ВаловаяПрибыль) + " грн.";
КонецПроцедуры

// ---------- КЛІЄНТСЬКІ ДІЇ: НЕ ЗМІНЮЮТЬ БАЗУ ----------
&НаКлиенте
Процедура UX40_ОбновитьКоманда(Команда)
    Результат = ЗагрузитьВсеНаСервере(Ложь);
    Сообщить(Результат);
КонецПроцедуры

&НаКлиенте
Процедура UX40_НайтиКоманда(Команда)
