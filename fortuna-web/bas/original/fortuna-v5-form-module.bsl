&НаКлиенте
Процедура NX50_УдалитьМатериалКоманда(Команда)
    Д = Элементы.Найти("NX50_ТабКонструктора").ТекущиеДанные;
    Если Д = Неопределено Тогда Сообщить("Виберіть рядок сценарію."); Возврат; КонецЕсли;
    NX50_УдалитьМатериалНаСервере(Д.Материал,Д.Характеристика,Д.Количество);
КонецПроцедуры
&НаСервере
Процедура NX50_УдалитьМатериалНаСервере(Материал,Характеристика,Количество)
    Таб = РеквизитФормыВЗначение("NX50_Конструктор");
    Для Индекс = 0 По Таб.Количество()-1 Цикл
        Если Таб[Индекс].Материал = Материал И Таб[Индекс].Характеристика = Характеристика
            И Таб[Индекс].Количество = Количество Тогда
            Таб.Удалить(Индекс);
            Прервать;
        КонецЕсли;
    КонецЦикла;
    ЗначениеВРеквизитФормы(Таб,"NX50_Конструктор");
    NX50_ПересчитатьКонструкторНаСервере();
КонецПроцедуры
