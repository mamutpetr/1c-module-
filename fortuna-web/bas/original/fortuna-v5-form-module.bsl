// Склад і ціни завантажуються ОДИН РАЗ під час основного оновлення.
&НаСервере
Процедура UX42_ОбновитьПослеЗагрузки(Состав, Цены)
    Кэш = UX42_НоваяТаблица("Кэш");
    Для Каждого МатСтрока Из Состав Цикл
        Если НЕ ЗначениеЗаполнено(МатСтрока.Спецификация)
            ИЛИ НЕ ЗначениеЗаполнено(МатСтрока.Материал) Тогда
            Продолжить;
        КонецЕсли;
        Новая = Кэш.Добавить();
        Новая.Спецификация = МатСтрока.Спецификация;
        Новая.Материал = МатСтрока.Материал;
        Если ЗначениеЗаполнено(МатСтрока.Характеристика) Тогда
            Новая.Характеристика = МатСтрока.Характеристика;
        КонецЕсли;
        Новая.Количество = МатСтрока.Количество;
        Цена = НайтиПоследнююЦену(МатСтрока.Материал, МатСтрока.Характеристика, Цены);
        Если Цена <> Неопределено Тогда
            Если ЭтоГривнаИлиПусто(Цена.Валюта) И Цена.ЦенаБезНДС > 0 Тогда
                Новая.Цена = Цена.ЦенаБезНДС;
                Новая.ДатаЦены = Цена.Период;
                Новая.ЦенаДоступна = Истина;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    ЗначениеВРеквизитФормы(Кэш, "UX42_Кэш");
    UX42_ПересчитатьКачествоНаСервере();
    NX50_ПослеЗагрузки();
    // Не робимо штучного впливу на ціни до вибору матеріалу користувачем.
    Если ЗначениеЗаполнено(ЭтаФорма["UX42_Материал"]) Тогда
        UX42_РассчитатьВлияниеНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура UX42_РассчитатьВлияниеНаСервере()
    Результат = UX42_НоваяТаблица("Влияние");
    Материал = ЭтаФорма["UX42_Материал"];
    Если НЕ ЗначениеЗаполнено(Материал) Тогда
        ЗначениеВРеквизитФормы(Результат, "UX42_Влияние");
        ЭтаФорма["UX42_СводВлияния"] = "Виберіть матеріал з довідника або з нижньої калькуляції.";
        Возврат;
    КонецЕсли;
    Процент = ЭтаФорма["UX42_Процент"];
    Если Процент < -100 Тогда
        ЗначениеВРеквизитФормы(Результат, "UX42_Влияние");
        ЭтаФорма["UX42_СводВлияния"] = "Зниження ціни не може перевищувати 100%.";
        Возврат;
    КонецЕсли;
    Кэш = РеквизитФормыВЗначение("UX42_Кэш");
    Каталог = РеквизитФормыВЗначение("UX40_Каталог");
    Для Каждого Стр Из Кэш Цикл
        Если Стр.Материал <> Материал Тогда
            Продолжить;
        КонецЕсли;
        СтрВывода = Результат.Найти(Стр.Спецификация, "Спецификация");
        Если СтрВывода = Неопределено Тогда
            СтрВывода = Результат.Добавить();
            СтрВывода.Спецификация = Стр.Спецификация;
            СтрВывода.Продукция = Строка(Стр.Спецификация);
            Кат = Каталог.Найти(Стр.Спецификация, "Спецификация");
            Если Кат <> Неопределено Тогда
                СтрВывода.Продукция = Кат.Название;
            КонецЕсли;
            СтрВывода.Статус = "ЦІНА Є";
        КонецЕсли;
        СтрВывода.Количество = СтрВывода.Количество + Стр.Количество;
        Если НЕ Стр.ЦенаДоступна Тогда
            СтрВывода.Статус = "НЕМАЄ ЦІНИ — ВПЛИВ НЕВІДОМИЙ";
        Иначе
            СтрВывода.Цена = Стр.Цена;
            СтрВывода.ДельтаКг = СтрВывода.ДельтаКг
                + Окр(Стр.Количество * Стр.Цена * Процент / 100 / 1000, 4);
        КонецЕсли;
    КонецЦикла;
    Для Каждого Стр Из Результат Цикл
        Если Стр.Статус <> "ЦІНА Є" Тогда
            Стр.ДельтаКг = 0; // не виводимо частковий результат як фінальний
        КонецЕсли;
    КонецЦикла;
    ЗначениеВРеквизитФормы(Результат, "UX42_Влияние");
    ЭтаФорма["UX42_СводВлияния"] = "Залежних рецептур: " + Строка(Результат.Количество())
        + ". Зміна ціни: " + Строка(Процент) + "% (для обраного матеріалу)."
        + " Δ у грн/кг на основі 1000 кг виходу; без зміни BAS."
        + " Одиниці та еквівалентність характеристик перевіряйте окремо.";
КонецПроцедуры

&НаСервере
Процедура UX42_СравнитьНаСервере()
    Таб = UX42_НоваяТаблица("Сравнение");
    А = ЭтаФорма["UX42_РецептА"];
    Б = ЭтаФорма["UX42_РецептБ"];
    Если НЕ ЗначениеЗаполнено(А) ИЛИ НЕ ЗначениеЗаполнено(Б) Тогда
        ЭтаФорма["UX42_СводСравнения"] = "Оберіть дві специфікації. Обрану в основному списку можна перенести кнопкою «Обрану → Б».";
        ЗначениеВРеквизитФормы(Таб, "UX42_СравнениеТаб");
        Возврат;
    КонецЕсли;
    Если А = Б Тогда
        ЭтаФорма["UX42_СводСравнения"] = "Для порівняння потрібно вибрати РІЗНІ рецептури.";
        ЗначениеВРеквизитФормы(Таб, "UX42_СравнениеТаб");
        Возврат;
    КонецЕсли;
    Кэш = РеквизитФормыВЗначение("UX42_Кэш");
    Для Каждого Стр Из Кэш Цикл
        Если Стр.Спецификация <> А И Стр.Спецификация <> Б Тогда
            Продолжить;
        КонецЕсли;
        Поиск = Новый Структура;
        Поиск.Вставить("Материал", Стр.Материал);
        Поиск.Вставить("Характеристика", Стр.Характеристика);
        Строки = Таб.НайтиСтроки(Поиск);
        Если Строки.Количество() = 0 Тогда
            Рез = Таб.Добавить();
            Рез.Материал = Стр.Материал;
            Рез.Характеристика = Стр.Характеристика;
            Рез.Статус = "OK";
        Иначе
            Рез = Строки[0];
        КонецЕсли;
        Если Стр.Спецификация = А Тогда
            Рез.КоличествоА = Рез.КоличествоА + Стр.Количество;
        Иначе
            Рез.КоличествоБ = Рез.КоличествоБ + Стр.Количество;
        КонецЕсли;
        Если НЕ Стр.ЦенаДоступна Тогда
            Рез.Статус = "НЕМАЄ ЦІНИ";
        Иначе
            Рез.Цена = Стр.Цена;
        КонецЕсли;
    КонецЦикла;
    Если Таб.Количество() = 0 Тогда
        ЭтаФорма["UX42_СводСравнения"] = "Для вибраних специфікацій немає складових у поточному завантаженні.";
        ЗначениеВРеквизитФормы(Таб, "UX42_СравнениеТаб");
        Возврат;
    КонецЕсли;
    Дельта = 0;
    Проблем = 0;
    Для Каждого Стр Из Таб Цикл
        Если Стр.Статус = "OK" Тогда
            Стр.РазницаНаКг = Окр((Стр.КоличествоБ - Стр.КоличествоА) * Стр.Цена / 1000, 4);
            Дельта = Дельта + Стр.РазницаНаКг;
        Иначе
            Стр.РазницаНаКг = 0;
            Проблем = Проблем + 1;
        КонецЕсли;
    КонецЦикла;
    ЗначениеВРеквизитФормы(Таб, "UX42_СравнениеТаб");
    Если Проблем > 0 Тогда
        ЭтаФорма["UX42_СводСравнения"] = "Неповне порівняння: " + Строка(Проблем)
            + " матеріалів без ціни. Загальну різницю не розраховано.";
    Иначе
        ЭтаФорма["UX42_СводСравнения"] = "Різниця Б − A: " + Строка(Окр(Дельта, 2))
            + " грн/кг (негативна = Б дешевша). Переробка 50 грн/кг є в обох рецептах"
            + " й взаємно скорочується. Ціни без ПДВ; не змінює записи BAS.";
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура UX42_ПересчитатьКачествоНаСервере()
    Кэш = РеквизитФормыВЗначение("UX42_Кэш");
    Каталог = РеквизитФормыВЗначение("UX40_Каталог");
    Качество = UX42_НоваяТаблица("Качество");
    Рекомендации = UX42_НоваяТаблица("Советы");
    Порог = ЭтаФорма["UX42_ДнейАктуальности"];
    Если Порог <= 0 Тогда
        Порог = 90;
        ЭтаФорма["UX42_ДнейАктуальности"] = Порог;
    КонецЕсли;
    ПределДаты = ТекущаяДата() - Порог * 86400;
    Индекс = Новый Соответствие;
    Для Каждого Стр Из Каталог Цикл
        Кач = Качество.Добавить();
        Кач.Продукция = Стр.Название;
        Кач.Спецификация = Стр.Спецификация;
        Кач.ЦенНет = 0;
        Кач.ЦенСтарых = 0;
        Индекс.Вставить(Стр.Спецификация, Кач);
    КонецЦикла;
    Для Каждого Стр Из Кэш Цикл
        Кач = Индекс.Получить(Стр.Спецификация);
        Если Кач = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если НЕ Стр.ЦенаДоступна Тогда
            Кач.ЦенНет = Кач.ЦенНет + 1;
        ИначеЕсли Стр.ДатаЦены < ПределДаты Тогда
            Кач.ЦенСтарых = Кач.ЦенСтарых + 1;
        КонецЕсли;
    КонецЦикла;
    ВсегоПроблем = 0;
    Для Каждого Кач Из Качество Цикл
        Кат = Каталог.Найти(Кач.Спецификация, "Спецификация");
        Если Кат = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если Кат.Материалов = 0 Тогда
            Кач.Статус = "НЕМАЄ СКЛАДУ";
            Кач.Рекомендация = "Перевірити склад специфікації в BAS: не знайдено жодного матеріалу.";
            UX42_ДобавитьСовет(Рекомендации, 1, Кат, Кач.Статус, Кач.Рекомендация);
        ИначеЕсли Кач.ЦенНет > 0 Тогда
            Кач.Статус = "НЕПОВНІ ЗАКУПІВЕЛЬНІ ЦІНИ";
            Кач.Рекомендация = "Перевірити останні надходження: " + Строка(Кач.ЦенНет) + " матеріалів без ціни/гривні.";
            UX42_ДобавитьСовет(Рекомендации, 1, Кат, Кач.Статус, Кач.Рекомендация);
        ИначеЕсли Кач.ЦенСтарых > 0 Тогда
            Кач.Статус = "ЗАСТАРІЛІ ЦІНИ";
            Кач.Рекомендация = "Оновити/перевірити закупівельні ціни " + Строка(Кач.ЦенСтарых) + " матеріалів.";
            UX42_ДобавитьСовет(Рекомендации, 2, Кат, Кач.Статус, Кач.Рекомендация);
        ИначеЕсли Кат.Проблема = "НЕМАЄ ЦІНИ ПРОДАЖУ"
            ИЛИ Кат.Проблема = "НЕ ВИЗНАЧЕНО ВАГУ"
            ИЛИ Кат.Проблема = "ПЕРЕВІРИТИ ЦІНУ ПРОДАЖУ" Тогда
            Кач.Статус = "НЕПЕРЕВІРЕНИЙ ПРОДАЖ";
            Кач.Рекомендация = "Перевірити розхідну, ПДВ та вагу нетто упаковки.";
            UX42_ДобавитьСовет(Рекомендации, 2, Кат, Кат.Проблема, Кач.Рекомендация);
        Иначе
            Кач.Статус = "ТЕХНІЧНО ПОВНІ ДАНІ";
            Кач.Рекомендация = "Перевірені на повноту/свіжість; це НЕ підтвердження фактичної собівартості.";
        КонецЕсли;
        Если Кач.Статус <> "ТЕХНІЧНО ПОВНІ ДАНІ" Тогда
            ВсегоПроблем = ВсегоПроблем + 1;
        КонецЕсли;
        // Збитковість і низька маржа — лише за повних закупівельних цін
        // та без проблем з продажем; у застарілих цін спочатку оновити джерела.
        Если Кат.Материалов > 0 И Кач.ЦенНет = 0 И Кач.ЦенСтарых = 0 Тогда
            Если Кат.Проблема = "ЗБИТКОВА ПОЗИЦІЯ" Тогда
                UX42_ДобавитьСовет(Рекомендации, 1, Кат, "ЗБИТКОВІСТЬ (РОЗРАХУНКОВА)",
                    "Перевірити ціну, знижки та собівартість; змоделювати нову продажну ціну.");
            ИначеЕсли Кат.Проблема = "НИЗЬКА МАРЖА" Тогда
                UX42_ДобавитьСовет(Рекомендации, 3, Кат, "НИЗЬКА МАРЖА",
                    "Відкрити ціновий сценарій і розрахувати рекомендовану ціну.");
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Рекомендации.Сортировать("Приоритет, Продукция");
    ЗначениеВРеквизитФормы(Качество, "UX42_КачествоТаб");
    ЗначениеВРеквизитФормы(Рекомендации, "UX42_РекомендацииТаб");
    ЭтаФорма["UX42_СводКачества"] = "Перевірено рецептур: " + Строка(Качество.Количество())
        + "; є питання до даних: " + Строка(ВсегоПроблем)
        + "; актуальність закупівель: " + Строка(Порог) + " днів.";
    ЭтаФорма["UX42_СводСоветов"] = "Рекомендацій: " + Строка(Рекомендации.Количество())
        + ". Спочатку виправляйте дані, потім переглядайте рентабельність.";
КонецПроцедуры

