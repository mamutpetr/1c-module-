// Умовне оформлення — лише конкретних комірок, не усієї таблиці.
&НаСервере
Процедура UX421_Правило(ПутьТаблицы, КолонкаПроверки, ВидСравнения, Значение, КолонкаОформления, ЦветНадписи, ЦветПодложки)
    Попытка
        Элемент = УсловноеОформление.Элементы.Добавить();
        Элемент.Использование = Ложь;
        Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьТаблицы + "." + КолонкаПроверки);
        Отбор.ВидСравнения = ВидСравнения;
        Отбор.ПравоеЗначение = Значение;
        Отбор.Использование = Истина;
        Поле = Элемент.Поля.Элементы.Добавить();
        Поле.Поле = Новый ПолеКомпоновкиДанных("UX35_" + ПутьТаблицы + "_" + КолонкаОформления);
        Поле.Использование = Истина;
        Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветНадписи);
        Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветПодложки);
        Элемент.Использование = Истина;
    Исключение
        // Навіть без кольорів базова таблиця зберігає всі статуси.
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура UX421_ЦветоваяИндикация()
    Красный = Новый Цвет(164, 42, 57);
    ФонКрасный = Новый Цвет(255, 235, 239);
    Зеленый = Новый Цвет(12, 115, 82);
    ФонЗеленый = Новый Цвет(231, 248, 238);
    Янтарный = Новый Цвет(151, 91, 10);
    ФонЯнтарный = Новый Цвет(255, 245, 220);

    Для Каждого ИмяТаб Из СтрРазделить("UX40_Результаты,UX40_Проблемы,UX40_ТопСигналов", ",") Цикл
        UX421_Правило(ИмяТаб, "Маржа", ВидСравненияКомпоновкиДанных.Меньше, 0,
            "Маржа", Красный, ФонКрасный);
        UX421_Правило(ИмяТаб, "Маржа", ВидСравненияКомпоновкиДанных.Больше, 25,
            "Маржа", Зеленый, ФонЗеленый);
    КонецЦикла;
    UX421_Правило("UX42_КачествоТаб", "ЦенНет", ВидСравненияКомпоновкиДанных.Больше, 0,
        "ЦенНет", Красный, ФонКрасный);
    UX421_Правило("UX42_КачествоТаб", "ЦенСтарых", ВидСравненияКомпоновкиДанных.Больше, 0,
        "ЦенСтарых", Янтарный, ФонЯнтарный);
    UX421_Правило("UX42_Влияние", "ДельтаКг", ВидСравненияКомпоновкиДанных.Больше, 0,
        "ДельтаКг", Красный, ФонКрасный);
    UX421_Правило("UX42_Влияние", "ДельтаКг", ВидСравненияКомпоновкиДанных.Меньше, 0,
        "ДельтаКг", Зеленый, ФонЗеленый);
    UX421_Правило("UX42_СравнениеТаб", "РазницаНаКг", ВидСравненияКомпоновкиДанных.Больше, 0,
        "РазницаНаКг", Красный, ФонКрасный);
    UX421_Правило("UX42_СравнениеТаб", "РазницаНаКг", ВидСравненияКомпоновкиДанных.Меньше, 0,
        "РазницаНаКг", Зеленый, ФонЗеленый);
    UX421_Правило("UX42_РекомендацииТаб", "Приоритет", ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, 2,
        "Приоритет", Красный, ФонКрасный);
КонецПроцедуры

&НаКлиенте
Процедура UX421_ПодсветитьМеню(ИмяСтраницы)
    ИмяКнопки = "UX41_Домой";
    Если ИмяСтраницы = "UX41_СтраницаДерево" Тогда
        ИмяКнопки = "UX41_Рецептуры";
    ИначеЕсли ИмяСтраницы = "UX40_СтраницаОбзор" Тогда
        ИмяКнопки = "UX41_Рентабельность";
    ИначеЕсли ИмяСтраницы = "UX40_СтраницаСценарий" Тогда
        ИмяКнопки = "UX41_Цены";
    ИначеЕсли ИмяСтраницы = "UX40_СтраницаКонтроль" Тогда
        ИмяКнопки = "UX41_Контроль";
    ИначеЕсли ИмяСтраницы = "UX40_СтраницаПоиск" Тогда
        ИмяКнопки = "UX41_Поиск";
    ИначеЕсли ИмяСтраницы = "UX42_СтраницаСырье" Тогда
        ИмяКнопки = "UX42_Сырье";
    ИначеЕсли ИмяСтраницы = "UX42_СтраницаСравнение" Тогда
        ИмяКнопки = "UX42_Сравнение";
    ИначеЕсли ИмяСтраницы = "UX42_СтраницаКачество" Тогда
        ИмяКнопки = "UX42_Качество";
    ИначеЕсли ИмяСтраницы = "UX42_СтраницаСоветы" Тогда
        ИмяКнопки = "UX42_Советы";
    КонецЕсли;
    Если ИмяСтраницы = "NX50_СтраницаПлан" Тогда ИмяКнопки = "NX50_ПланМеню";
    ИначеЕсли ИмяСтраницы = "NX50_СтраницаКонструктор" Тогда ИмяКнопки = "NX50_РецептМеню";
    ИначеЕсли ИмяСтраницы = "NX50_СтраницаПрайс" Тогда ИмяКнопки = "NX50_ПрайсМеню";
    ИначеЕсли ИмяСтраницы = "NX50_СтраницаСклад" Тогда ИмяКнопки = "NX50_СкладМеню";
    ИначеЕсли ИмяСтраницы = "NX50_СтраницаЭнергия" Тогда ИмяКнопки = "NX50_ЭнергияМеню";
    ИначеЕсли ИмяСтраницы = "NX50_СтраницаПомощник" Тогда ИмяКнопки = "NX50_ПомощникМеню";
    КонецЕсли;
    UX421_ВыделитьКнопкуМеню(ИмяКнопки);
КонецПроцедуры

&НаКлиенте
Процедура UX421_ВыделитьКнопкуМеню(ИмяАктивной)
    Для Каждого Код Из СтрРазделить(
        "UX41_Домой,UX41_Рецептуры,UX41_Себестоимость,UX41_Рентабельность,UX41_Цены,UX41_Контроль,UX41_Поиск,UX41_Категории,UX41_История,UX42_Сырье,UX42_Сравнение,UX42_Качество,UX42_Советы,NX50_ПланМеню,NX50_РецептМеню,NX50_ПрайсМеню,NX50_СкладМеню,NX50_ЭнергияМеню,NX50_ПомощникМеню", ",") Цикл
        Кнопка = Элементы.Найти("UX35_Кнопка_" + Код);
        Если Кнопка = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Попытка
            Если Код = ИмяАктивной Тогда
                Кнопка.ЦветФона = Новый Цвет(33, 110, 195);
                Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
            Иначе
                Кнопка.ЦветФона = Новый Цвет(32, 67, 105);
                Кнопка.ЦветТекста = Новый Цвет(234, 243, 254);
            КонецЕсли;
        Исключение
            // У клієнтах BAS, де кольори кнопок не змінюються, навігація працює.
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

// Рецептура для запису завжди та сама, яку користувач обрав у робочому столі.
// Жодних автоматичних записів під час вибору рядка!
&НаКлиенте
Функция UX41_РецептураДляЗаписи()
    Спецификация = ЭтаФорма["UX40_ВыбраннаяСпецификация"];
    Если ЗначениеЗаполнено(Спецификация) Тогда
        Возврат Спецификация;
    КонецЕсли;
    Дерево = Элементы.Найти("ТаблицаРецептур");
    Если Дерево <> Неопределено Тогда
        ТекущиеДанные = Дерево.ТекущиеДанные;
        Если ТекущиеДанные <> Неопределено Тогда
            Возврат ТекущиеДанные.Спецификация;
        КонецЕсли;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

// Навігація — реальна зміна сторінки стандартної керованої форми.
&НаКлиенте
Процедура UX41_ПереключитьРаздел(ИмяСтраницы)
    Страницы = Элементы.Найти("UX40_Разделы");
    Страница = Элементы.Найти(ИмяСтраницы);
    Если Страницы <> Неопределено И Страница <> Неопределено Тогда
        Страницы.ТекущаяСтраница = Страница;
        UX421_ПодсветитьМеню(ИмяСтраницы);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура UX41_ГлавнаяКоманда(Команда)
    UX41_ПереключитьРаздел("UX40_СтраницаРецептуры");
КонецПроцедуры

