    Элементы.Найти("UX40_НижниеВкладки").ТекущаяСтраница = Элементы.Найти("UX40_СтраницаИстория");
    UX421_ВыделитьКнопкуМеню("UX41_История");
КонецПроцедуры

&НаКлиенте
Процедура UX41_ИскатьНаГлавнойКоманда(Команда)
    UX40_ПрименитьПоискНаСервере();
КонецПроцедуры

&НаСервере
Функция UX40_Страница(Родитель, Имя, Заголовок)
    Стр = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
    Стр.Вид = ВидГруппыФормы.Страница;
    Стр.Заголовок = Заголовок;
    Стр.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
    Возврат Стр;
КонецФункции

&НаСервере
Процедура UX40_Поле(Родитель, ИмяРеквизита, Заголовок, ТолькоЧтение)
    Поле = Элементы.Добавить("UX40_Поле_" + ИмяРеквизита,
        Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = ИмяРеквизита;
    Поле.Заголовок = Заголовок;
    Поле.ТолькоПросмотр = ТолькоЧтение;
КонецПроцедуры

&НаСервере
Функция UX40_Таблица(Родитель, Имя, Путь, Обработчик = "")
    Таб = Элементы.Добавить(Имя, Тип("ТаблицаФормы"), Родитель);
    Таб.ПутьКДанным = Путь;
    Таб.РастягиватьПоГоризонтали = Истина;
    Таб.РастягиватьПоВертикали = Истина;
    Попытка
        Таб.ТолькоПросмотр = Истина;
        Таб.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
    Исключение
        // Навіть якщо конкретна платформа не вміє ховати панель, таблиця працює.
    КонецПопытки;
    Если НЕ ПустаяСтрока(Обработчик) Тогда
        Таб.УстановитьДействие("ПриАктивизацииСтроки", Обработчик);
    КонецЕсли;
    Возврат Таб;
КонецФункции

&НаСервере
Процедура UX40_КолонкиКаталога(Таб, Путь, Полностью)
    UX35_ПолеКолонки(Таб, Путь, "Название", "Товар / рецептура", Истина);
    UX35_ПолеКолонки(Таб, Путь, "Категория", "Категорія", Полностью);
    UX35_ПолеКолонки(Таб, Путь, "Проблема", "Контроль", Истина);
    UX35_ПолеКолонки(Таб, Путь, "Себестоимость", "С/в кг", Истина);
    UX35_ПолеКолонки(Таб, Путь, "ЦенаПродажи", "Продаж кг", Истина);
    UX35_ПолеКолонки(Таб, Путь, "Маржа", "Маржа %", Истина);
    UX35_ПолеКолонки(Таб, Путь, "Наценка", "Націнка %", Ложь);
    UX35_ПолеКолонки(Таб, Путь, "Материалов", "Мат.", Ложь);
    UX35_ПолеКолонки(Таб, Путь, "ЦенНайдено", "Цін", Ложь);
    UX35_ПолеКолонки(Таб, Путь, "Спецификация", "Специфікація", Ложь);
    UX35_ПолеКолонки(Таб, Путь, "Активна", "Активна", Ложь);
КонецПроцедуры

&НаСервере
Процедура UX40_УсловноеОформление()
    // Кольори — тільки в таблицях списків; статуси зберігаються як текст.
    Для Каждого ИмяТаблицы Из СтрРазделить("UX40_Результаты,UX40_Проблемы,UX40_ТопСигналов", ",") Цикл
        Оформление = УсловноеОформление.Элементы.Добавить();
        Условие = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".Проблема");
        Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
        Условие.ПравоеЗначение = "OK";
        Условие.Использование = Истина;
        Кол = Оформление.Поля.Элементы.Добавить();
        Кол.Поле = Новый ПолеКомпоновкиДанных("UX35_" + ИмяТаблицы + "_Проблема");
        Кол.Использование = Истина;
        Оформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(177, 45, 38));
        Оформление.Использование = Истина;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура UX35_ПолеКолонки(ТаблицаФормы, Путь, ИмяКолонки, Заголовок, Видна)
    Поле = Элементы.Добавить("UX35_" + Путь + "_" + ИмяКолонки,
        Тип("ПолеФормы"), ТаблицаФормы);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = Путь + "." + ИмяКолонки;
    Поле.Заголовок = Заголовок;
    Поле.Видимость = Видна;
    Поле.ТолькоПросмотр = Истина;
КонецПроцедуры

&НаСервере
Процедура UX35_Кнопка(Родитель, Имя, Заголовок, Обработчик)
    ИмяКоманды = "UX35_Команда_" + Имя;
    Команда = Команды.Добавить(ИмяКоманды);
    Команда.Заголовок = Заголовок;
    Команда.Действие = Обработчик;
    Кнопка = Элементы.Добавить("UX35_Кнопка_" + Имя,
        Тип("КнопкаФормы"), Родитель);
    Кнопка.ИмяКоманды = ИмяКоманды;
КонецПроцедуры

&НаСервере
Процедура UX35_Подпись(Родитель, Имя, Текст)
    Поле = Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Родитель);
    Поле.Вид = ВидДекорацииФормы.Надпись;
    Поле.Заголовок = Текст;
КонецПроцедуры

