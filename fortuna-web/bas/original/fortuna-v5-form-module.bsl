КонецПроцедуры
&НаКлиенте
Процедура NX50_ВзятьВыбраннуюКоманда(Команда)
    ЭтаФорма["NX50_СпецификацияПлана"] = ЭтаФорма["UX40_ВыбраннаяСпецификация"];
КонецПроцедуры
&НаКлиенте
Процедура NX50_УдалитьПланКоманда(Команда)
    Текущая = Элементы.Найти("NX50_ТабПлана").ТекущиеДанные;
    Если Текущая = Неопределено Тогда Сообщить("Виберіть рядок плану."); Возврат; КонецЕсли;
    NX50_УдалитьПланНаСервере(Текущая.Спецификация,Текущая.Кг);
КонецПроцедуры
&НаСервере
Процедура NX50_УдалитьПланНаСервере(Спецификация,Кг)
    Таб = РеквизитФормыВЗначение("NX50_План");
    Для Индекс = 0 По Таб.Количество()-1 Цикл
        Если Таб[Индекс].Спецификация = Спецификация И Таб[Индекс].Кг = Кг Тогда
            Таб.Удалить(Индекс);
            Прервать;
        КонецЕсли;
    КонецЦикла;
    ЗначениеВРеквизитФормы(Таб,"NX50_План");
    NX50_ПересчитатьПланНаСервере();
КонецПроцедуры
&НаКлиенте
Процедура NX50_ПересчитатьПланКоманда(Команда)
    NX50_ПересчитатьПланНаСервере();
КонецПроцедуры
&НаКлиенте
Процедура NX50_ИзПотребностиКоманда(Команда)
    Д = Элементы.Найти("NX50_ТабПотребности").ТекущиеДанные;
    Если Д = Неопределено Тогда Сообщить("Відкрийте план виробництва та виберіть матеріал у потребі."); Возврат; КонецЕсли;
    NX50_ЗапомнитьМатериал(Д.Материал,Д.Характеристика);
    NX50_ОткрытьСтраницу("NX50_СтраницаСклад");
КонецПроцедуры
&НаСервере
Процедура NX50_ЗапомнитьМатериал(Материал, Характеристика)
    // Сценарна вибрана пара матеріал/характеристика передається через окремі поля.
    ЭтаФорма["NX50_НовыйМатериал"] = Материал;
    ЭтаФорма["NX50_НоваяХарактеристика"] = Характеристика;
КонецПроцедуры
&НаКлиенте
Процедура NX50_ЗадатьОстатокКоманда(Команда)
