&НаСервере
Процедура NX50_СоздатьРеквизиты()
    ПараметрыРеквизитов = Новый Массив;
    Текст = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000));
    Число = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 4));
    Спец = Новый ОписаниеТипов("СправочникСсылка.Спецификации");
    Номенк = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
    Хар = Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры");
    Для Каждого Имя Из СтрРазделить("NX50_План,NX50_Потребность,NX50_Склад,NX50_Конструктор,NX50_Прайс", ",") Цикл
        ПараметрыРеквизитов.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("ТаблицаЗначений")));
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("NX50_ИтогПлана,NX50_ИтогСклада,NX50_ИтогРецепта,NX50_ИтогПрайса,NX50_ИтогЭнергии,NX50_Вопрос,NX50_Ответ", ",") Цикл
        ПараметрыРеквизитов.Добавить(Новый РеквизитФормы(Имя, Текст));
    КонецЦикла;
    ПараметрыРеквизитов.Добавить(Новый РеквизитФормы("NX50_СпецификацияПлана", Спец));
    ПараметрыРеквизитов.Добавить(Новый РеквизитФормы("NX50_СпецификацияКонструктора", Спец));
    ПараметрыРеквизитов.Добавить(Новый РеквизитФормы("NX50_НовыйМатериал", Номенк));
    ПараметрыРеквизитов.Добавить(Новый РеквизитФормы("NX50_НоваяХарактеристика", Хар));
    Для Каждого Имя Из СтрРазделить("NX50_КгПлана,NX50_НоваяКоличество,NX50_ОстатокВвод,NX50_МаржаПрайса,NX50_ШагЦены,NX50_ЭнергияКВтЧТ,NX50_ТарифА,NX50_ТарифБ,NX50_ЭнергияОбъемКг", ",") Цикл
        ПараметрыРеквизитов.Добавить(Новый РеквизитФормы(Имя, Число));
    КонецЦикла;
    ИзменитьРеквизиты(ПараметрыРеквизитов);

    НовыеКолонки = Новый Массив;
    NX50_КолонкаРеквизит(НовыеКолонки,"NX50_План","Спецификация",Спец);
    NX50_КолонкаРеквизит(НовыеКолонки,"NX50_План","Кг",Число);
    Для Каждого Название Из СтрРазделить("NX50_Потребность,NX50_Склад", ",") Цикл
        NX50_КолонкаРеквизит(НовыеКолонки,Название,"Материал",Номенк);
        NX50_КолонкаРеквизит(НовыеКолонки,Название,"Характеристика",Хар);
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("Потребность,Цена,Сумма,Остаток,Дефицит", ",") Цикл
        NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Потребность",Имя,Число);
    КонецЦикла;
    NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Потребность","Статус",Текст);
    NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Склад","Остаток",Число);
    NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Конструктор","Материал",Номенк);
    NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Конструктор","Характеристика",Хар);
    Для Каждого Имя Из СтрРазделить("Количество,Цена,Сумма", ",") Цикл
        NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Конструктор",Имя,Число);
    КонецЦикла;
    NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Конструктор","Статус",Текст);
    NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Прайс","Спецификация",Спец);
    Для Каждого Имя Из СтрРазделить("Продукция,Канал,Статус", ",") Цикл
        NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Прайс",Имя,Текст);
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("Себестоимость,ЦенаТекущая,ЦенаРеком,Разница", ",") Цикл
        NX50_КолонкаРеквизит(НовыеКолонки,"NX50_Прайс",Имя,Число);
    КонецЦикла;
    ИзменитьРеквизиты(НовыеКолонки);
    Для Каждого Имя Из СтрРазделить("NX50_План,NX50_Потребность,NX50_Склад,NX50_Конструктор,NX50_Прайс", ",") Цикл
        ЗначениеВРеквизитФормы(NX50_НоваяТаблица(Имя), Имя);
    КонецЦикла;
    ЭтаФорма["NX50_КгПлана"] = 1000;
    ЭтаФорма["NX50_НоваяКоличество"] = 1;
    ЭтаФорма["NX50_МаржаПрайса"] = 25;
    ЭтаФорма["NX50_ШагЦены"] = 0.05;
    ЭтаФорма["NX50_ЭнергияКВтЧТ"] = 250;
    ЭтаФорма["NX50_ТарифА"] = 4;
    ЭтаФорма["NX50_ТарифБ"] = 8;
    ЭтаФорма["NX50_ЭнергияОбъемКг"] = 1000;
    ЭтаФорма["NX50_ИтогПлана"] = "Дані не завантажені. Натисніть «Оновити» у шапці.";
    ЭтаФорма["NX50_ИтогСклада"] = "Склад — ручний сценарій, НЕ фактичні залишки BAS.";
    ЭтаФорма["NX50_ИтогРецепта"] = "Сценарій рецепта не змінює Спецификации.";
    ЭтаФорма["NX50_ИтогПрайса"] = "Прайс лише для перегляду; без запису цін у BAS.";
    ЭтаФорма["NX50_ИтогЭнергии"] = "Енергія — окремий сценарій, не додавати повторно до переробки 50 000 грн/т.";
    ЭтаФорма["NX50_Вопрос"] = "Скільки рецептів?";
    ЭтаФорма["NX50_Ответ"] = "Локальний помічник на правилах. Не під'єднаний до AI API.";
КонецПроцедуры

&НаСервере
Процедура NX50_КолонкаРеквизит(Добавляемые, Таблица, Колонка, Описание)
    UX35_ДобавитьКолонку(Добавляемые, Таблица, Колонка, Описание);
КонецПроцедуры

&НаСервере
Функция NX50_НоваяТаблица(Имя)
    Таб = Новый ТаблицаЗначений;
    Ч = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,4));
    Т = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000));
    С = Новый ОписаниеТипов("СправочникСсылка.Спецификации");
    М = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
    Х = Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры");
    Если Имя = "NX50_План" Тогда
        Таб.Колонки.Добавить("Спецификация",С);
        Таб.Колонки.Добавить("Кг",Ч);
    ИначеЕсли Имя = "NX50_Потребность" Тогда
        Таб.Колонки.Добавить("Материал",М);
        Таб.Колонки.Добавить("Характеристика",Х);
        Для Каждого Поле Из СтрРазделить("Потребность,Цена,Сумма,Остаток,Дефицит", ",") Цикл
            Таб.Колонки.Добавить(Поле,Ч);
        КонецЦикла;
        Таб.Колонки.Добавить("Статус",Т);
    ИначеЕсли Имя = "NX50_Склад" Тогда
        Таб.Колонки.Добавить("Материал",М);
        Таб.Колонки.Добавить("Характеристика",Х);
        Таб.Колонки.Добавить("Остаток",Ч);
    ИначеЕсли Имя = "NX50_Конструктор" Тогда
        Таб.Колонки.Добавить("Материал",М);
        Таб.Колонки.Добавить("Характеристика",Х);
        Для Каждого Поле Из СтрРазделить("Количество,Цена,Сумма", ",") Цикл
            Таб.Колонки.Добавить(Поле,Ч);
        КонецЦикла;
        Таб.Колонки.Добавить("Статус",Т);
    ИначеЕсли Имя = "NX50_Прайс" Тогда
        Таб.Колонки.Добавить("Спецификация",С);
        Для Каждого Поле Из СтрРазделить("Продукция,Канал,Статус", ",") Цикл
            Таб.Колонки.Добавить(Поле,Т);
        КонецЦикла;
        Для Каждого Поле Из СтрРазделить("Себестоимость,ЦенаТекущая,ЦенаРеком,Разница", ",") Цикл
            Таб.Колонки.Добавить(Поле,Ч);
        КонецЦикла;
    КонецЕсли;
    Возврат Таб;
КонецФункции

&НаСервере
Процедура NX50_СоздатьРазделы(Разделы)
    // Розділи не використовують сторонні UI-компоненти.
    ПланСтраница = UX40_Страница(Разделы,"NX50_СтраницаПлан","План виробництва");
    UX41_Надпись(ПланСтраница,"NX50_ЗагПлана","ПЛАН ВИРОБНИЦТВА / ПОТРЕБА В МАТЕРІАЛАХ","Подзаголовок");
    UX41_Надпись(ПланСтраница,"NX50_ТекстПлана","Рецептури на 1000 кг. Вводьте планові кілограми готової продукції; все лише в пам'яті форми.","Тихий");
    КомПлана = UX35_Группа("NX50_КомПлана",ПланСтраница,Истина);
    UX40_Поле(КомПлана,"NX50_СпецификацияПлана","Рецептура",Ложь);
    UX40_Поле(КомПлана,"NX50_КгПлана","Партія, кг",Ложь);
    UX35_Кнопка(КомПлана,"NX50_ДобавитьПлан","+ До плану","NX50_ДобавитьПланКоманда");
