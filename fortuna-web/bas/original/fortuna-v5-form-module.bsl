    Элементы.Найти("UX40_НижниеВкладки").ТекущаяСтраница = Элементы.Найти("UX40_СтраницаСостав");
    UX421_ВыделитьКнопкуМеню("UX41_Себестоимость");
КонецПроцедуры

&НаКлиенте
