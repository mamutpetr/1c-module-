    Каналы = UX40_Таблица(Обзор, "UX40_Каналы", "UX40_Каналы");
    UX35_ПолеКолонки(Каналы, "UX40_Каналы", "Канал", "Канал збуту", Истина);
    UX35_ПолеКолонки(Каналы, "UX40_Каналы", "Количество", "Рецептур", Истина);
    UX35_ПолеКолонки(Каналы, "UX40_Каналы", "Проблем", "Проблем", Истина);
    UX35_ПолеКолонки(Каналы, "UX40_Каналы", "СредняяМаржа", "Маржа %", Истина);

    // ====================== ПОШУК ====================
    Поиск = UX40_Страница(Разделы, "UX40_СтраницаПоиск", "Пошук");
    ГруппаПараметровПоиска = UX35_Группа("UX40_ПараметрыПоиска", Поиск, Истина);
    UX40_Поле(ГруппаПараметровПоиска, "UX40_СтрокаПоиска", "Назва / товар", Ложь);
    UX35_Кнопка(ГруппаПараметровПоиска, "Искать40", "Знайти", "UX40_НайтиКоманда");
    UX35_Кнопка(ГруппаПараметровПоиска, "Сброс40", "Очистити", "UX40_ОчиститьПоискКоманда");
    ГотовыеФильтры = UX35_Группа("UX40_ГотовыеФильтры", Поиск, Истина);
    UX35_Кнопка(ГотовыеФильтры, "ВсеРез40", "Всі", "UX40_ФильтрВсеКоманда");
    UX35_Кнопка(ГотовыеФильтры, "АктивРез40", "Активні", "UX40_ФильтрАктивныеКоманда");
    UX35_Кнопка(ГотовыеФильтры, "БезКатРез40", "Без категорії", "UX40_ФильтрБезКатегорииКоманда");
    UX35_Кнопка(ГотовыеФильтры, "ПроблемРез40", "Проблемні", "UX40_ФильтрПроблемныеКоманда");
    UX35_Кнопка(ГотовыеФильтры, "НизМаржа40", "Низька маржа", "UX40_ФильтрМаржаКоманда");
    UX41_ПолеПовтор("UX41_ПодписьПоиска", Поиск, "UX40_ПодписьРезультатов", "Знайдено", Истина);
    UX41_Надпись(Поиск, "UX41_ПоискПояснение", "Результати пошуку показуються на Головній. Фільтри застосовуються до тих самих даних.", "Тихий");
    UX35_Кнопка(Поиск, "UX41_ВернутьсяКСписку", "← На головну", "UX41_ГлавнаяКоманда");

    // ====================== КОНТРОЛЬ ====================
    Контроль = UX40_Страница(Разделы, "UX40_СтраницаКонтроль", "Контроль");
    Критерии = UX35_Группа("UX40_Критерии", Контроль, Истина);
    UX40_Поле(Критерии, "UX40_ПорогМаржи", "Поріг маржі (%)", Ложь);
    UX35_Кнопка(Критерии, "Контроль40", "Перевірити", "UX40_ПересчитатьКонтрольКоманда");
    UX41_Надпись(Контроль, "UX41_КонтрольПодпись", "Збиткові, неповні калькуляції, відсутні продажі, низька маржа", "Тихий");
    Проблемы = UX40_Таблица(Контроль, "UX40_Проблемы", "UX40_Проблемы", "UX40_ПроблемыПриАктивизацииСтроки");
    UX40_КолонкиКаталога(Проблемы, "UX40_Проблемы", Истина);
    UX35_Кнопка(Контроль, "UX41_СКонтроляДомой", "← На головну", "UX41_ГлавнаяКоманда");

    // ====================== ЦІНОВИЙ СЦЕНАРІЙ ====================
    Симулятор = UX40_Страница(Разделы, "UX40_СтраницаСценарий", "Сценарій");
    UX41_Надпись(Симулятор, "UX41_СценПодсказка", "Без запису в BAS  •  ціну розраховуємо тільки за повної собівартості", "Тихий");
    UX40_Поле(Симулятор, "UX40_ВыбраннаяСпецификация", "Рецептура", Истина);
    UX40_Поле(Симулятор, "UX40_БазоваяСебестоимость", "Собівартість, грн/кг", Истина);
    UX40_Поле(Симулятор, "UX40_БазоваяПродажа", "Продаж, грн/кг", Истина);
    UX40_Поле(Симулятор, "UX40_ЦелеваяМаржа", "Цільова маржа, %", Ложь);
    UX40_Поле(Симулятор, "UX40_ДопЗатраты", "Додаткові витрати, грн/кг", Ложь);
    UX40_Поле(Симулятор, "UX40_ОбъемКг", "Обсяг виробництва, кг", Ложь);
    UX35_Кнопка(Симулятор, "Расчет40", "Розрахувати рекомендовану ціну", "UX40_РассчитатьСценарийКоманда");
    UX40_Поле(Симулятор, "UX40_РекомендованнаяЦена", "Рекомендована ціна, грн/кг", Истина);
    UX40_Поле(Симулятор, "UX40_ИтогСценария", "Економіка сценарію", Истина);

    UX42_СоздатьРазделы(Разделы);
    NX50_СоздатьРазделы(Разделы);
    UX41_Надпись(РабочаяОбласть, "UX41_Подвал", "ФОРТУНА 5.0  •  Розрахунки на основі даних BAS  •  грн/кг без ПДВ", "Тихий");

    // UX 4.2.1: нова тема оформлення — тільки візуальні властивості.
    // Будь-яка відсутня властивість у конкретній BAS пропускається.
    UX421_ОформитьРабочееМесто();
    Попытка
        UX40_УсловноеОформление();
    Исключение
        // Умовне оформлення не повинно блокувати відкриття форми.
    КонецПопытки;
    UX421_ЦветоваяИндикация();
    NX50_ЦветоваяИндикация();
    // За замовчуванням відкриваємо робочий стіл.
    Разделы.ТекущаяСтраница = Главная;
    Сообщить("ФОРТУНА 5.0: інтерфейс готовий. Натисніть «Оновити дані».");
КонецПроцедуры

// Допоміжні елементи оформлення. Не використовуємо заборонених властивостей форми.
&НаСервере
Процедура UX41_Надпись(Родитель, Имя, Текст, Стиль = "Тихий")
    Надпись = Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Родитель);
    Надпись.Вид = ВидДекорацииФормы.Надпись;
    Надпись.Заголовок = Текст;
    // Усі властивості дизайну необов'язкові для запуску BAS.
    Попытка
        Если Стиль = "Бренд" Тогда
            Надпись.Шрифт = Новый Шрифт("Arial", 19, Истина);
            Надпись.ЦветТекста = Новый Цвет(242, 248, 255);
        ИначеЕсли Стиль = "Заголовок" Тогда
            Надпись.Шрифт = Новый Шрифт("Arial", 14, Истина);
            Надпись.ЦветТекста = Новый Цвет(20, 48, 80);
        ИначеЕсли Стиль = "Подзаголовок" Тогда
            Надпись.Шрифт = Новый Шрифт("Arial", 11, Истина);
            Надпись.ЦветТекста = Новый Цвет(23, 88, 143);
        ИначеЕсли Стиль = "МенюПодпись" Тогда
            Надпись.Шрифт = Новый Шрифт("Arial", 9);
            Надпись.ЦветТекста = Новый Цвет(176, 203, 235);
        Иначе
            Надпись.Шрифт = Новый Шрифт("Arial", 9);
            Надпись.ЦветТекста = Новый Цвет(107, 124, 145);
        КонецЕсли;
    Исключение
        // Веб/тонкий клієнт можуть не підтримувати частину властивостей.
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура UX41_ПолеПовтор(ИмяЭлемента, Родитель, ИмяРеквизита, Заголовок, ТолькоЧтение)
    Поле = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = ИмяРеквизита;
    Поле.Заголовок = Заголовок;
    Поле.ТолькоПросмотр = ТолькоЧтение;
КонецПроцедуры

&НаСервере
Процедура UX41_ПолеКПИ(Родитель, ИмяРеквизита, Заголовок)
    // П'ять кольорових карток: колір відповідає бізнес-змісту.
    Карточка = UX35_Группа("UX411_Карточка_" + ИмяРеквизита, Родитель);
    UX41_ШиринаГруппы(Карточка, 18);

    ЦветАкцента = Новый Цвет(33, 99, 169);
    ЦветПодложки = Новый Цвет(237, 245, 254);
    Если ИмяРеквизита = "UX40_КПИАктивных" Тогда
        ЦветАкцента = Новый Цвет(19, 126, 93);
        ЦветПодложки = Новый Цвет(234, 249, 242);
    ИначеЕсли ИмяРеквизита = "UX40_КПИПроблем" Тогда
        ЦветАкцента = Новый Цвет(180, 45, 62);
        ЦветПодложки = Новый Цвет(255, 240, 242);
    ИначеЕсли ИмяРеквизита = "UX40_КПИБезЦен" Тогда
        ЦветАкцента = Новый Цвет(168, 106, 16);
        ЦветПодложки = Новый Цвет(255, 248, 231);
    ИначеЕсли ИмяРеквизита = "UX40_КПИСредняяМаржа" Тогда
        ЦветАкцента = Новый Цвет(93, 74, 168);
        ЦветПодложки = Новый Цвет(245, 241, 255);
    КонецЕсли;

    Попытка
        Карточка.ЦветФона = ЦветПодложки;
    Исключение
    КонецПопытки;
    UX41_Надпись(Карточка, "UX411_Название_" + ИмяРеквизита, Заголовок, "Тихий");
    Попытка
        Элементы.Найти("UX411_Название_" + ИмяРеквизита).ЦветТекста = ЦветАкцента;
    Исключение
    КонецПопытки;
    ИмяПоля = "UX41_KPI_" + ИмяРеквизита;
    UX41_ПолеПовтор(ИмяПоля, Карточка, ИмяРеквизита, "", Истина);
    Попытка
        Поле = Элементы.Найти(ИмяПоля);
        Поле.Вид = ВидПоляФормы.ПолеНадписи;
        Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
        Поле.Шрифт = Новый Шрифт("Arial", 17, Истина);
        Поле.ЦветТекста = ЦветАкцента;
    Исключение
        // Навіть без підтримки кольору KPI відображає справжнє число.
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура UX41_РазмерТаблицы(ТаблицаФормы, КоличествоСтрок)
    Попытка
        ТаблицаФормы.ВысотаВСтроках = КоличествоСтрок;
    Исключение
        UX41_ПропускОформления = ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура UX41_СтильГруппы(Группа, Стиль)
    Попытка
        Если Стиль = "Меню" Тогда
            Группа.ЦветФона = Новый Цвет(17, 41, 71);
        ИначеЕсли Стиль = "Шапка" Тогда
            Группа.ЦветФона = Новый Цвет(228, 238, 252);
        ИначеЕсли Стиль = "Карточки" Тогда
            Группа.ЦветФона = Новый Цвет(247, 250, 254);
        ИначеЕсли Стиль = "Фон" Тогда
            Группа.ЦветФона = Новый Цвет(247, 249, 253);
        КонецЕсли;
    Исключение
        // Частина клієнтів BAS ігнорує стилізацію груп.
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура UX41_ШиринаГруппы(Группа, Ширина)
    // Підказка для компонувальника, не обов'язкова для працездатності.
    Попытка
        Группа.АвтоШирина = Ложь;
        Группа.Ширина = Ширина;
    Исключение
        UX41_ПропускОформления = ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

// Примусово горизонтально. На BAS 8.3 це прибирає баг з переносом
// цілої робочої частини під ліву навігацію.
&НаСервере
Процедура UX411_ФиксированныйРяд(Группа)
    Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
КонецПроцедуры

&НаСервере
Процедура UX411_РастянутьГруппу(Группа)
    Попытка
        Группа.РастягиватьПоГоризонтали = Истина;
    Исключение
        // Відмінності оформлення різних версій BAS.
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура UX411_ШиринаПоля(Имя, Ширина)
    Поле = Элементы.Найти(Имя);
    Если Поле = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        Поле.АвтоШирина = Ложь;
        Поле.Ширина = Ширина;
    Исключение
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура UX411_ШиринаКолонки(ИмяТаблицы, ИмяКолонки, Ширина)
    UX411_ШиринаПоля("UX35_" + ИмяТаблицы + "_" + ИмяКолонки, Ширина);
КонецПроцедуры

&НаСервере
Процедура UX411_РазмерКолонокКаталога(ИмяТаблицы)
    UX411_ШиринаКолонки(ИмяТаблицы, "Название", 32);
    UX411_ШиринаКолонки(ИмяТаблицы, "Категория", 16);
    UX411_ШиринаКолонки(ИмяТаблицы, "Проблема", 20);
    UX411_ШиринаКолонки(ИмяТаблицы, "Себестоимость", 11);
    UX411_ШиринаКолонки(ИмяТаблицы, "ЦенаПродажи", 11);
    UX411_ШиринаКолонки(ИмяТаблицы, "Маржа", 9);
КонецПроцедуры

&НаСервере
Процедура UX411_РазмерКолонокМатериалов()
    UX411_ШиринаКолонки("ТаблицаКалькуляции", "Материал", 28);
    UX411_ШиринаКолонки("ТаблицаКалькуляции", "Количество", 11);
    UX411_ШиринаКолонки("ТаблицаКалькуляции", "Единица", 5);
    UX411_ШиринаКолонки("ТаблицаКалькуляции", "ЦенаБезНДС", 12);
    UX411_ШиринаКолонки("ТаблицаКалькуляции", "Сумма", 13);
    UX411_ШиринаКолонки("ТаблицаКалькуляции", "ДатаЦены", 11);
    UX411_ШиринаКолонки("ТаблицаКалькуляции", "Статус", 19);
КонецПроцедуры

&НаСервере
Процедура UX41_СтильКнопки(Имя, Стиль)
    Кнопка = Элементы.Найти("UX35_Кнопка_" + Имя);
    Если Кнопка = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        Если Стиль = "Меню" Тогда
            Кнопка.ЦветФона = Новый Цвет(32, 67, 105);
            Кнопка.ЦветТекста = Новый Цвет(234, 243, 254);
        ИначеЕсли Стиль = "Активная" Тогда
            Кнопка.ЦветФона = Новый Цвет(33, 110, 195);
            Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
        ИначеЕсли Стиль = "Важная" Тогда
            Кнопка.ЦветФона = Новый Цвет(17, 128, 103);
            Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
        ИначеЕсли Стиль = "Предупреждение" Тогда
            Кнопка.ЦветФона = Новый Цвет(247, 232, 208);
            Кнопка.ЦветТекста = Новый Цвет(135, 85, 27);
        Иначе
            Кнопка.ЦветФона = Новый Цвет(38, 111, 199);
            Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
        КонецЕсли;
    Исключение
        // Колір кнопки не є обов'язковим для роботи команд.
    КонецПопытки;
КонецПроцедуры

// ============================================================================
// ФОРТУНА 4.2.1 — ВІЗУАЛЬНА ТЕМА / кольори, типографіка, підсвітка.
// Немає запитів/транзакцій/записів. Кольори — додаткове оформлення.
// ============================================================================
&НаСервере
Процедура UX421_ОкраситьИтогМаржи(СуммаМаржи, Количество)
    // Динамічна семантика: якщо середня маржа від'ємна, цифра червона.
    Если Количество <= 0 Тогда
        Возврат;
    КонецЕсли;
    ЦветАкцента = ?(СуммаМаржи < 0,
        Новый Цвет(180, 45, 62), Новый Цвет(12, 115, 82));
    ФонАкцента = ?(СуммаМаржи < 0,
        Новый Цвет(255, 240, 242), Новый Цвет(234, 249, 242));
    UX421_Фон("UX411_Карточка_UX40_КПИСредняяМаржа", ФонАкцента);
    UX421_Текст("UX41_KPI_UX40_КПИСредняяМаржа", ЦветАкцента);
    UX421_Текст("UX411_Название_UX40_КПИСредняяМаржа", ЦветАкцента);
КонецПроцедуры

&НаСервере
Процедура UX421_Фон(ИмяЭлемента, ЦветПодложки)
    Элемент = Элементы.Найти(ИмяЭлемента);
    Если Элемент = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        Элемент.ЦветФона = ЦветПодложки;
    Исключение
        // Залежить від типу елемента та клієнта BAS.
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура UX421_Текст(ИмяЭлемента, ЦветТекста, Жирный = Ложь)
    Элемент = Элементы.Найти(ИмяЭлемента);
    Если Элемент = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        Элемент.ЦветТекста = ЦветТекста;
    Исключение
    КонецПопытки;
    Если Жирный Тогда
        Попытка
            Элемент.Шрифт = Новый Шрифт("Arial", 11, Истина);
        Исключение
        КонецПопытки;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура UX421_ОформитьРабочееМесто()
    // Контрастні, але не агресивні фони — стандартні RGB.
    UX421_Фон("UX41_Меню", Новый Цвет(17, 41, 71));
    UX421_Фон("UX41_Шапка", Новый Цвет(228, 238, 252));
    UX421_Фон("UX40_ПанельПоказателей", Новый Цвет(248, 250, 254));
    UX421_Фон("UX41_РецептыБлок", Новый Цвет(255, 255, 255));
    UX421_Фон("UX41_СигналыБлок", Новый Цвет(255, 246, 245));
    UX421_Фон("UX41_Детали", Новый Цвет(255, 255, 255));
    UX421_Фон("UX41_СценарийБлок", Новый Цвет(240, 248, 252));
