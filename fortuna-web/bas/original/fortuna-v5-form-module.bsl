// ============================================================================
// РЕЖИМИ ВІДОБРАЖЕННЯ ДВОХ ТАБЛИЦЬ (v3.1)
//
// Команди форми -> Действие (імена процедур точно як нижче):
//   РазвернутьРецептуры    -> РазвернутьРецептуры
//   РазвернутьКалькуляцию  -> РазвернутьКалькуляцию
//   ПоказатьВсе            -> ПоказатьВсе
//
// Приховуємо ТІЛЬКИ елементи форми. Реквізити таблиць та дані не змінюємо.
// Це розгортання на вільну робочу область ФОРМИ, а не вікно Windows.
// Щоб залишена таблиця займала доступну висоту, на формі встановіть
// для обох таблиць РастягиватьПоВертикали = Да та приберіть фіксовану висоту.
// ============================================================================

&НаКлиенте
Процедура РазвернутьРецептуры(Команда)

    // Лише дерево рецептів; детальна калькуляція не видаляється.
    Элементы.Найти("ТаблицаРецептур").Видимость = Истина;
    Элементы.Найти("ТаблицаКалькуляции").Видимость = Ложь;

КонецПроцедуры


&НаКлиенте
Процедура РазвернутьКалькуляцию(Команда)

    // Лише детальна калькуляція поточної рецептури.
    Элементы.Найти("ТаблицаРецептур").Видимость = Ложь;
    Элементы.Найти("ТаблицаКалькуляции").Видимость = Истина;

КонецПроцедуры


&НаКлиенте
Процедура ПоказатьВсе(Команда)

    // Звичайний режим: обидві таблиці одночасно.
    Элементы.Найти("ТаблицаРецептур").Видимость = Истина;
    Элементы.Найти("ТаблицаКалькуляции").Видимость = Истина;

КонецПроцедуры


// v3.2. Відкрити другу форму цього самого зовнішнього EPF.
&НаКлиенте
Процедура ОткрытьЖурналИзмененийКоманда(Команда)

    Попытка
        ПолноеИмяФормыИстории = ПолучитьИмяФормыИсторииНаСервере();
        Если ПустаяСтрока(ПолноеИмяФормыИстории) Тогда
            Сообщить("ФормаИстории відсутня в цій EPF. Основна калькуляція працює без журналу.");
            Возврат;
        КонецЕсли;
        ПараметрыИстории = Новый Структура;
        ТекущаяСтрока = Элементы.Найти("ТаблицаРецептур").ТекущиеДанные;
        Если ТекущаяСтрока <> Неопределено Тогда
            Если ЗначениеЗаполнено(ТекущаяСтрока.Спецификация) Тогда
                ПараметрыИстории.Вставить("ВыбраннаяСпецификация", ТекущаяСтрока.Спецификация);
            КонецЕсли;
        КонецЕсли;
        ОткрытьФорму(ПолноеИмяФормыИстории, ПараметрыИстории, ЭтаФорма);
    Исключение
        Сообщить("ПОМИЛКА ВІДКРИТТЯ ЖУРНАЛУ: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПолучитьИмяФормыИсторииНаСервере()
    Обработка = РеквизитФормыВЗначение("Объект");
    МД = Обработка.Метаданные();
    Если МД.Формы.Найти("ФормаИстории") = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат МД.ПолноеИмя() + ".Форма.ФормаИстории";
КонецФункции

#КонецОбласти


#Область ЗагрузкаГлавнойТаблицы

&НаСервере
Функция ЗагрузитьВсеНаСервере(ЗапомнитьСнимок = Ложь)

    Попытка

        // Очищаємо існуюче дерево форми напряму.
        ЭтаФорма["ТаблицаРецептур"].ПолучитьЭлементы().Очистить();
        ЭтаФорма["ТаблицаКалькуляции"].Очистить();
        ЭтаФорма["Итоги"] = "";

        Состав = ПолучитьТаблицуСоставаСпецификаций();

        Если Состав.Количество() = 0 Тогда
            Возврат "Рецептури не знайдено.";
        КонецЕсли;

        Сообщить(
            "Склад рецептур завантажено. Рядків: "
            + Строка(Состав.Количество()));

        Цены = ПолучитьПоследниеЦеныЗакупки();

        Сообщить(
            "Закупівельні ціни завантажено. Рядків: "
            + Строка(Цены.Количество()));

        // Шукаємо останню проведену розхідну по кожному товару.
        // Якщо структура метаданих незвична, ціни продажу будуть порожні,
        // але основна калькуляція продовжить працювати.
        ЦеныПродажи = ПолучитьПоследниеЦеныПродаж();

        СтатусыСпецификаций = ПолучитьСтатусыСпецификаций();
        // Спільні призначені гілки з реквізиту довідника Спецификации.
        КатегорииСпецификаций = ПолучитьКатегорииСпецификаций();

        // Спільна історія у РЕГІСТРІ: бачать усі авторизовані бухгалтери.
        // Рух між гілками НЕ є новим знімком.
        История = ЗагрузитьИсториюКалькуляций();

        ИндексПрошлых = Новый Соответствие;
        Для Каждого ПрошлаяСтрока Из История.Текущий Цикл
            ИндексПрошлых.Вставить(ПрошлаяСтрока.Спецификация, ПрошлаяСтрока);
        КонецЦикла;

        ИндексПредыдущих = Новый Соответствие;
        Для Каждого ПрошлаяСтрока Из История.Предыдущий Цикл
            ИндексПредыдущих.Вставить(ПрошлаяСтрока.Спецификация, ПрошлаяСтрока);
        КонецЦикла;

        // ------------------------------------------------------------------
        // ІЄРАРХІЯ КАНАЛІВ ЗБУТУ
        // ------------------------------------------------------------------
        Корень = ЭтаФорма["ТаблицаРецептур"].ПолучитьЭлементы();

        ВеткаНовые = Корень.Добавить();
        ВеткаНовые.Название = "ВИКОРИСТОВУЮТЬСЯ";
        ВеткаНовые.Статус = "ГРУПА";

        ВеткаУкраина = ВеткаНовые.ПолучитьЭлементы().Добавить();
        ВеткаУкраина.Название = "УКРАЇНА";
        ВеткаУкраина.Статус = "ГРУПА";

        ВеткаРудь = ВеткаУкраина.ПолучитьЭлементы().Добавить();
        ВеткаРудь.Название = "Рудь";
        ВеткаРудь.Статус = "ГРУПА";

        ВеткаСильпо = ВеткаУкраина.ПолучитьЭлементы().Добавить();
        ВеткаСильпо.Название = "Сільпо";
        ВеткаСильпо.Статус = "ГРУПА";

        ВеткаМетро = ВеткаУкраина.ПолучитьЭлементы().Добавить();
        ВеткаМетро.Название = "Метро";
        ВеткаМетро.Статус = "ГРУПА";

        ВеткаПриваты = ВеткаУкраина.ПолучитьЭлементы().Добавить();
        ВеткаПриваты.Название = "Привати";
        ВеткаПриваты.Статус = "ГРУПА";

        ВеткаФедик = ВеткаПриваты.ПолучитьЭлементы().Добавить();
        ВеткаФедик.Название = "Федик";
        ВеткаФедик.Статус = "ГРУПА";

        ВеткаОП = ВеткаПриваты.ПолучитьЭлементы().Добавить();
        ВеткаОП.Название = "ОП";
        ВеткаОП.Статус = "ГРУПА";

        ВеткаМидас = ВеткаПриваты.ПолучитьЭлементы().Добавить();
        ВеткаМидас.Название = "Мидас";
        ВеткаМидас.Статус = "ГРУПА";

        ВеткаЭкспорт = ВеткаНовые.ПолучитьЭлементы().Добавить();
        ВеткаЭкспорт.Название = "ЕКСПОРТ";
        ВеткаЭкспорт.Статус = "ГРУПА";

        ВеткаДовгань = ВеткаЭкспорт.ПолучитьЭлементы().Добавить();
        ВеткаДовгань.Название = "Довгань";
        ВеткаДовгань.Статус = "ГРУПА";

        ВеткаИталия = ВеткаЭкспорт.ПолучитьЭлементы().Добавить();
        ВеткаИталия.Название = "Італія";
        ВеткаИталия.Статус = "ГРУПА";

        ВеткаРумыния = ВеткаЭкспорт.ПолучитьЭлементы().Добавить();
        ВеткаРумыния.Название = "Румунія";
        ВеткаРумыния.Статус = "ГРУПА";

        ВеткаГея = ВеткаЭкспорт.ПолучитьЭлементы().Добавить();
        ВеткаГея.Название = "Гея Фуд";
        ВеткаГея.Статус = "ГРУПА";

        ВеткаЧехия = ВеткаЭкспорт.ПолучитьЭлементы().Добавить();
        ВеткаЧехия.Название = "Чехія";
        ВеткаЧехия.Статус = "ГРУПА";

        ВеткаИзраиль = ВеткаЭкспорт.ПолучитьЭлементы().Добавить();
        ВеткаИзраиль.Название = "Ізраїль";
        ВеткаИзраиль.Статус = "ГРУПА";

        // Старі активні рецептури не втрачаємо: вони тут, поки
        // бухгалтер не визначить клієнта або канал збуту.
        ВеткаБезКатегории = ВеткаНовые.ПолучитьЭлементы().Добавить();
        ВеткаБезКатегории.Название = "Без категорії";
        ВеткаБезКатегории.Статус = "ГРУПА";

        ВеткаСтарые = Корень.Добавить();
        ВеткаСтарые.Название = "НЕ ВИКОРИСТОВУЮТЬСЯ";
        ВеткаСтарые.Статус = "ГРУПА";

        // Відображення збереженого коду категорії на створену папку дерева.
        ВеткиКатегорий = Новый Соответствие;
        ВеткиКатегорий.Вставить("UA_RUD", ВеткаРудь);
        ВеткиКатегорий.Вставить("UA_SILPO", ВеткаСильпо);
        ВеткиКатегорий.Вставить("UA_METRO", ВеткаМетро);
        ВеткиКатегорий.Вставить("UA_FEDYK", ВеткаФедик);
        ВеткиКатегорий.Вставить("UA_OP", ВеткаОП);
        ВеткиКатегорий.Вставить("UA_MIDAS", ВеткаМидас);
        ВеткиКатегорий.Вставить("EX_DOVGAN", ВеткаДовгань);
        ВеткиКатегорий.Вставить("EX_ITALY", ВеткаИталия);
        ВеткиКатегорий.Вставить("EX_ROMANIA", ВеткаРумыния);
        ВеткиКатегорий.Вставить("EX_GEYA", ВеткаГея);
        ВеткиКатегорий.Вставить("EX_CZECH", ВеткаЧехия);
        ВеткиКатегорий.Вставить("EX_ISRAEL", ВеткаИзраиль);

        СтрокиПоСпецификациям = Новый Соответствие;
        ВсеСтрокиРецептур = Новый Массив;

        ПерваяСпецификация = Неопределено;
        КоличествоРецептур = 0;
        КоличествоНовых = 0;
        КоличествоСтарых = 0;

        Для Каждого СтрокаСостава Из Состав Цикл

            Если НЕ ЗначениеЗаполнено(СтрокаСостава.Спецификация)
                ИЛИ НЕ ЗначениеЗаполнено(СтрокаСостава.Материал) Тогда
                Продолжить;
            КонецЕсли;

            СтрокаИтога =
                СтрокиПоСпецификациям.Получить(
                    СтрокаСостава.Спецификация);

            Если СтрокаИтога = Неопределено Тогда

                ИмяВетки = ОпределитьВеткуСпецификации(
                    СтрокаСостава.Спецификация,
                    СтатусыСпецификаций);

                Если ИмяВетки = "СТАРІ" Тогда

                    СтрокаИтога =
                        ВеткаСтарые.ПолучитьЭлементы().Добавить();

                    КоличествоСтарых =
                        КоличествоСтарых + 1;

                Иначе

                    // Якщо для активного рецепта є записана категорія,
                    // розміщуємо його у відповідній підгілці.
                    КодКатегории = КатегорииСпецификаций.Получить(
                        СтрокаСостава.Спецификация);

                    НужнаяВетка = Неопределено;
                    Если КодКатегории <> Неопределено Тогда
                        НужнаяВетка = ВеткиКатегорий.Получить(КодКатегории);
                    КонецЕсли;

                    Если НужнаяВетка = Неопределено Тогда
                        НужнаяВетка = ВеткаБезКатегории;
                    КонецЕсли;

                    СтрокаИтога =
                        НужнаяВетка.ПолучитьЭлементы().Добавить();

                    КоличествоНовых =
                        КоличествоНовых + 1;

                КонецЕсли;

                СтрокаИтога.Название =
                    Строка(СтрокаСостава.Товар)
                    + " — "
                    + Строка(СтрокаСостава.Спецификация);

                СтрокаИтога.Товар =
                    СтрокаСостава.Товар;

                СтрокаИтога.Спецификация =
                    СтрокаСостава.Спецификация;

                СтрокаИтога.Материалов = 0;
                СтрокаИтога.ЦенНайдено = 0;
                СтрокаИтога.Себестоимость = 0;
                СтрокаИтога.ЦенаПродажи = 0;
                СтрокаИтога.Рентабельность = 0;
                СтрокаИтога.ЦенаПродажиБыло = 0;
                СтрокаИтога.ИзменениеЦены = 0;
                СтрокаИтога.СебестоимостьБыло = 0;
                СтрокаИтога.ИзменениеСебестоимости = 0;
                СтрокаИтога.РентабельностьБыло = 0;
                СтрокаИтога.ИзменениеРентабельности = 0;
                СтрокаИтога.Статус = "";

                СтрокиПоСпецификациям.Вставить(
                    СтрокаСостава.Спецификация,
                    СтрокаИтога);
                ВсеСтрокиРецептур.Добавить(СтрокаИтога);

                КоличествоРецептур =
                    КоличествоРецептур + 1;

                Если ПерваяСпецификация = Неопределено Тогда
                    ПерваяСпецификация =
                        СтрокаСостава.Спецификация;
                КонецЕсли;

            КонецЕсли;

            СтрокаИтога.Материалов =
                СтрокаИтога.Материалов + 1;

            Цена = НайтиПоследнююЦену(
                СтрокаСостава.Материал,
                СтрокаСостава.Характеристика,
                Цены);

            Если Цена = Неопределено Тогда
                Продолжить;
            КонецЕсли;

            Если НЕ ЭтоГривнаИлиПусто(Цена.Валюта) Тогда
                Продолжить;
            КонецЕсли;

            СтрокаИтога.ЦенНайдено =
                СтрокаИтога.ЦенНайдено + 1;

            СтрокаИтога.Себестоимость =
                СтрокаИтога.Себестоимость
                + СтрокаСостава.Количество
                * Цена.ЦенаБезНДС;

        КонецЦикла;

        // ------------------------------------------------------------------
        // УСІ РЕЦЕПТУРИ СКЛАДЕНІ НА 1000 КГ ГОТОВОЇ ПРОДУКЦІЇ.
        // У стовпці Себестоимость показуємо грн/кг, включно з переробкою.
        // У деталях матеріалів залишаються вихідні кількості на 1000 кг.
        // ------------------------------------------------------------------
        Для Каждого СтрокаИтога Из ВсеСтрокиРецептур Цикл
            // 50000 грн/т = 50 грн/кг. Додається ОДИН РАЗ на рецептуру.
            СтрокаИтога.Себестоимость = Окр(
                (СтрокаИтога.Себестоимость + 50000) / 1000, 4);
        КонецЦикла;

        // ------------------------------------------------------------------
        // СТАТУСИ КАЛЬКУЛЯЦІЇ У РЯДКАХ
        // ------------------------------------------------------------------
        Для Каждого СтрокаИтога Из ВсеСтрокиРецептур Цикл

                Если СтрокаИтога.Материалов =
                    СтрокаИтога.ЦенНайдено Тогда

                    СтрокаИтога.Статус = "OK";

                Иначе

                    СтрокаИтога.Статус =
                        "НЕМАЄ ЦІН: "
                        + Строка(
                            СтрокаИтога.Материалов
                            - СтрокаИтога.ЦенНайдено);

                КонецЕсли;

                // Продаж та рентабельність тільки для гривневих цін.
                Продажа = ЦеныПродажи.Получить(СтрокаИтога.Товар);

                Если Продажа = Неопределено Тогда

                    СтрокаИтога.Статус =
                        СтрокаИтога.Статус + "; НЕМАЄ ПРОДАЖУ";
                    Продолжить;

                КонецЕсли;

                Если Продажа.Статус <> "OK" Тогда

                    СтрокаИтога.Статус =
                        СтрокаИтога.Статус + "; " + Продажа.Статус;
                    Продолжить;

                КонецЕсли;

                // Продаж документа — грн/ящ. Зберігаємо грн/кг (нетто).
                Если Продажа.ВесЯщикаКг <= 0 Тогда
                    СтрокаИтога.Статус = СтрокаИтога.Статус
                        + "; НЕ ВИЗНАЧЕНО ВАГУ ЯЩИКА: "
                        + Продажа.ЕдиницаПродажи;
                    Продолжить;
                КонецЕсли;

                СтрокаИтога.ЦенаПродажи = Окр(
                    Продажа.ЦенаБезНДС / Продажа.ВесЯщикаКг, 4);

                Если СтрокаИтога.Материалов <> СтрокаИтога.ЦенНайдено
                    ИЛИ СтрокаИтога.Материалов = 0
                    ИЛИ СтрокаИтога.Себестоимость <= 0 Тогда

                    // Не показуємо відсоток, якщо калькуляція неповна.
                    Продолжить;

                КонецЕсли;

                СтрокаИтога.Рентабельность =
                    Окр(
                        (СтрокаИтога.ЦенаПродажи
                         - СтрокаИтога.Себестоимость)
                        / СтрокаИтога.Себестоимость * 100,
                        2);


        КонецЦикла;

        // ------------------------------------------------------------------
        // БУЛО / СТАЛО: минулі показники з минулого ЗБЕРЕЖЕНОГО перерахунку
        // ------------------------------------------------------------------
        НовыйСнимок = СоздатьПустойСнимокКалькуляций();
        КоличествоСравнений = 0;

        Для Каждого СтрокаИтога Из ВсеСтрокиРецептур Цикл

                ПолнаяСебестоимость =
                    СтрокаИтога.Материалов > 0
                    И СтрокаИтога.Материалов = СтрокаИтога.ЦенНайдено
                    И СтрокаИтога.Себестоимость > 0;

                ЕстьПродажа = СтрокаИтога.ЦенаПродажи > 0;
                ЕстьРентабельность = ПолнаяСебестоимость И ЕстьПродажа;

                СнимокСтрока = НовыйСнимок.Добавить();
                СнимокСтрока.Спецификация = СтрокаИтога.Спецификация;
                СнимокСтрока.ЦенаПродажи = СтрокаИтога.ЦенаПродажи;
                СнимокСтрока.Себестоимость = СтрокаИтога.Себестоимость;
                СнимокСтрока.Рентабельность = СтрокаИтога.Рентабельность;
                СнимокСтрока.Материалов = СтрокаИтога.Материалов;
                СнимокСтрока.ЦенНайдено = СтрокаИтога.ЦенНайдено;
                СнимокСтрока.ЕстьПродажа = ЕстьПродажа;
                СнимокСтрока.ПолнаяСебестоимость = ПолнаяСебестоимость;
                СнимокСтрока.ЕстьРентабельность = ЕстьРентабельность;

                Было = ИндексПрошлых.Получить(СтрокаИтога.Спецификация);

                // Якщо ціни не змінилися після останнього збереження,
                // показуємо попередню зміну між ДВОМА останніми знімками.
                // Тому інший бухгалтер бачить ту ж різницю, навіть якщо
                // просто натиснув "Загрузить" після першого бухгалтера.
                Если Было <> Неопределено Тогда
                    Если НЕ СнимкиОтличаются(СнимокСтрока, Было) Тогда
                        ДоЭтого = ИндексПредыдущих.Получить(
                            СтрокаИтога.Спецификация);
                        Если ДоЭтого <> Неопределено Тогда
                            Было = ДоЭтого;
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;

                Если Было = Неопределено Тогда
                    Продолжить;
                КонецЕсли;

                КоличествоСравнений = КоличествоСравнений + 1;

                Если Было.ЕстьПродажа Тогда
                    СтрокаИтога.ЦенаПродажиБыло = Было.ЦенаПродажи;
                    Если ЕстьПродажа Тогда
                        СтрокаИтога.ИзменениеЦены =
                            Окр(СтрокаИтога.ЦенаПродажи - Было.ЦенаПродажи, 2);
                    КонецЕсли;
                КонецЕсли;

                Если Было.ПолнаяСебестоимость Тогда
                    СтрокаИтога.СебестоимостьБыло = Было.Себестоимость;
                    Если ПолнаяСебестоимость Тогда
                        СтрокаИтога.ИзменениеСебестоимости =
                            Окр(СтрокаИтога.Себестоимость - Было.Себестоимость, 2);
                    КонецЕсли;
                КонецЕсли;

                Если Было.ЕстьРентабельность Тогда
                    СтрокаИтога.РентабельностьБыло = Было.Рентабельность;
                    Если ЕстьРентабельность Тогда
                        // Різниця саме у процентних пунктах.
                        СтрокаИтога.ИзменениеРентабельности =
                            Окр(СтрокаИтога.Рентабельность - Было.Рентабельность, 2);
                    КонецЕсли;
                КонецЕсли;

        КонецЦикла;

        // Збереження тільки після ПОВНОГО заповнення верхньої таблиці.
        // Зміна статусу рецептури викликає цю функцію без ЗапомнитьСнимок.
        РезультатСохранения = "";
        Если ЗапомнитьСнимок Тогда
            РезультатСохранения = СохранитьСнимокКалькуляций(
                История.Текущий, НовыйСнимок,
                Состав, Цены);
        КонецЕсли;

        // Одразу показуємо першу рецептуру в нижній таблиці.
        Если ПерваяСпецификация <> Неопределено Тогда

            РезультатКалькуляции = ЗагрузитьДеталиНаСервере(
                ПерваяСпецификация);
            Если СтрНайти(РезультатКалькуляции, "ПОМИЛКА КАЛЬКУЛЯЦІЇ") > 0 Тогда
                Сообщить(РезультатКалькуляции);
            КонецЕсли;

        КонецЕсли;

        // V4: публікуємо тільки вже розраховані дані, без нових запитів.
        Попытка
            UX40_ПостроитьВитринуНаСервере();
        Исключение
            Сообщить("UX40 ПОМИЛКА АНАЛІТИКИ: " + ОписаниеОшибки());
        КонецПопытки;

        // V4.2: знімок складових та контроль якості для нових розділів.
        // Помилка додаткової аналітики НЕ блокує основні калькуляції.
        Попытка
            UX42_ОбновитьПослеЗагрузки(Состав, Цены);
        Исключение
            Сообщить("UX42 ПОМИЛКА ДОДАТКОВОЇ АНАЛІТИКИ: " + ОписаниеОшибки());
        КонецПопытки;

        Возврат
            "ГОТОВО. Рецептур: "
            + Строка(КоличествоРецептур)
            + " | ВИКОРИСТОВУЮТЬСЯ: "
            + Строка(КоличествоНовых)
            + " | НЕ ВИКОРИСТОВУЮТЬСЯ: "
            + Строка(КоличествоСтарых)
            + " | рядків складу: "
            + Строка(Состав.Количество())
            + " | порівняно: " + Строка(КоличествоСравнений)
            + ". " + РезультатСохранения;

    Исключение

        Возврат
            "ПОМИЛКА ЗАВАНТАЖЕННЯ: "
            + ОписаниеОшибки();

    КонецПопытки;

КонецФункции




// ------------------------------------------------------------------------
// СПІЛЬНІ КАТЕГОРІЇ (для всіх бухгалтерів у тій самій базі)
// Новий реквізит довідника Спецификации: КатегорияКалькуляции, Строка(50).
// ------------------------------------------------------------------------
&НаСервере
Функция ПолучитьКатегорииСпецификаций()

    Результат = Новый Соответствие;

    Если Метаданные.Справочники.Спецификации.Реквизиты.Найти(
        "КатегорияКалькуляции") = Неопределено Тогда

        Сообщить("УВАГА: у довіднику Спецификации відсутній реквізит "
            + "КатегорияКалькуляции (тип Строка 50). "
            + "Дерево покаже рецептури в «Без категорії». "
            + "Додайте реквізит у конфігураторі та виконайте F7.");
        Возврат Результат;

    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   С.Ссылка КАК Спецификация,
        |   С.КатегорияКалькуляции КАК Категория
        |ИЗ
        |   Справочник.Спецификации КАК С
        |ГДЕ
        |   НЕ С.ПометкаУдаления";

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Результат.Вставить(Выборка.Спецификация,
                СокрЛП(Выборка.Категория));
        КонецЦикла;
    Исключение
        ВызватьИсключение "Не вдалося завантажити категорії: "
            + ОписаниеОшибки();
    КонецПопытки;

    Возврат Результат;

КонецФункции


&НаСервере
Функция НазначитьКатегориюНаСервере(Спецификация, КодКатегории)

    // Whitelist: випадкове або неправильне значення не записуємо.
    Разрешенные = Новый Соответствие;
    Разрешенные.Вставить("UA_RUD", "Україна / Рудь");
    Разрешенные.Вставить("UA_SILPO", "Україна / Сільпо");
    Разрешенные.Вставить("UA_METRO", "Україна / Метро");
    Разрешенные.Вставить("UA_FEDYK", "Україна / Привати / Федик");
    Разрешенные.Вставить("UA_OP", "Україна / Привати / ОП");
    Разрешенные.Вставить("UA_MIDAS", "Україна / Привати / Мидас");
    Разрешенные.Вставить("EX_DOVGAN", "Експорт / Довгань");
    Разрешенные.Вставить("EX_ITALY", "Експорт / Італія");
    Разрешенные.Вставить("EX_ROMANIA", "Експорт / Румунія");
    Разрешенные.Вставить("EX_GEYA", "Експорт / Гея Фуд");
    Разрешенные.Вставить("EX_CZECH", "Експорт / Чехія");
    Разрешенные.Вставить("EX_ISRAEL", "Експорт / Ізраїль");
    Разрешенные.Вставить("NONE", "Без категорії");

    ИмяКатегории = Разрешенные.Получить(КодКатегории);
    Если ИмяКатегории = Неопределено Тогда
        Возврат "ПОМИЛКА: невідома категорія " + КодКатегории;
    КонецЕсли;

    Если Метаданные.Справочники.Спецификации.Реквизиты.Найти(
        "КатегорияКалькуляции") = Неопределено Тогда
        Возврат "ПОМИЛКА: створіть реквізит КатегорияКалькуляции "
            + "у довіднику Спецификации та оновіть конфігурацію (F7).";
    КонецЕсли;

    Попытка

        ОбъектСпецификации = Спецификация.ПолучитьОбъект();

        Если КодКатегории = "NONE" Тогда
            ОбъектСпецификации.КатегорияКалькуляции = "";
        Иначе
            ОбъектСпецификации.КатегорияКалькуляции = КодКатегории;
        КонецЕсли;

        // Нова категорія означає, що рецептура використовується.
        // При переміщенні в НЕ ВИКОРИСТОВУЮТЬСЯ (старою кнопкою)
        // це значення НЕ скидається: після повернення категорія лишиться.
        ОбъектСпецификации.СтатусРецептуры = "Нова";

        ОбъектСпецификации.Записать();

        Возврат "ГОТОВО: " + Строка(Спецификация)
            + " → " + ИмяКатегории;

    Исключение
        Возврат "ПОМИЛКА ПЕРЕМІЩЕННЯ: " + ОписаниеОшибки();
    КонецПопытки;

КонецФункции

&НаСервере
Функция ИзменитьСтатусРецептурыНаСервере(
    Спецификация,
    НовыйСтатус)

    Попытка

        Если НЕ ЗначениеЗаполнено(Спецификация) Тогда
            Возврат "ПОМИЛКА: не вибрано специфікацію.";
        КонецЕсли;

        ОбъектСпецификации =
            Спецификация.ПолучитьОбъект();

        // СтатусРецептуры у вашому довіднику використовується
        // для поділу рецептур на ВИКОРИСТОВУЮТЬСЯ і НЕ ВИКОРИСТОВУЮТЬСЯ.
        ОбъектСпецификации.СтатусРецептуры =
            НовыйСтатус;

        ОбъектСпецификации.Записать();

        Возврат
            "ГОТОВО: "
            + Строка(Спецификация)
            + " -> "
            + НовыйСтатус;

    Исключение

        Возврат
            "ПОМИЛКА ЗМІНИ СТАТУСУ: "
            + ОписаниеОшибки();

    КонецПопытки;

КонецФункции

&НаСервере
Функция ПолучитьСтатусыСпецификаций()

    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Спецификация");
    Таблица.Колонки.Добавить("Статус");

    МДСпецификации = Метаданные.Справочники.Спецификации;
    ПолеСтатуса = "";

    Для Каждого МДРеквизит Из МДСпецификации.Реквизиты Цикл

        Если МДРеквизит.Имя = "СтатусРецептуры" Тогда
            ПолеСтатуса = МДРеквизит.Имя;
            Прервать;
        КонецЕсли;

    КонецЦикла;

    Если ПустаяСтрока(ПолеСтатуса) Тогда

        Сообщить(
            "У Спецификации немає реквізиту СтатусРецептуры. "
            + "Усі рецептури тимчасово підуть у ВИКОРИСТОВУЮТЬСЯ.");

        Возврат Таблица;

    КонецЕсли;

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   Спецификации.Ссылка КАК Спецификация,
    |   Спецификации." + ПолеСтатуса + " КАК Статус
    |ИЗ
    |   Справочник.Спецификации КАК Спецификации
    |ГДЕ
    |   НЕ Спецификации.ПометкаУдаления";

    Попытка

        Возврат Запрос.Выполнить().Выгрузить();

    Исключение

        Сообщить(
            "Не вдалося прочитати СтатусРецептуры: "
            + ОписаниеОшибки()
            + ". Усі рецептури підуть у ВИКОРИСТОВУЮТЬСЯ.");

        Возврат Таблица;

    КонецПопытки;

КонецФункции


&НаСервере
Функция ОпределитьВеткуСпецификации(
    Спецификация,
    ТаблицаСтатусов)

    Если ТаблицаСтатусов = Неопределено Тогда
        Возврат "НОВІ";
    КонецЕсли;

    Отбор = Новый Структура;
    Отбор.Вставить(
        "Спецификация",
        Спецификация);

    СтрокиСтатуса =
        ТаблицаСтатусов.НайтиСтроки(Отбор);

    Если СтрокиСтатуса.Количество() = 0 Тогда
        Возврат "НОВІ";
    КонецЕсли;

    ТекстСтатуса =
        НРег(
            СокрЛП(
                Строка(
                    СтрокиСтатуса[0].Статус)));

    Если СтрНайти(ТекстСтатуса, "стар") > 0 Тогда
        Возврат "СТАРІ";
    КонецЕсли;

    Возврат "НОВІ";

КонецФункции

#КонецОбласти


#Область ИсторияПерерасчетов

// СПІЛЬНА історія: РегистрСведений.ИсторияКалькуляций.
// Потребує незалежного періодичного регістру (точність "в межах секунди"):
// Вимір: Спецификация (СправочникСсылка.Спецификации)
// Ресурси: Себестоимость, ЦенаПродажи, Рентабельность,
//          Материалов, ЦенНайдено
// Реквізити: Пользователь (строка), Комментарий (строка).
// Усі записи зберігаються назавжди; незмінені знімки повторно не пишемо.
// Матеріальні ціни внизу поки використовують окремий ЛОКАЛЬНИЙ знімок.

&НаСервере
Функция СоздатьПустойСнимокКалькуляций()

    Снимок = Новый ТаблицаЗначений;
    Снимок.Колонки.Добавить("Спецификация");
    Снимок.Колонки.Добавить("ЦенаПродажи");
    Снимок.Колонки.Добавить("Себестоимость");
    Снимок.Колонки.Добавить("Рентабельность");
    Снимок.Колонки.Добавить("ЕстьПродажа");
    Снимок.Колонки.Добавить("ПолнаяСебестоимость");
    Снимок.Колонки.Добавить("ЕстьРентабельность");
    Снимок.Колонки.Добавить("Материалов");
    Снимок.Колонки.Добавить("ЦенНайдено");
    Снимок.Колонки.Добавить("Период");
    Возврат Снимок;

КонецФункции


&НаСервере
Функция ЗагрузитьИсториюКалькуляций()

    Данные = Новый Структура;
    Данные.Вставить("Текущий", СоздатьПустойСнимокКалькуляций());
    Данные.Вставить("Предыдущий", СоздатьПустойСнимокКалькуляций());
    Данные.Вставить("ТекущиеЦеныЗакупок", Новый ТаблицаЗначений);
    Данные.Вставить("ПредыдущиеЦеныЗакупок", Новый ТаблицаЗначений);

    Если Метаданные.РегистрыСведений.Найти("ИсторияКалькуляций") = Неопределено Тогда
        // Нову форму можна використовувати БЕЗ журналу: тільки перегляд.
        Возврат Данные;
    КонецЕсли;

    // Читаємо 2 останні записи КОЖНОЇ специфікації.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   История.Спецификация КАК Спецификация,
    |   История.Период КАК Период,
    |   История.ЦенаПродажи КАК ЦенаПродажи,
    |   История.Себестоимость КАК Себестоимость,
    |   История.Рентабельность КАК Рентабельность,
    |   История.Материалов КАК Материалов,
    |   История.ЦенНайдено КАК ЦенНайдено
    |ИЗ
    |   РегистрСведений.ИсторияКалькуляций КАК История
    |ГДЕ История.Комментарий = &ВерсияМетодики
    |УПОРЯДОЧИТЬ ПО
    |   Спецификация,
    |   Период УБЫВ";

    Запрос.УстановитьПараметр(
        "ВерсияМетодики", "v3.3 грн/кг; переробка 50000 грн/т");
    Выборка = Запрос.Выполнить().Выбрать();
    КоличествоПоСпецификациям = Новый Соответствие;

    Пока Выборка.Следующий() Цикл

        Количество = КоличествоПоСпецификациям.Получить(Выборка.Спецификация);
        Если Количество = Неопределено Тогда
            Количество = 0;
        КонецЕсли;

        Если Количество >= 2 Тогда
            Продолжить;
        КонецЕсли;

        Если Количество = 0 Тогда
            СтрокаСнимка = Данные.Текущий.Добавить();
        Иначе
            СтрокаСнимка = Данные.Предыдущий.Добавить();
        КонецЕсли;

        СтрокаСнимка.Спецификация = Выборка.Спецификация;
        СтрокаСнимка.ЦенаПродажи = Выборка.ЦенаПродажи;
        СтрокаСнимка.Себестоимость = Выборка.Себестоимость;
        СтрокаСнимка.Рентабельность = Выборка.Рентабельность;
        СтрокаСнимка.Материалов = Выборка.Материалов;
        СтрокаСнимка.ЦенНайдено = Выборка.ЦенНайдено;
        СтрокаСнимка.Период = Выборка.Период;
        СтрокаСнимка.ЕстьПродажа = (Выборка.ЦенаПродажи > 0);
        СтрокаСнимка.ПолнаяСебестоимость =
            Выборка.Материалов > 0
            И Выборка.Материалов = Выборка.ЦенНайдено
            И Выборка.Себестоимость > 0;
        СтрокаСнимка.ЕстьРентабельность =
            СтрокаСнимка.ЕстьПродажа
            И СтрокаСнимка.ПолнаяСебестоимость;

        КоличествоПоСпецификациям.Вставить(
            Выборка.Спецификация, Количество + 1);

    КонецЦикла;

    // Сумісність зі старою v2.7: попередні ЦІНИ МАТЕРІАЛІВ поки
    // зберігалися для окремого користувача, а не в цьому регістрі.
    Попытка
        Сохраненное = ХранилищеОбщихНастроек.Загрузить(
            "BAF_ДовідникКалькуляцій", "ІсторіяПорівняння_v27");

        Если ТипЗнч(Сохраненное) = Тип("Структура") Тогда
            Проверка = Неопределено;
            Если Сохраненное.Свойство("ТекущиеЦеныЗакупок", Проверка)
                И ТипЗнч(Проверка) = Тип("ТаблицаЗначений") Тогда
                Данные.Вставить("ТекущиеЦеныЗакупок", Проверка);
            КонецЕсли;

            Проверка = Неопределено;
            Если Сохраненное.Свойство("ПредыдущиеЦеныЗакупок", Проверка)
                И ТипЗнч(Проверка) = Тип("ТаблицаЗначений") Тогда
                Данные.Вставить("ПредыдущиеЦеныЗакупок", Проверка);
            КонецЕсли;
        КонецЕсли;
    Исключение
        // Локальна історія матеріалів необов'язкова.
    КонецПопытки;

    Возврат Данные;

КонецФункции


&НаСервере
Функция СнимкиОтличаются(НовыйСнимок, СтарыйСнимок)

    Если СтарыйСнимок = Неопределено Тогда
        Возврат Истина;
    КонецЕсли;

    Возврат
        Окр(НовыйСнимок.ЦенаПродажи, 2) <> Окр(СтарыйСнимок.ЦенаПродажи, 2)
        ИЛИ Окр(НовыйСнимок.Себестоимость, 2) <> Окр(СтарыйСнимок.Себестоимость, 2)
        ИЛИ Окр(НовыйСнимок.Рентабельность, 2) <> Окр(СтарыйСнимок.Рентабельность, 2)
        ИЛИ НовыйСнимок.ЕстьПродажа <> СтарыйСнимок.ЕстьПродажа
        ИЛИ НовыйСнимок.ПолнаяСебестоимость <> СтарыйСнимок.ПолнаяСебестоимость
        ИЛИ НовыйСнимок.ЕстьРентабельность <> СтарыйСнимок.ЕстьРентабельность
        ИЛИ НовыйСнимок.Материалов <> СтарыйСнимок.Материалов
        ИЛИ НовыйСнимок.ЦенНайдено <> СтарыйСнимок.ЦенНайдено;

КонецФункции


&НаСервере
Функция СохранитьСнимокКалькуляций(
    СтарыйТекущий, НовыйТекущий, Состав, Цены)

    // Два регістри з одним КодРасчета. Все або нічого — одна транзакція.
    // Рецептури/ціни ніколи не видаляємо та не замінюємо старі записи.
    Если Метаданные.РегистрыСведений.Найти("ИсторияКалькуляций") = Неопределено
        Или Метаданные.РегистрыСведений.Найти("ИсторияЦенМатериалов") = Неопределено Тогда
        Возврат "Журнал не збережено: для історії потрібні регістри ИсторияКалькуляций та ИсторияЦенМатериалов.";
    КонецЕсли;

    СтарыеПоСпецификации = Новый Соответствие;
    ПоследняяДата = Дата(2000, 1, 1);
    Для Каждого СтрСтарая Из СтарыйТекущий Цикл
        СтарыеПоСпецификации.Вставить(СтрСтарая.Спецификация, СтрСтарая);
        Если ЗначениеЗаполнено(СтрСтарая.Период)
            И СтрСтарая.Период > ПоследняяДата Тогда
            ПоследняяДата = СтрСтарая.Период;
        КонецЕсли;
    КонецЦикла;

    ДатаЗаписи = ТекущаяДата();
    Если ДатаЗаписи <= ПоследняяДата Тогда
        ДатаЗаписи = ПоследняяДата + 1;
    КонецЕсли;

    Автор = "Не визначено";
    Попытка
        Автор = Лев(СокрЛП(ИмяПользователя()), 100);
    Исключение
    КонецПопытки;

    НаборКалькуляций = РегистрыСведений.ИсторияКалькуляций.СоздатьНаборЗаписей();
    НаборМатериалов = РегистрыСведений.ИсторияЦенМатериалов.СоздатьНаборЗаписей();
    КодыИзмененных = Новый Соответствие;
    Добавлено = 0;

    Для Каждого СтрНовая Из НовыйТекущий Цикл
        Старая = СтарыеПоСпецификации.Получить(СтрНовая.Спецификация);
        Если НЕ СнимкиОтличаются(СтрНовая, Старая) Тогда
            Продолжить;
        КонецЕсли;

        Код = Строка(Новый УникальныйИдентификатор);
        КодыИзмененных.Вставить(СтрНовая.Спецификация, Код);
        Запись = НаборКалькуляций.Добавить();
        Запись.Период = ДатаЗаписи;
        Запись.Спецификация = СтрНовая.Спецификация;
        Запись.Себестоимость = Окр(СтрНовая.Себестоимость, 2);
        Запись.ЦенаПродажи = Окр(СтрНовая.ЦенаПродажи, 2);
        Запись.Рентабельность = Окр(СтрНовая.Рентабельность, 2);
        Запись.Материалов = СтрНовая.Материалов;
        Запись.ЦенНайдено = СтрНовая.ЦенНайдено;
        Запись.Пользователь = Автор;
        // Маркер одиниць: старі (грн/т + грн/ящ) не можна порівнювати з новими.
        Запись.Комментарий = "v3.3 грн/кг; переробка 50000 грн/т";
        Запись.КодРасчета = Код;
        Добавлено = Добавлено + 1;
    КонецЦикла;

    Если Добавлено = 0 Тогда
        Возврат "СПІЛЬНА ІСТОРІЯ: змін немає, нових записів немає.";
    КонецЕсли;

    // У регістрі одна строка на матеріал+характеристику у рецептурі.
    // Згрупуємо повторення, щоб уникнути колізії ключів регістру.
    Группированные = Новый ТаблицаЗначений;
    Группированные.Колонки.Добавить("Спецификация");
    Группированные.Колонки.Добавить("Материал");
    Группированные.Колонки.Добавить("Характеристика");
    Группированные.Колонки.Добавить("Количество");
    Группированные.Колонки.Добавить("ЦенаБезНДС");
    Группированные.Колонки.Добавить("ЦенаСПДВ");
    Группированные.Колонки.Добавить("Сумма");
    Группированные.Колонки.Добавить("ДатаЦены");
    Группированные.Колонки.Добавить("ДокументЦены");

    Для Каждого СтрСостава Из Состав Цикл
        Код = КодыИзмененных.Получить(СтрСостава.Спецификация);
        Если Код = Неопределено
            Или НЕ ЗначениеЗаполнено(СтрСостава.Материал) Тогда
            Продолжить;
        КонецЕсли;

        ХарактеристикаМат = СтрСостава.Характеристика;
        Если НЕ ЗначениеЗаполнено(ХарактеристикаМат) Тогда
            ХарактеристикаМат = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
        КонецЕсли;

        Ключ = Новый Структура;
        Ключ.Вставить("Спецификация", СтрСостава.Спецификация);
        Ключ.Вставить("Материал", СтрСостава.Материал);
        Ключ.Вставить("Характеристика", ХарактеристикаМат);
        Найденные = Группированные.НайтиСтроки(Ключ);
        Если Найденные.Количество() = 0 Тогда
            СтрИтог = Группированные.Добавить();
            СтрИтог.Спецификация = СтрСостава.Спецификация;
            СтрИтог.Материал = СтрСостава.Материал;
            СтрИтог.Характеристика = ХарактеристикаМат;
            // Колонки тимчасової ТаблицаЗначений не мають заданого типу.
            // У нового рядка їх значення = Неопределено, а не число 0.
            СтрИтог.Количество = 0;
            СтрИтог.Сумма = 0;
            СтрИтог.ЦенаБезНДС = 0;
            СтрИтог.ЦенаСПДВ = 0;
            СтрИтог.ДокументЦены = "";
        Иначе
            СтрИтог = Найденные[0];
        КонецЕсли;

        СтрИтог.Количество = СтрИтог.Количество + СтрСостава.Количество;
        Цена = НайтиПоследнююЦену(
            СтрСостава.Материал, СтрСостава.Характеристика, Цены);
        Если Цена = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если НЕ ЭтоГривнаИлиПусто(Цена.Валюта) Тогда
            Продолжить;
        КонецЕсли;

        СтрИтог.ЦенаБезНДС = Окр(Цена.ЦенаБезНДС, 2);
        СтрИтог.ЦенаСПДВ = Окр(Цена.ЦенаСПДВ, 2);
        СтрИтог.ДатаЦены = Цена.Период;
        СтрИтог.ДокументЦены = Лев(Строка(Цена.ДокументРегистрации), 255);
        СтрИтог.Сумма = СтрИтог.Сумма
            + СтрСостава.Количество * Цена.ЦенаБезНДС;
    КонецЦикла;

    Для Каждого СтрМатериал Из Группированные Цикл
        Запись = НаборМатериалов.Добавить();
        Запись.Период = ДатаЗаписи;
        Запись.КодРасчета = КодыИзмененных.Получить(СтрМатериал.Спецификация);
        Запись.Спецификация = СтрМатериал.Спецификация;
        Запись.Материал = СтрМатериал.Материал;
        Запись.Характеристика = СтрМатериал.Характеристика;
        Запись.Количество = Окр(СтрМатериал.Количество, 3);
        Запись.ЦенаБезНДС = СтрМатериал.ЦенаБезНДС;
        Запись.ЦенаСПДВ = СтрМатериал.ЦенаСПДВ;
        Запись.Сумма = Окр(СтрМатериал.Сумма, 2);
        Если ЗначениеЗаполнено(СтрМатериал.ДатаЦены) Тогда
            Запись.ДатаЦены = СтрМатериал.ДатаЦены;
        КонецЕсли;
        Запись.ДокументЦены = СтрМатериал.ДокументЦены;
        Запись.Пользователь = Автор;
    КонецЦикла;

    // Без успішного запису двох регістрів не вважаємо перерахунок збереженим.
    Попытка
        НачатьТранзакцию();
        НаборКалькуляций.Записать(Ложь);
        Если НаборМатериалов.Количество() > 0 Тогда
            НаборМатериалов.Записать(Ложь);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        Возврат "ПОМИЛКА: спільну історію НЕ записано: " + ОписаниеОшибки();
    КонецПопытки;

    Возврат "СПІЛЬНА ІСТОРІЯ: записано рецептів "
        + Строка(Добавлено) + ", рядків матеріалів "
        + Строка(Группированные.Количество()) + ".";

КонецФункции


// Для відображення колонок "Було" у нижній калькуляції.
&НаСервере
Функция ПолучитьПредыдущиеМатериалыИзРегистра(Спецификация)
    Пусто = Новый ТаблицаЗначений;
    Если Метаданные.РегистрыСведений.Найти("ИсторияЦенМатериалов") = Неопределено Тогда
        Возврат Пусто;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 2
    |   ИстКальк.КодРасчета КАК КодРасчета
    |ИЗ РегистрСведений.ИсторияКалькуляций КАК ИстКальк
    |ГДЕ ИстКальк.Спецификация = &Спецификация
    |   И ИстКальк.КодРасчета <> &ПустойКод
    |УПОРЯДОЧИТЬ ПО ИстКальк.Период УБЫВ";
    Запрос.УстановитьПараметр("Спецификация", Спецификация);
    Запрос.УстановитьПараметр("ПустойКод", "");
    Коды = Запрос.Выполнить().Выгрузить();
    Если Коды.Количество() = 0 Тогда
        Возврат Пусто;
    КонецЕсли;

    // Після перерахунку порівнюємо два останні знімки;
    // до першого нового перерахунку беремо останній доступний.
    Позиция = ?(Коды.Количество() >= 2, 1, 0);
    Запрос2 = Новый Запрос;
    Запрос2.Текст =
    "ВЫБРАТЬ
    |   М.Материал КАК Материал,
    |   М.Характеристика КАК Характеристика,
    |   М.ЦенаБезНДС КАК ЦенаБезНДС
    |ИЗ РегистрСведений.ИсторияЦенМатериалов КАК М
    |ГДЕ М.КодРасчета = &Код";
    Запрос2.УстановитьПараметр("Код", Коды[Позиция].КодРасчета);
    Возврат Запрос2.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти


#Область ДетальнаяКалькуляция

&НаСервере
Функция ЗагрузитьДеталиНаСервере(Спецификация)

    ТекущийМатериал = "";
    ВсегоМатериалов = 0;
    ОжидаетсяСтрок = 0;

    Попытка

        ЭтаФорма["ТаблицаКалькуляции"].Очистить();
        ЭтаФорма["ТекущаяСпецификация"] = Спецификация;

        ВесьСостав = ПолучитьТаблицуСоставаСпецификаций();
        // Діагностика тільки читання: скільки рядків Состав у вибраній рецептурі.
        Для Каждого ПроверочнаяСтрока Из ВесьСостав Цикл
            Если ПроверочнаяСтрока.Спецификация = Спецификация
                И ЗначениеЗаполнено(ПроверочнаяСтрока.Материал) Тогда
                ОжидаетсяСтрок = ОжидаетсяСтрок + 1;
            КонецЕсли;
        КонецЦикла;
        Сообщить("ДІАГНОСТИКА РЕЦЕПТУРИ: " + Строка(Спецификация)
            + " | рядків складу в базі: " + Строка(ОжидаетсяСтрок));
        Цены = ПолучитьПоследниеЦеныЗакупки();
        ИсторияЦен = ЗагрузитьИсториюКалькуляций();
        СтарыеЦеныМатериалов = ИсторияЦен.ПредыдущиеЦеныЗакупок;
        // В новому журналі історія матеріалів береться зі спільного регістру.
        // Для нижньої таблиці отримуємо попередній спільний знімок даної рецептури.
        Попытка
            ПредыдущиеМатериалы = ПолучитьПредыдущиеМатериалыИзРегистра(Спецификация);
        Исключение
            ПредыдущиеМатериалы = Новый ТаблицаЗначений;
        КонецПопытки;

        ОбщаяСумма = 0;
        НайденоЦен = 0;
        ВсегоМатериалов = 0;

        Для Каждого СтрокаСостава Из ВесьСостав Цикл

            Если СтрокаСостава.Спецификация <> Спецификация Тогда
                Продолжить;
            КонецЕсли;

            Если НЕ ЗначениеЗаполнено(СтрокаСостава.Материал) Тогда
                Продолжить;
            КонецЕсли;

            ВсегоМатериалов = ВсегоМатериалов + 1;
            ТекущийМатериал = Строка(СтрокаСостава.Материал);

            НоваяСтрока = ЭтаФорма["ТаблицаКалькуляции"].Добавить();

            // Назву матеріалу вже показує колонка Материал.
            // НаименованиеСтроки у формі немає, тому не звертаємось до неї.
            НоваяСтрока.Материал = СтрокаСостава.Материал;

            Если ЗначениеЗаполнено(СтрокаСостава.Характеристика) Тогда
                НоваяСтрока.Характеристика =
                    СтрокаСостава.Характеристика;
            КонецЕсли;

            НоваяСтрока.Единица =
                БезопаснаяСтрока(
                    СтрокаСостава.ЕдиницаИзмерения);

            НоваяСтрока.Количество =
                СтрокаСостава.Количество;

            Цена = НайтиПоследнююЦену(
                СтрокаСостава.Материал,
                СтрокаСостава.Характеристика,
                Цены);

            Если Цена = Неопределено Тогда

                НоваяСтрока.Статус = "НЕМАЄ ЦІНИ";
                Продолжить;

            КонецЕсли;

            НоваяСтрока.ДатаЦены = Цена.Период;
            НоваяСтрока.Документ =
                Строка(Цена.ДокументРегистрации);

            Если НЕ ЭтоГривнаИлиПусто(Цена.Валюта) Тогда

                НоваяСтрока.Статус =
                    "ІНША ВАЛЮТА: "
                    + Строка(Цена.Валюта);

                Продолжить;

            КонецЕсли;

            НоваяСтрока.ЦенаСПДВ = Цена.ЦенаСПДВ;
            НоваяСтрока.ЦенаБезНДС = Цена.ЦенаБезНДС;

            // Порівняння із попереднім СПІЛЬНИМ знімком матеріалів.
            Если ПредыдущиеМатериалы.Количество() > 0 Тогда
                ХарактеристикаМат = СтрокаСостава.Характеристика;
                Если НЕ ЗначениеЗаполнено(ХарактеристикаМат) Тогда
                    ХарактеристикаМат = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
                КонецЕсли;
                ОтборМат = Новый Структура;
                ОтборМат.Вставить("Материал", СтрокаСостава.Материал);
                ОтборМат.Вставить("Характеристика", ХарактеристикаМат);
                Ранее = ПредыдущиеМатериалы.НайтиСтроки(ОтборМат);
                Если Ранее.Количество() > 0 Тогда
                    НоваяСтрока.ЦенаБезНДСБыло = Ранее[0].ЦенаБезНДС;
                    НоваяСтрока.ИзменениеЦеныМатериала =
                        Окр(Цена.ЦенаБезНДС - Ранее[0].ЦенаБезНДС, 2);
                КонецЕсли;
            ИначеЕсли СтарыеЦеныМатериалов.Количество() > 0 Тогда
                СтараяЦена = НайтиПоследнююЦену(
                    СтрокаСостава.Материал,
                    СтрокаСостава.Характеристика,
                    СтарыеЦеныМатериалов);

                Если СтараяЦена <> Неопределено Тогда
                    Если ЭтоГривнаИлиПусто(СтараяЦена.Валюта) Тогда
                        НоваяСтрока.ЦенаБезНДСБыло = СтараяЦена.ЦенаБезНДС;
                        НоваяСтрока.ИзменениеЦеныМатериала =
                            Окр(Цена.ЦенаБезНДС - СтараяЦена.ЦенаБезНДС, 2);
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;

            НоваяСтрока.Сумма =
                НоваяСтрока.Количество
                * НоваяСтрока.ЦенаБезНДС;

            НоваяСтрока.Статус = "OK";

            ОбщаяСумма =
                ОбщаяСумма + НоваяСтрока.Сумма;

            НайденоЦен = НайденоЦен + 1;

        КонецЦикла;

        // Окремо показуємо переробку 1 тонни у нижній таблиці.
        // У ВЕРХНІЙ собівартості ці 50 000 грн ВЖЕ враховані.
        // Тому тут НЕ змінюємо ОбщаяСумма і НайденоЦен,
        // не записуємо переробку як закупівельний матеріал.
        СтрокаПереработки = ЭтаФорма["ТаблицаКалькуляции"].Добавить();
        // Материал — посилання на номенклатуру, тому не записуємо туди текст.
        // Окремий рядок переробки видно за позначкою у колонці Статус.
        СтрокаПереработки.Статус = "ПЕРЕРОБКА (на 1 000 кг)";
        СтрокаПереработки.Единица = "т";
        СтрокаПереработки.Количество = 1;
        СтрокаПереработки.ЦенаБезНДС = 50000;
        СтрокаПереработки.Сумма = 50000;

        ЭтаФорма["Итоги"] =
            "Специфікація: "
            + Строка(Спецификация)
            + " | Матеріалів: "
            + Строка(ВсегоМатериалов)
            + " | Цін знайдено: "
            + Строка(НайденоЦен)
            + " | Рядків у таблиці: "
            + Строка(ЭтаФорма["ТаблицаКалькуляции"].Количество())
            + " | Матеріали на 1000 кг: "
            + Формат(ОбщаяСумма, "ЧДЦ=2")
            + " грн | Переробка: 50 000 грн/т"
            + " | Разом на 1000 кг: "
            + Формат(ОбщаяСумма + 50000, "ЧДЦ=2")
            + " грн | На 1 кг: "
            + Формат((ОбщаяСумма + 50000) / 1000, "ЧДЦ=2")
            + " грн/кг без ПДВ";

        Возврат ЭтаФорма["Итоги"];

    Исключение

        ТекстОшибки = "ПОМИЛКА КАЛЬКУЛЯЦІЇ: " + ОписаниеОшибки()
            + " | Специфікація: " + Строка(Спецификация)
            + " | Очікується рядків: " + Строка(ОжидаетсяСтрок)
            + " | Опрацьовано: " + Строка(ВсегоМатериалов)
            + " | Поточний матеріал: " + ТекущийМатериал;
        // Вивести помилку також при автоматичному виборі рядка,
        // а не залишати мовчки один неповний матеріал.
        ЭтаФорма["Итоги"] = ТекстОшибки;
        Возврат ТекстОшибки;

    КонецПопытки;

КонецФункции

#КонецОбласти


#Область СпецификацииДинамически

&НаСервере
Функция ПолучитьТаблицуСоставаСпецификаций()

    МДСпецификации = Неопределено;

    Для Каждого МДСправочник Из Метаданные.Справочники Цикл

        Если МДСправочник.Имя = "Спецификации" Тогда

            МДСпецификации = МДСправочник;
            Прервать;

        КонецЕсли;

    КонецЦикла;

    Если МДСпецификации = Неопределено Тогда

        ВызватьИсключение
            "У конфігурації не знайдено Справочник.Спецификации.";

    КонецЕсли;

    Диагностика = "";

    Для НомерПрохода = 1 По 2 Цикл

        Для Каждого МДТЧ Из МДСпецификации.ТабличныеЧасти Цикл

            ИмяТЧНиж = НРег(МДТЧ.Имя);

            Если СтрНайти(ИмяТЧНиж, "продукц") > 0
                ИЛИ СтрНайти(ИмяТЧНиж, "выход") > 0
                ИЛИ СтрНайти(ИмяТЧНиж, "випуск") > 0
                ИЛИ СтрНайти(ИмяТЧНиж, "отход") > 0
                ИЛИ СтрНайти(ИмяТЧНиж, "відход") > 0 Тогда

                Продолжить;

            КонецЕсли;

            Предпочтительная =
                СтрНайти(ИмяТЧНиж, "состав") > 0
                ИЛИ СтрНайти(ИмяТЧНиж, "материал") > 0
                ИЛИ СтрНайти(ИмяТЧНиж, "комплект") > 0
                ИЛИ СтрНайти(ИмяТЧНиж, "запас") > 0
                ИЛИ СтрНайти(ИмяТЧНиж, "сыр") > 0
                ИЛИ СтрНайти(ИмяТЧНиж, "сиров") > 0;

            Если НомерПрохода = 1
                И НЕ Предпочтительная Тогда

                Продолжить;

            КонецЕсли;

            Если НомерПрохода = 2
                И Предпочтительная Тогда

                Продолжить;

            КонецЕсли;

            ИмяМатериала =
                НайтиПолеТЧ(
                    МДТЧ,
                    "Номенклатура,Материал,Комплектующая,Запас,Компонент,Сырье,Сировина");

            ИмяКоличества =
                НайтиПолеТЧ(
                    МДТЧ,
                    "Количество,КоличествоМатериала,КоличествоКомплектующей,КоличествоНоменклатуры,КоличествоКомпонента");

            Если ПустаяСтрока(ИмяМатериала)
                ИЛИ ПустаяСтрока(ИмяКоличества) Тогда

                Продолжить;

            КонецЕсли;

            Таблица =
                ПрочитатьТабличнуюЧастьСпецификаций(
                    МДТЧ,
                    ИмяМатериала,
                    ИмяКоличества);

            Если НЕ ПустаяСтрока(Диагностика) Тогда
                Диагностика = Диагностика + "; ";
            КонецЕсли;

            Диагностика =
                Диагностика
                + МДТЧ.Имя
                + "[мат="
                + ИмяМатериала
                + ", к-сть="
                + ИмяКоличества
                + "]="
                + Строка(Таблица.Количество());

            Если Таблица.Количество() > 0 Тогда

                Сообщить(
                    "РЕЦЕПТУРИ: таблична частина = "
                    + МДТЧ.Имя
                    + "; матеріал = "
                    + ИмяМатериала
                    + "; кількість = "
                    + ИмяКоличества
                    + "; рядків = "
                    + Строка(Таблица.Количество()));

                Возврат Таблица;

            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    ВызватьИсключение
        "Не знайдено табличної частини рецептури з полями матеріалу та кількості. Перевірено: "
        + Диагностика;

КонецФункции


&НаСервере
Функция ПрочитатьТабличнуюЧастьСпецификаций(
    МДТЧ,
    ИмяМатериала,
    ИмяКоличества)

    ИмяХарактеристики =
        НайтиПолеТЧ(
            МДТЧ,
            "Характеристика,ХарактеристикаНоменклатуры");

    ИмяЕдиницы =
        НайтиПолеТЧ(
            МДТЧ,
            "ЕдиницаИзмерения,Единица,ЕдиницаХранения");

    Если ПустаяСтрока(ИмяХарактеристики) Тогда
        ВыражениеХарактеристики = "NULL";
    Иначе
        ВыражениеХарактеристики =
            "ТЧ." + ИмяХарактеристики;
    КонецЕсли;

    Если ПустаяСтрока(ИмяЕдиницы) Тогда
        ВыражениеЕдиницы = "NULL";
    Иначе
        ВыражениеЕдиницы =
            "ТЧ." + ИмяЕдиницы;
    КонецЕсли;

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   ТЧ.Ссылка КАК Спецификация,
    |   ТЧ.Ссылка.Владелец КАК Товар,
    |   ТЧ." + ИмяМатериала + " КАК Материал,
    |   " + ВыражениеХарактеристики + " КАК Характеристика,
    |   " + ВыражениеЕдиницы + " КАК ЕдиницаИзмерения,
    |   ТЧ." + ИмяКоличества + " КАК Количество
    |ИЗ
    |   Справочник.Спецификации." + МДТЧ.Имя + " КАК ТЧ
    |ГДЕ
    |   НЕ ТЧ.Ссылка.ПометкаУдаления
    |   И ТЧ." + ИмяКоличества + " <> 0
    |
    |УПОРЯДОЧИТЬ ПО
    |   Товар,
    |   Спецификация,
    |   ТЧ.НомерСтроки";

    Попытка

        Возврат Запрос.Выполнить().Выгрузить();

    Исключение

        ПустаяТаблица = Новый ТаблицаЗначений;
        ПустаяТаблица.Колонки.Добавить("Спецификация");
        ПустаяТаблица.Колонки.Добавить("Товар");
        ПустаяТаблица.Колонки.Добавить("Материал");
        ПустаяТаблица.Колонки.Добавить("Характеристика");
        ПустаяТаблица.Колонки.Добавить("ЕдиницаИзмерения");
        ПустаяТаблица.Колонки.Добавить("Количество");

        Возврат ПустаяТаблица;

    КонецПопытки;

КонецФункции


&НаСервере
Функция НайтиПолеТЧ(МДТЧ, СписокИмен)

    Имена = СтрРазделить(СписокИмен, ",");

    Для Каждого ИмяИскомое Из Имена Цикл

        Для Каждого МДРеквизит Из МДТЧ.Реквизиты Цикл

            Если МДРеквизит.Имя = ИмяИскомое Тогда
                Возврат МДРеквизит.Имя;
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    Возврат "";

КонецФункции


&НаСервере
Функция БезопаснаяСтрока(Значение)

    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Если ТипЗнч(Значение) = Тип("Null") Тогда
        Возврат "";
    КонецЕсли;

    Возврат Строка(Значение);

КонецФункции

#КонецОбласти


#Область ЦеныПродажи

// Шукаємо найновішу ПРОВЕДЕНУ розхідну накладну.
// Підтримуємо типові назви документів/табличних частин у BAS/1C.
// Витягаємо останню дату по кожній номенклатурі на сервері запитом,
// щоб не завантажувати в оперативну пам'ять усі старі накладні.
&НаСервере
Функция ПолучитьПоследниеЦеныПродаж()

    Результат = Новый Соответствие;
    СписокДокументов =
        СтрРазделить(
            "РасходнаяНакладная,РеализацияТоваровУслуг,РеализацияТоваров,Реализация",
            ",");

    Для Каждого ИмяДокумента Из СписокДокументов Цикл

        Для Каждого МДДокумент Из Метаданные.Документы Цикл

            Если МДДокумент.Имя <> ИмяДокумента Тогда
                Продолжить;
            КонецЕсли;

            Для Каждого МДТЧ Из МДДокумент.ТабличныеЧасти Цикл

                Если МДТЧ.Имя <> "Запасы"
                    И МДТЧ.Имя <> "Товары"
                    И МДТЧ.Имя <> "Номенклатура" Тогда
                    Продолжить;
                КонецЕсли;

                ИмяТовара =
                    НайтиПолеТЧ(МДТЧ, "Номенклатура,Товар,Запас");
                ИмяКоличества =
                    НайтиПолеТЧ(МДТЧ, "Количество,КоличествоТовара");
                ИмяЦены =
                    НайтиПолеТЧ(МДТЧ, "Цена,ЦенаПродажи");
                ИмяЕдиницы = НайтиПолеТЧ(МДТЧ,
                    "ЕдиницаИзмерения,Единица,Упаковка,ЕдИзм,ЕдиницаПродажи,УпаковкаНоменклатуры");

                Если ПустаяСтрока(ИмяТовара)
                    ИЛИ ПустаяСтрока(ИмяКоличества)
                    ИЛИ ПустаяСтрока(ИмяЦены) Тогда
                    Продолжить;
                КонецЕсли;

                Попытка

                    Результат =
                        ПрочитатьПоследниеПродажиТЧ(
                            МДДокумент,
                            МДТЧ,
                            ИмяТовара,
                            ИмяКоличества,
                            ИмяЦены,
                            ИмяЕдиницы);

                    Сообщить(
                        "ПРОДАЖІ: " + ИмяДокумента + "."
                        + МДТЧ.Имя
                        + "; товарів із ціною: "
                        + Строка(Результат.Количество())
                        + "; поле од.продажу: "
                        + ?(ПустаяСтрока(ИмяЕдиницы),
                            "НЕ ЗНАЙДЕНО", ИмяЕдиницы));

                    Возврат Результат;

                Исключение

                    Сообщить(
                        "ПОМИЛКА ПОШУКУ ЦІНИ ПРОДАЖУ в "
                        + ИмяДокумента + "." + МДТЧ.Имя
                        + ": " + ОписаниеОшибки());

                КонецПопытки;

            КонецЦикла;

        КонецЦикла;

    КонецЦикла;

    Сообщить(
        "ЦІНИ ПРОДАЖУ: не знайдено підходящої табличної частини "
        + "або не вдалося виконати запит. Рентабельність залишено порожньою.");

    Возврат Результат;

КонецФункции


&НаСервере
Функция ПрочитатьПоследниеПродажиТЧ(
    МДДокумент,
    МДТЧ,
    ИмяТовара,
    ИмяКоличества,
    ИмяЦены,
    ИмяЕдиницы)

    // Структура й розрахунок ПДВ аналогічні робочому запиту закупівель.
    // Якщо немає явної ознаки «сума включає ПДВ», ставимо позначку
    // і не обчислюємо рентабельність, щоб не показувати хибний відсоток.
    ИмяПризнакаНДС =
        НайтиПолеТЧ(
            МДДокумент,
            "СуммаВключаетНДС");
    ИмяСтавкиНДС =
        НайтиПолеТЧ(
            МДТЧ,
            "СтавкаНДС");
    ИмяВалюты =
        НайтиПолеТЧ(
            МДДокумент,
            "ВалютаДокумента,Валюта");

    Если ПустаяСтрока(ИмяПризнакаНДС) Тогда
        ВыражениеПризнакаНДС = "ЛОЖЬ";
    Иначе
        ВыражениеПризнакаНДС =
            "ТЧ.Ссылка." + ИмяПризнакаНДС;
    КонецЕсли;

    Если ПустаяСтрока(ИмяСтавкиНДС) Тогда
        ВыражениеСтавкиНДС = "0";
    Иначе
        ВыражениеСтавкиНДС =
            "ТЧ." + ИмяСтавкиНДС + ".Ставка";
    КонецЕсли;

    Если ПустаяСтрока(ИмяВалюты) Тогда
        ВыражениеВалюты = "NULL";
    Иначе
        ВыражениеВалюты =
            "ТЧ.Ссылка." + ИмяВалюты;
    КонецЕсли;

    Если ПустаяСтрока(ИмяЕдиницы) Тогда
        ВыражениеЕдиницы = "NULL";
    Иначе
        ВыражениеЕдиницы = "ТЧ." + ИмяЕдиницы;
    КонецЕсли;

    Источник =
        "Документ." + МДДокумент.Имя + "." + МДТЧ.Имя;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   МАКСИМУМ(ТЧ.Ссылка.Дата) КАК Дата,
    |   ТЧ." + ИмяТовара + " КАК Товар
    |ПОМЕСТИТЬ ПоследниеПродажи
    |ИЗ
    |   " + Источник + " КАК ТЧ
    |ГДЕ
    |   ТЧ.Ссылка.Проведен
    |   И НЕ ТЧ.Ссылка.ПометкаУдаления
    |   И ТЧ." + ИмяКоличества + " > 0
    |   И ТЧ." + ИмяЦены + " > 0
    |СГРУППИРОВАТЬ ПО
    |   ТЧ." + ИмяТовара + "
    |ИНДЕКСИРОВАТЬ ПО
    |   Товар,
    |   Дата
    |;
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   ТЧ." + ИмяТовара + " КАК Товар,
    |   ТЧ.Ссылка.Дата КАК Дата,
    |   ТЧ.Ссылка КАК Документ,
    |   ТЧ.НомерСтроки КАК НомерСтроки,
    |   ТЧ." + ИмяЦены + " КАК Цена,
    |   " + ВыражениеЕдиницы + " КАК ЕдиницаПродажи,
    |   " + ВыражениеПризнакаНДС + " КАК СуммаВключаетНДС,
    |   " + ВыражениеСтавкиНДС + " КАК СтавкаНДС,
    |   " + ВыражениеВалюты + " КАК Валюта
    |ИЗ
    |   ПоследниеПродажи КАК ПоследниеПродажи
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ
    |           " + Источник + " КАК ТЧ
    |       ПО ПоследниеПродажи.Товар = ТЧ." + ИмяТовара + "
    |           И ПоследниеПродажи.Дата = ТЧ.Ссылка.Дата
    |ГДЕ
    |   ТЧ.Ссылка.Проведен
    |   И НЕ ТЧ.Ссылка.ПометкаУдаления
    |   И ТЧ." + ИмяКоличества + " > 0
    |   И ТЧ." + ИмяЦены + " > 0
    |УПОРЯДОЧИТЬ ПО
    |   Товар,
    |   Дата УБЫВ,
    |   Документ УБЫВ,
    |   НомерСтроки УБЫВ";

    Таблица = Запрос.Выполнить().Выгрузить();
    Результат = Новый Соответствие;

    Для Каждого СтрокаПродажи Из Таблица Цикл

        // Від кількох документів із однаковою датою беремо
        // перший рядок після сортування за посиланням і номером.
        Если Результат.Получить(СтрокаПродажи.Товар) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Продажа = Новый Структура;
        Продажа.Вставить("ЦенаБезНДС", 0);
        Продажа.Вставить("ЦенаСПДВ", 0);
        Продажа.Вставить("ЕдиницаПродажи",
            БезопаснаяСтрока(СтрокаПродажи.ЕдиницаПродажи));
        Продажа.Вставить("ВесЯщикаКг",
            ИзвлечьВесЯщикаКг(СтрокаПродажи.ЕдиницаПродажи));
        Продажа.Вставить("Дата", СтрокаПродажи.Дата);
        Продажа.Вставить("Документ", СтрокаПродажи.Документ);
        Продажа.Вставить("Статус", "OK");

        Если НЕ ЭтоГривнаИлиПусто(СтрокаПродажи.Валюта) Тогда

            Продажа.Статус =
                "ЦІНА В ІНШІЙ ВАЛЮТІ: "
                + БезопаснаяСтрока(СтрокаПродажи.Валюта);

        ИначеЕсли ПустаяСтрока(ИмяПризнакаНДС)
            ИЛИ ПустаяСтрока(ИмяСтавкиНДС) Тогда

            Продажа.Статус = "ПЕРЕВІР ПДВ У РОЗХІДНІЙ";

        Иначе

            Цена = СтрокаПродажи.Цена;
            Ставка = СтрокаПродажи.СтавкаНДС;

            Если Ставка = Неопределено
                ИЛИ ТипЗнч(Ставка) = Тип("Null") Тогда

                Продажа.Статус = "НЕ ЗНАЙДЕНО СТАВКУ ПДВ";

            Иначе

                Множитель = 1 + Ставка / 100;

                Если Множитель <= 0 Тогда

                    Продажа.Статус = "НЕВІРНА СТАВКА ПДВ";

                ИначеЕсли СтрокаПродажи.СуммаВключаетНДС Тогда

                    Продажа.ЦенаБезНДС = Окр(Цена / Множитель, 4);
                    Продажа.ЦенаСПДВ = Цена;

                Иначе

                    Продажа.ЦенаБезНДС = Цена;
                    Продажа.ЦенаСПДВ = Окр(Цена * Множитель, 4);

                КонецЕсли;

            КонецЕсли;

        КонецЕсли;

        Результат.Вставить(СтрокаПродажи.Товар, Продажа);

    КонецЦикла;

    Возврат Результат;

КонецФункции


// Консервативна перевірка маси нетто, яку бухгалтер бачить в Од.:
// "ящ (2,34 кг)" -> 2.34; "ящ (1,89 кг)" -> 1.89.
// Якщо немає точної ваги у найменуванні одиниці, повертаємо 0:
// не підставляємо вигадану масу і не рахуємо фальшиву рентабельність.
&НаСервере
Функция ИзвлечьВесЯщикаКг(ЕдиницаПродажи)
    Текст = НРег(СокрЛП(БезопаснаяСтрока(ЕдиницаПродажи)));
    Если ПустаяСтрока(Текст) Тогда
        Возврат 0;
    КонецЕсли;

    Если Текст = "кг" Или Текст = "кілограм" Тогда
        Возврат 1;
    КонецЕсли;

    ПозицияКг = СтрНайти(Текст, "кг");
    Если ПозицияКг = 0 Тогда
        Возврат 0;
    КонецЕсли;

    ПозицияСкобки = 0;
    Для Индекс = 1 По ПозицияКг - 1 Цикл
        Если Сред(Текст, Индекс, 1) = "(" Тогда
            ПозицияСкобки = Индекс;
        КонецЕсли;
    КонецЦикла;

    Если ПозицияСкобки > 0 Тогда
        ТекстЧисла = Сред(Текст,
            ПозицияСкобки + 1, ПозицияКг - ПозицияСкобки - 1);
    Иначе
        // Дозволяємо запис "2,34 кг" без дужок.
        ТекстЧисла = Лев(Текст, ПозицияКг - 1);
    КонецЕсли;

    ТекстЧисла = СтрЗаменить(СокрЛП(ТекстЧисла), " ", "");
    ТекстЧисла = СтрЗаменить(ТекстЧисла, ".", ",");
    Если ПустаяСтрока(ТекстЧисла) Тогда
        Возврат 0;
    КонецЕсли;

    // Відхиляємо невідомі формати (шт, ящ без кг, нерозпізнані символи).
    КоличествоЗапятых = 0;
    Для Индекс = 1 По СтрДлина(ТекстЧисла) Цикл
        Символ = Сред(ТекстЧисла, Индекс, 1);
        Если Символ = "," Тогда
            КоличествоЗапятых = КоличествоЗапятых + 1;
            Если КоличествоЗапятых > 1 Тогда
                Возврат 0;
            КонецЕсли;
        ИначеЕсли СтрНайти("0123456789", Символ) = 0 Тогда
            Возврат 0;
        КонецЕсли;
    КонецЦикла;

    Попытка
        ВесКг = Число(ТекстЧисла);
        Если ВесКг > 0 И ВесКг <= 1000 Тогда
            Возврат ВесКг;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат 0;
КонецФункции

#КонецОбласти


#Область ЦеныЗакупки

&НаСервере
Функция ПолучитьПоследниеЦеныЗакупки()

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   МАКСИМУМ(Запасы.Ссылка.Дата) КАК Период,
    |   Запасы.Номенклатура КАК Номенклатура,
    |   Запасы.Характеристика КАК Характеристика
    |ПОМЕСТИТЬ ПоследниеДаты
    |ИЗ
    |   Документ.ПриходнаяНакладная.Запасы КАК Запасы
    |ГДЕ
    |   Запасы.Ссылка.Проведен
    |   И НЕ Запасы.Ссылка.ПометкаУдаления
    |
    |СГРУППИРОВАТЬ ПО
    |   Запасы.Номенклатура,
    |   Запасы.Характеристика
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   Номенклатура,
    |   Характеристика,
    |   Период
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   Запасы.Ссылка КАК ДокументРегистрации,
    |   Запасы.Ссылка.Дата КАК Период,
    |   Запасы.Номенклатура КАК Номенклатура,
    |   Запасы.Характеристика КАК Характеристика,
    |
    |   МАКСИМУМ(
    |       ВЫБОР
    |           КОГДА Запасы.Ссылка.СуммаВключаетНДС
    |               ТОГДА Запасы.Цена
    |           ИНАЧЕ
    |               ВЫРАЗИТЬ(
    |                   Запасы.Цена
    |                   * (1 + Запасы.СтавкаНДС.Ставка / 100)
    |                   КАК ЧИСЛО(15, 4))
    |       КОНЕЦ
    |   ) КАК ЦенаСПДВ,
    |
    |   МАКСИМУМ(
    |       ВЫБОР
    |           КОГДА Запасы.Ссылка.СуммаВключаетНДС
    |               ТОГДА
    |                   ВЫРАЗИТЬ(
    |                       Запасы.Цена
    |                       / (1 + Запасы.СтавкаНДС.Ставка / 100)
    |                       КАК ЧИСЛО(15, 4))
    |           ИНАЧЕ Запасы.Цена
    |       КОНЕЦ
    |   ) КАК ЦенаБезНДС,
    |
    |   Запасы.Ссылка.ВалютаДокумента КАК Валюта
    |
    |ИЗ
    |   ПоследниеДаты КАК ПоследниеДаты
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ
    |           Документ.ПриходнаяНакладная.Запасы КАК Запасы
    |       ПО
    |           ПоследниеДаты.Период = Запасы.Ссылка.Дата
    |           И ПоследниеДаты.Номенклатура = Запасы.Номенклатура
    |           И ПоследниеДаты.Характеристика = Запасы.Характеристика
    |
    |ГДЕ
    |   Запасы.Ссылка.Проведен
    |   И НЕ Запасы.Ссылка.ПометкаУдаления
    |
    |СГРУППИРОВАТЬ ПО
    |   Запасы.Ссылка,
    |   Запасы.Ссылка.Дата,
    |   Запасы.Номенклатура,
    |   Запасы.Характеристика,
    |   Запасы.Ссылка.ВалютаДокумента";

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции


&НаСервере
Функция НайтиПоследнююЦену(
    Номенклатура,
    Характеристика,
    ТаблицаЦен)

    Отбор = Новый Структура;
    Отбор.Вставить("Номенклатура", Номенклатура);

    Строки = ТаблицаЦен.НайтиСтроки(Отбор);

    Если Строки.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если ЗначениеЗаполнено(Характеристика) Тогда

        Лучшая = Неопределено;

        Для Каждого СтрокаЦены Из Строки Цикл

            Если СтрокаЦены.Характеристика = Характеристика Тогда

                Если Лучшая = Неопределено
                    ИЛИ СтрокаЦены.Период > Лучшая.Период Тогда

                    Лучшая = СтрокаЦены;

                КонецЕсли;

            КонецЕсли;

        КонецЦикла;

        Если Лучшая <> Неопределено Тогда
            Возврат Лучшая;
        КонецЕсли;

    КонецЕсли;

    Для Каждого СтрокаЦены Из Строки Цикл

        Если НЕ ЗначениеЗаполнено(
            СтрокаЦены.Характеристика) Тогда

            Возврат СтрокаЦены;

        КонецЕсли;

    КонецЦикла;

    Лучшая = Строки[0];

    Для Каждого СтрокаЦены Из Строки Цикл

        Если СтрокаЦены.Период > Лучшая.Период Тогда
            Лучшая = СтрокаЦены;
        КонецЕсли;

    КонецЦикла;

    Возврат Лучшая;

КонецФункции


&НаСервере
Функция ЭтоГривнаИлиПусто(Валюта)

    Текст = НРег(СокрЛП(Строка(Валюта)));

    Если ПустаяСтрока(Текст) Тогда
        Возврат Истина;
    КонецЕсли;

    Возврат
        СтрНайти(Текст, "uah") > 0
        ИЛИ СтрНайти(Текст, "грн") > 0
        ИЛИ СтрНайти(Текст, "грив") > 0;

КонецФункции

